def row_name(op):
    return op.replace("/{lib}", "")


def label(row):
    m = re.fullmatch(r"(.+)/(\d+)(K?B)", row)
    if m:
        return f"{NAMES[m.group(1)]}, {m.group(2)} {m.group(3)}"
    return NAMES[row]


def bin_of(value, edges):
    return next((i for i, edge in enumerate(edges) if value <= edge), len(edges))


def host_arch(host):
    arch = host["cpu"]["arch"]
    return {"arm64": "aarch64", "amd64": "x86_64", "armv7l": "armv7", "armv8l": "armv7"}.get(arch, arch)


def host_os(host):
    return "macos" if host["os"].startswith("macOS") else "linux"


def load_verified(path=VERIFIED):
    """The table of verified code, refusing an entry that names nothing."""
    with open(path, "rb") as f:
        entries = tomllib.load(f).get("verified", [])
    rows = [row_name(op) for op in OPERATIONS]
    required = {"library", "operations", "proof", "link"}
    optional = {"arch", "cpu", "os"}
    for i, e in enumerate(entries, 1):
        where = f"{os.path.relpath(path, ROOT)}: entry {i}"
        if set(e) - required - optional:
            fail(f"{where}: unknown keys {', '.join(sorted(set(e) - required - optional))}")
        if required - set(e):
            fail(f"{where}: missing {', '.join(sorted(required - set(e)))}")
        if e["library"] not in COLUMNS:
            fail(f"{where}: unknown library {e['library']}")
        if e.get("arch", "x86_64") not in CPU_FEATURES:
            fail(f"{where}: unknown arch {e['arch']}")
        if "cpu" in e and "arch" not in e:
            fail(f"{where}: CPU features need an arch")
        for feature in e.get("cpu", []):
            if feature.removeprefix("!") not in CPU_FEATURES[e["arch"]]:
                fail(f"{where}: unknown {e['arch']} CPU feature {feature}")
        if e.get("os", "linux") not in ("linux", "macos"):
            fail(f"{where}: unknown os {e['os']}")
        for pattern in e["operations"]:
            if not fnmatch.filter(rows, pattern):
                fail(f"{where}: {pattern} names no operation")
        if not e["link"].startswith("https://"):
            fail(f"{where}: the link is not https")
    return entries


def proof_for(verified, library, row, host, any_os=False):
    """The entry that verifies a library's code for an operation on a host,
    or with `any_os`, on the same CPU under any OS."""
    cpuid = host.get("rind_cpu", {}).get("cpuid", {})
    for e in verified:
        if e["library"] != library or e.get("arch", host_arch(host)) != host_arch(host):
            continue
        if not any_os and e.get("os", host_os(host)) != host_os(host):
            continue
        if not all(cpuid.get(f.removeprefix("!")) == (0 if f.startswith("!") else 1) for f in e.get("cpu", [])):
            continue
        if any(fnmatch.fnmatchcase(row, p) for p in e["operations"]):
            return e
    return None


def shown_names(hosts):
    """Every measured host. Maintainer machines stay in COLLECT_HOSTS order so
    the published report does not move; every other name keeps the order of
    `hosts`. COLLECT_HOSTS does not drop a host."""
    known = [name for name in COLLECT_HOSTS if name in hosts]
    return known + [name for name in hosts if name not in COLLECT_HOSTS]


def host_note(name, host):
    """Prose for a host section: the result's own note, or the collect list's
    for a machine measured before notes were stored in the JSON."""
    return host.get("note") or COLLECT_HOSTS.get(name, {}).get("note")


class BadHostFile(Exception):
    """A file in a host directory that is not readable as a host result."""


def read_host(path, name):
    """One host result. `name` is its file stem and has to be a host name,
    and so does a `host` field that names something else. A file that is not
    JSON, or not an object, raises `BadHostFile`, so a caller can skip it."""
    check_host_name(name)
    try:
        with open(path) as f:
            data = json.load(f)
    except (OSError, ValueError) as e:
        raise BadHostFile(f"{os.path.basename(path)}: not readable as JSON ({e})") from e
    if not isinstance(data, dict):
        raise BadHostFile(f"{os.path.basename(path)}: not a host result")
    if "host" in data and data["host"] != name:
        check_host_name(data["host"])
    return data


def load_hosts(directory):
    """Every host result in `directory`, keyed by file name. `tiers.json` is
    the nightly CPU tiers, not a host. Every other file name has to pass
    `check_host_name`, and so does a `host` field that names something else.
    A file that is not a readable host result is named on stderr and skipped,
    so one bad file does not hide the others."""
    found = {}
    for path in glob.glob(os.path.join(directory, "*.json")):
        name = os.path.splitext(os.path.basename(path))[0]
        if name == "tiers":
            continue
        try:
            found[name] = read_host(path, name)
        except BadHostFile as e:
            print(f"bench-report: {e}, skipped", file=sys.stderr)
    # Glob order is not stable. Collect machines stay in COLLECT_HOSTS order
    # and every other file follows by name.
    names = [name for name in COLLECT_HOSTS if name in found]
    names += sorted(name for name in found if name not in COLLECT_HOSTS)
    return {name: found[name] for name in names}


def unmeasured(host):
    """Why `host` has no times to report, or "" when it has them."""
    if host.get("status") != "ok":
        return f"not measured, {host.get('status', 'unmeasured')}: {host.get('reason', '')}"
    for path in REQUIRED_HOST_FIELDS:
        value = host
        for key in path.split("."):
            value = value.get(key) if isinstance(value, dict) else None
        if path == "cpu.logical_cpus":
            ok = type(value) is int and value > 0
        else:
            ok = isinstance(value, str) and value != ""
        if path == "started" and ok:
            try:
                datetime.datetime.fromisoformat(value)
            except ValueError:
                ok = False
        if not ok:
            return f"no well-formed {path}"
    for key in OPTIONAL_HOST_OBJECTS:
        if key in host and not isinstance(host[key], dict):
            return f"no well-formed {key}"
    if "refused" in host and not well_formed_refused(host["refused"]):
        return "no well-formed refused"
    if "build_cost" in host and not well_formed_build_cost(host["build_cost"]):
        return "no well-formed build_cost"
    results = host.get("results")
    if not isinstance(results, list) or not all(
        isinstance(r, dict)
        and isinstance(r.get("operation"), str)
        and isinstance(r.get("library"), str)
        and positive_time(r.get("ns"))
        for r in results
    ):
        return "no well-formed results list"
    return ""


# Every field of a measured host that the report and `summary` read
# unguarded. `cpu.logical_cpus` is a count; the rest are nonempty strings.
REQUIRED_HOST_FIELDS = ("commit", "started", "os", "cpu.model", "cpu.arch", "cpu.logical_cpus", "toolchain.rustc")
# Optional fields the report reads as objects when a host has them.
OPTIONAL_HOST_OBJECTS = ("load", "refused", "build_cost", "rind_cpu")


def _strings(value):
    return isinstance(value, list) and all(isinstance(v, str) for v in value)


def _seconds(value):
    return isinstance(value, (int, float)) and not isinstance(value, bool) and 0 <= value <= sys.float_info.max


def well_formed_refused(refused):
    """Whether `refused` maps known libraries to the CPU features each lacks, as the report reads it."""
    return all(lib in COLUMNS and _strings(missing) for lib, missing in refused.items())


def well_formed_build_cost(cost):
    """Whether `cost` has every field `build_table` and the build-cost section read."""
    if cost.get("status") != "ok":
        return isinstance(cost.get("status"), str) and isinstance(cost.get("reason"), str)
    host = cost.get("host")
    builds = cost.get("builds")
    return (
        isinstance(cost.get("started"), str)
        and isinstance(host, dict)
        and all(isinstance(host.get(k), (str, int)) and not isinstance(host.get(k), bool) for k in ("rustc", "cc", "jobs"))
        and isinstance(builds, list)
        and all(
            isinstance(b, dict)
            and isinstance(b.get("name"), str)
            and isinstance(b.get("seconds"), list)
            and b["seconds"]
            and all(_seconds(x) for x in b["seconds"])
            and all(_seconds(b.get(k)) for k in ("median_seconds", "median_cpu_seconds", "stripped_bytes"))
            and _strings(b.get("tools"))
            and isinstance(b.get("packages"), list)
            for b in builds
        )
    )


def positive_time(ns):
    """True for a finite time above zero. A bool is an int in Python, so it is refused by name. NaN
    fails both comparisons, and an int too large for a float compares without being converted."""
    return isinstance(ns, (int, float)) and not isinstance(ns, bool) and 0 < ns <= sys.float_info.max


def load_measured(directory):
    """`load_hosts`, minus every result without times, each named on stderr."""
    found = {}
    for name, host in load_hosts(directory).items():
        why = unmeasured(host)
        if why:
            print(f"bench-report: {name}: {why}, skipped", file=sys.stderr)
        else:
            found[name] = host
    return found


def times(host):
    """Each operation's time by library on a host, by row name."""
    out = {}
    for r in host["results"]:
        out.setdefault(row_name(r["operation"]), {})[r["library"]] = r["ns"]
    return out


def tier_rows(tier, rivals):
    """rind's time over the fastest of `rivals`, per benchmark of a tier."""
    out = {}
    for key, libs in tier["benchmarks"].items():
        base = {lib: ns for lib, ns in libs.items() if lib in rivals}
        if "rind" in libs and base:
            best = min(base, key=base.get)
            out[key] = (libs["rind"] / base[best], libs["rind"], best, base[best])
    return out


def heatmap_rivals(tier):
    """The libraries the tier heatmap ranks rind against. The portable tier
    leaves out verified-garbage, which runs its baseline assembly there, code
    rind's portable backend can never take."""
    return BASELINES + ([] if tier_name(tier) == "portable" else TIMED)


def tier_name(tier):
    """The tier's TIERS name, which benchmarks/gaps.toml decides on whatever
    CPU the runner drew."""
    name = dict(TIERS).get((tier["target"], tier["portable"], tier["tier"]))
    if name is None:
        fail(f"weekly results name an unknown tier: {tier['target']} {tier['tier']}")
    return name


def tier_column(tier):
    column = tier_name(tier)
    # The native x86_64 runner may or may not have AVX-512; name the tier it drew.
    if column == "x86_64" and "avx512" in tier:
        column += " AVX-512" if tier["avx512"] else " VAES AVX2"
    return column


def tier_columns(tiers):
    """The report's tier columns, in bench.yml's order. A tier added since the
    saved run has no column yet, rather than an empty one, which the report
    reads as code shared with the column to its left."""
    order = {name: i for i, (_, name) in enumerate(TIERS)}
    base = {tier_column(t): dict(TIERS)[(t["target"], t["portable"], t["tier"])] for t in tiers["tiers"]}
    return sorted(base, key=lambda c: order[base[c]])


def tier_row(key):
    """The CPU-tier row a weekly benchmark belongs to, or None for one
    UNRANKED lists, refusing a benchmark in neither."""
    row = next((name for name, pattern in TIER_ROWS if re.match(pattern, key)), None)
    if row is None and not any(re.match(pattern, key) for pattern, _ in UNRANKED):
        fail(f"weekly benchmark {key} matches neither a TIER_ROWS row nor UNRANKED")
    return row


def tier_cells(tiers):
    """Each CPU-tier row's worst benchmark per tier, as (key, ratio, ...)."""
    cells = {}
    for t in tiers["tiers"]:
        column = tier_column(t)
        for key, value in tier_rows(t, heatmap_rivals(t)).items():
            row = tier_row(key)
            if row is None:
                continue
            worst = cells.get((row, column))
            if worst is None or value[0] > worst[1][0]:
                cells[(row, column)] = (key, value)
    return cells


def covers(entry, operation, place):
    """Whether a benchmarks/gaps.toml entry decides the gap of an operation on
    a host or tier."""
    return place in entry["on"] and any(fnmatch.fnmatchcase(operation, op) for op in entry["operations"])


def gaps_of(hosts, tiers):
    """Each operation where another library beats rind by more than SLOWER, by
    (operation, host or tier), as (ratio, fastest library)."""
    out = {}
    for name, host in hosts.items():
        for row, libs in times(host).items():
            others = {lib: ns for lib, ns in libs.items() if lib != "rind" and lib not in VARIANTS}
            if "rind" in libs and others:
                best = min(others, key=others.get)
                if libs["rind"] / others[best] > SLOWER:
                    out[(row, name)] = (libs["rind"] / others[best], best)
    for t in tiers["tiers"] if tiers else []:
        column = tier_name(t)
        for key, (ratio, _, best, _) in tier_rows(t, BASELINES).items():
            if ratio > SLOWER and tier_row(key):
                out[(key, column)] = (ratio, best)
    return out


def gap_entries(path=GAPS):
    with open(path, "rb") as f:
        return tomllib.load(f).get("gap", [])


def load_gaps(hosts, tiers, path=GAPS):
    """The decision on each gap, with the gaps it covers, refusing a gap
    without one and an entry that covers no gap where the data measures. A
    weekly gap can come and go with the runner's CPU, so an entry need not
    match a gap everywhere it names."""
    entries = gap_entries(path)
    found = gaps_of(hosts, tiers)
    measured = set(hosts) | {tier_name(t) for t in tiers["tiers"]} if tiers else set(hosts)
    out = []
    for i, e in enumerate(entries, 1):
        where = f"{os.path.relpath(path, ROOT)}: entry {i}"
        keys = {"operations", "on", "quest", "reason"}
        if set(e) - keys:
            fail(f"{where}: unknown keys {', '.join(sorted(set(e) - keys))}")
        if not {"operations", "on"} <= set(e):
            fail(f"{where}: needs operations and on")
        if ("quest" in e) == ("reason" in e):
            fail(f"{where}: needs a quest or a reason, not both")
        # The report's gap table, and the site's, hold the reason in one cell
        # as inline Markdown.
        if re.search(r"[\r\n]", e.get("reason", "")):
            fail(f"{where}: the reason must be one line, since a table cell holds it")
        if "quest" in e and not (e["quest"].startswith("/quest/") and os.path.isfile(ROOT + e["quest"])):
            fail(f"{where}: no quest at {e['quest']}")
        # A nightly tier stays valid when this run did not draw it. Any other
        # name must be a host the data actually measured.
        tier_names = set(dict(TIERS).values())
        for place in e["on"]:
            if place not in tier_names and place not in hosts:
                fail(f"{where}: no host or tier {place}")
        covered = {k: v for k, v in found.items() if covers(e, *k)}
        if not covered and measured & set(e["on"]):
            fail(f"{where}: names no gap over 10%; update or remove the entry")
        for k in covered:
            del found[k]
        if covered:
            out.append((e, covered))
    if found:
        fail(
            f"gaps over 10% without a decision in {os.path.relpath(path, ROOT)}: "
            + ", ".join(f"{op} on {place} ({ratio:.2f}× {lib})" for (op, place), (ratio, lib) in sorted(found.items()))
        )
    return out


def quest_title(path):
    with open(ROOT + path) as f:
        return re.sub(r"^# (\[\w+\] )?", "", f.readline().strip())


def cell_text(markdown):
    """Markdown for a table cell: each pipe it hasn't escaped, after an even
    run of backslashes, escaped, so the cell holds it."""
    return re.sub(r"(\\*)\|", lambda m: m.group(1) + ("|" if len(m.group(1)) % 2 else "\\|"), markdown)


def gap_table(gaps):
    rows = {row_name(op) for op in OPERATIONS}
    tier_names = set(dict(TIERS).values())
    lines = ["| Operation | On | rind's time over the fastest | Decision |", "|---|---|---|---|"]
    for e, covered in gaps:
        ops = ", ".join(label(op) if op in rows else f"`{op}`" for op in e["operations"])
        on = ", ".join(f"{p} tier" if p in tier_names else f"`{p}`" for p in e["on"])
        ratios = [ratio for ratio, _ in covered.values()]
        spread = f"{min(ratios):.2f}×" + (f" to {max(ratios):.2f}×" if max(ratios) - min(ratios) >= 0.005 else "")
        fastest = ", ".join(sorted({COLUMNS[lib] for _, lib in covered.values()}))
        decision = f"[{quest_title(e['quest'])}]({e['quest'][1:]})" if "quest" in e else cell_text(e["reason"])
        lines.append(f"| {ops} | {on} | {spread} ({fastest}) | {decision} |")
    return lines



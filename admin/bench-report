def site_data(hosts, tiers, verified, gaps):
    """The report as data for the site's benchmarks page, which reads nothing
    else, so it never decides for itself what counts as the fastest, a proof,
    or a gap. A row's times are one cell per library of its host or tier, in
    that `libraries` order, each [its time as the report writes it, its
    SPEED_BINS bin, its time over the fastest's] or null where untimed, all
    from the full-precision times, so the page shows what the report does."""

    def cells(libraries, libs, best):
        return [
            [human(libs[lib]), bin_of(libs[lib] / libs[best], SPEED_BINS), round(libs[lib] / libs[best], 2)]
            if lib in libs
            else None
            for lib in libraries
        ]

    gap_of = {place: i for i, (_, covered) in enumerate(gaps) for place in covered}
    proof_index = {id(e): i for i, e in enumerate(verified)}
    rows = {row_name(op) for op in OPERATIONS}
    # The libraries the verified page has a column for.
    proven = [lib for lib in columns(*hosts.values()) if lib not in VARIANTS]

    def grid_cell(h, timed, lib, row):
        """A library's cell for an operation on a host, for the verified
        page: the index in `verified` of the proof that covers it,
        `{"other_os": index}` for a proof limited to another OS, `refused`
        where the library refuses to start on the host's CPU, `unproven`, or
        `untimed`. A proof shows whether or not the host timed the operation,
        since it covers the code; a cell with neither is `untimed`, as the
        library may not offer the operation or the host's results may predate
        its benchmark."""
        if lib in h.get("refused", {}):
            return "refused"
        if entry := proof_for(verified, lib, row, h):
            return proof_index[id(entry)]
        if entry := proof_for(verified, lib, row, h, any_os=True):
            return {"other_os": proof_index[id(entry)]}
        return "unproven" if lib in timed.get(row, {}) else "untimed"

    def host_data(name):
        h = hosts[name]
        out = {
            "name": name,
            "cpu": h["cpu"]["model"],
            "arch": host_arch(h),
            "logical_cpus": h["cpu"]["logical_cpus"],
            "os": h["os"],
            "os_kind": host_os(h),
            "rustc": h["toolchain"]["rustc"],
            "date": h["started"][:10],
            "commit": h["commit"],
            "noisy": bool(h.get("load", {}).get("noisy")),
            "note": host_note(name, h),
            "scaling": " ".join(scaling(h)).strip() or None,
            "refused": {lib: [f.upper() for f in missing] for lib, missing in h.get("refused", {}).items()},
            "libraries": columns(h),
            "times": {},
            "fastest": {},
            "proofs": {},
            # Every operation's cell for each library, timed or not, for the verified page.
            "grid": {
                row_name(op): {lib: grid_cell(h, times(h), lib, row_name(op)) for lib in proven}
                for op in OPERATIONS
            },
            "gaps": {},
        }
        for row, libs in times(h).items():
            if row not in rows:
                continue
            others = [lib for lib in libs if lib not in VARIANTS]
            best = fastest(libs)
            out["times"][row] = cells(out["libraries"], libs, best)
            # One library alone has no rival, so no fastest.
            if len(others) > 1:
                out["fastest"][row] = best
            proofs = {
                lib: proof_index[id(p)]
                for lib in libs
                if (p := proof_for(verified, VARIANTS.get(lib, lib), row, h)) is not None
            }
            if proofs:
                out["proofs"][row] = proofs
            if (row, name) in gap_of:
                out["gaps"][row] = gap_of[row, name]
        cost = h.get("build_cost")
        if cost and cost["status"] == "ok":
            out["build"] = {
                "date": cost["started"][:10],
                "rustc": cost["host"]["rustc"],
                "cc": cost["host"]["cc"],
                "jobs": cost["host"]["jobs"],
                "builds": [
                    {
                        "name": BUILDS.get(b["name"], b["name"]),
                        # The library each build is of, so the page shows it beside that library.
                        "library": b["name"].removeprefix("rustls-").removesuffix("-vendored"),
                        "seconds": round(b["median_seconds"], 1),
                        "low": round(min(b["seconds"]), 1),
                        "high": round(max(b["seconds"]), 1),
                        "cpu_seconds": round(b["median_cpu_seconds"]),
                        "stripped_mb": round(b["stripped_bytes"] / 1e6, 2),
                        "tools": b["tools"],
                        "crates": len(b["packages"]),
                    }
                    for b in cost["builds"]
                ],
            }
        elif cost:
            out["build"] = {"reason": cost["reason"]}
        return out

    def tier_data(t):
        column, name = tier_column(t), tier_name(t)
        timed = {lib for libs in t["benchmarks"].values() for lib in libs}
        out = {
            "name": column,
            # The TIERS name benchmarks/gaps.toml decides on.
            "tier": name,
            "cpu": t["cpu"],
            "libraries": [lib for lib in ["rind", *BASELINES, *TIMED] if lib in timed],
            # The libraries its fastest is drawn from.
            "rivals": ["rind", *heatmap_rivals(t)],
            "times": {},
            "fastest": {},
            "gaps": {},
        }
        for key, libs in t["benchmarks"].items():
            rivals = {lib: ns for lib, ns in libs.items() if lib in out["rivals"]}
            if not rivals:
                continue
            best = min(rivals, key=rivals.get)
            out["times"][key] = cells(out["libraries"], libs, best)
            if len(rivals) > 1:
                out["fastest"][key] = best
            if (key, name) in gap_of:
                out["gaps"][key] = gap_of[key, name]
        return out

    def tier_groups(tiers):
        """The tiers' benchmarks by TIER_ROWS row, then those UNRANKED keeps
        apart, by its reason."""
        keys = sorted({key for t in tiers["tiers"] for key in t["benchmarks"]})
        groups = [{"name": name, "benchmarks": [k for k in keys if re.match(p, k)]} for name, p in TIER_ROWS]
        unranked = [k for k in keys if tier_row(k) is None]
        for pattern, why in UNRANKED:
            group = [k for k in unranked if re.match(pattern, k)]
            unranked = [k for k in unranked if k not in group]
            groups.append({"name": f"Not ranked: {why}", "benchmarks": group})
        return [g for g in groups if g["benchmarks"]]

    data = {
        "schema": 1,
        "slower": SLOWER,
        "rule": VERIFIED_RULE,
        "bins": [
            {"to": edge, "label": text, "color": color}
            for edge, text, color in zip(SPEED_BINS + [None], SPEED_LABELS, SPEED)
        ],
        "standing": standing(hosts),
        "libraries": [{"id": lib, "name": COLUMNS[lib], "variant_of": VARIANTS.get(lib)} for lib in COLUMNS],
        "sections": [
            {"name": section, "operations": [{"id": row_name(op), "label": label(row_name(op))} for op in ops]}
            for section, ops in SECTIONS
        ],
        "hosts": [host_data(name) for name in shown_names(hosts)],
        "unmeasured": [name for name in COLLECT_HOSTS if name not in hosts],
        "tiers": None,
        "gaps": [],
        "verified": [
            {
                "library": e["library"],
                "operations": e["operations"],
                "platform": platform_of(e),
                **({"os": e["os"]} if "os" in e else {}),
                "proof": e["proof"],
                "link": e["link"],
            }
            for e in verified
        ],
    }
    if tiers is not None:
        order = tier_columns(tiers)
        data["tiers"] = {
            # The libraries any tier's fastest is drawn from.
            "rivals": ["rind", *BASELINES, *TIMED],
            "run": tiers["run"],
            "url": tiers["url"],
            "date": tiers["date"][:10],
            "commit": tiers["commit"],
            "columns": [tier_data(t) for t in sorted(tiers["tiers"], key=lambda t: order.index(tier_column(t)))],
            "groups": tier_groups(tiers),
        }
    for e, covered in gaps:
        ratios = [ratio for ratio, _ in covered.values()]
        data["gaps"].append(
            {
                "operations": [{"id": op, "label": label(op) if op in rows else None} for op in e["operations"]],
                "on": [{"name": p, "host": p in hosts} for p in e["on"]],
                "low": round(min(ratios), 2),
                "high": round(max(ratios), 2),
                "fastest": sorted({COLUMNS[lib] for _, lib in covered.values()}),
                "quest": {"path": e["quest"], "title": quest_title(e["quest"])} if "quest" in e else None,
                "reason": e.get("reason"),
            }
        )
    return data



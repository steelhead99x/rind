def esc(text):
    return str(text).replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;").replace('"', "&quot;")


def text_width(text, size):
    # A sans-serif's average advance; layout only needs an upper bound.
    return len(text) * size * 0.6


def luminance(color):
    def channel(c):
        c = int(c, 16) / 255
        return c / 12.92 if c <= 0.03928 else ((c + 0.055) / 1.055) ** 2.4

    r, g, b = (channel(color[i : i + 2]) for i in (1, 3, 5))
    return 0.2126 * r + 0.7152 * g + 0.0722 * b


def ink_on(fill):
    """Black or white, whichever contrasts more with the fill."""
    lum = luminance(fill)
    return "#0b0b0b" if (lum + 0.05) / 0.05 > 1.05 / (lum + 0.05) else "#ffffff"


class Svg:
    def __init__(self, theme):
        self.theme = THEMES[theme]
        self.items = []

    def text(self, x, y, text, size=12, anchor="start", weight="normal", color="ink"):
        fill = self.theme.get(color, color)
        self.items.append(
            f'<text x="{x:.1f}" y="{y:.1f}" font-size="{size}" text-anchor="{anchor}" '
            f'font-weight="{weight}" fill="{fill}">{esc(text)}</text>'
        )

    def rect(self, x, y, w, h, fill, title=None):
        attrs = f'x="{x:.1f}" y="{y:.1f}" width="{w:.1f}" height="{h:.1f}" rx="2" fill="{fill}"'
        if title:
            self.items.append(f"<rect {attrs}><title>{esc(title)}</title></rect>")
        else:
            self.items.append(f"<rect {attrs}/>")

    def verified(self, x, y, size, fill):
        """The verified mark, a shield with a check, drawn over a square of
        this fill. It lets the pointer through to the square's tooltip."""
        ink = ink_on(fill)
        self.items.append(
            f'<g transform="translate({x:.1f} {y:.1f}) scale({size / 12:.3f})" pointer-events="none">'
            f'<path d="M6 0.6 L10.8 2.4 V5.8 C10.8 8.7 8.8 10.8 6 11.6 C3.2 10.8 1.2 8.7 1.2 5.8 V2.4 Z" fill="{ink}"/>'
            f'<path d="M3.7 6.1 L5.4 7.8 L8.4 4.5" fill="none" stroke="{fill}" stroke-width="1.6" '
            'stroke-linecap="round" stroke-linejoin="round"/></g>'
        )

    def line(self, x1, y1, x2, y2, color="rule"):
        self.items.append(
            f'<line x1="{x1:.1f}" y1="{y1:.1f}" x2="{x2:.1f}" y2="{y2:.1f}" stroke="{self.theme[color]}"/>'
        )

    def render(self, width, height, title):
        return "\n".join(
            [
                f'<svg xmlns="http://www.w3.org/2000/svg" width="{width:.0f}" height="{height:.0f}" '
                f'viewBox="0 0 {width:.0f} {height:.0f}" font-family="{esc(FONT)}" role="img">',
                f"<title>{esc(title)}</title>",
                *self.items,
                "</svg>",
                "",
            ]
        )


def speed_legend(svg, x, y):
    """The speed bins' swatches in one row, then the verified mark."""
    for i, name in enumerate(SPEED_LABELS):
        svg.rect(x, y - 10, 12, 12, svg.theme["speed"][i])
        svg.text(x + 16, y, name, size=11, color="muted")
        x += 16 + text_width(name, 11) + 12
    svg.rect(x, y - 10, 12, 12, svg.theme["speed"][0])
    svg.verified(x + 1, y - 9, 10, svg.theme["speed"][0])
    svg.text(x + 16, y, "formally verified", size=11, color="muted")
    return x + 16 + text_width("formally verified", 11) + 12


SQUARE = 14
GAP = 2
ROW = 20
SECTION = 26


def grid_layout():
    """The label column's width and the grid's top, below its header."""
    label_width = max(text_width(label(row_name(op)), 12) for op in OPERATIONS) + 16
    return label_width, 66


def columns(*hosts):
    """The report's columns with a time on any of these hosts."""
    timed = {r["library"] for h in hosts for r in h["results"]}
    return [lib for lib in COLUMNS if lib in timed]


def header_lines(name):
    """A column header's lines, breaking before a + or a parenthesis."""
    return re.split(r" (?=[+(])", name)


def header_width(names):
    """The widest line of any column header."""
    return max((text_width(line, 12) for name in names for line in header_lines(name)), default=0)


def column_headers(svg, x0, y, cell_width, names):
    for i, name in enumerate(names):
        cx = x0 + i * cell_width + cell_width / 2
        lines = header_lines(name)
        for j, line in enumerate(lines):
            svg.text(cx, y - 14 * (len(lines) - 1 - j), line, anchor="middle", weight="bold")


def standing(hosts):
    """How many of rind's times are the fastest, or within 10% of it, and how
    many rind has, counting only operations another library also times."""
    ratios = [
        libs["rind"] / libs[fastest(libs)]
        for h in hosts.values()
        for libs in times(h).values()
        if "rind" in libs and any(lib != "rind" and lib not in VARIANTS for lib in libs)
    ]
    return sum(r <= SLOWER for r in ratios), len(ratios)


def overview_svg(hosts, verified, theme):
    """Operations by library, each cell a square per host, colored by its time
    over the fastest library's on that host, under how often rind leads."""
    svg = Svg(theme)
    shown = shown_names(hosts)
    libs_shown = columns(*hosts.values())
    names = [COLUMNS[lib] for lib in libs_shown]
    squares = len(shown) * SQUARE + (len(shown) - 1) * GAP
    cell = max(squares + 18, header_width(names) + 12)
    label_width, top = grid_layout()
    top += 28
    host_times = {name: times(h) for name, h in hosts.items()}

    lead, timed = standing(hosts)
    headline = f"rind is the fastest, or within 10% of it, in {lead} of its {timed} times"
    svg.text(12, 22, headline, size=18, weight="bold")
    x = max(speed_legend(svg, 12, 46), 12 + text_width(headline, 18) + 12)
    width = max(x, label_width + cell * len(names) + 12)
    svg.text(12, 66, "Each cell's squares, left to right: " + ", ".join(shown) + ".", size=11, color="muted")
    column_headers(svg, label_width, top, cell, names)

    y = top + 8
    for section, ops in SECTIONS:
        y += SECTION
        svg.text(12, y - 8, section, weight="bold")
        svg.line(12, y - 4, width - 12, y - 4)
        for op in ops:
            row = row_name(op)
            svg.text(12, y + 14, label(row))
            for c, lib in enumerate(libs_shown):
                x = label_width + c * cell + (cell - squares) / 2
                for h, name in enumerate(shown):
                    sx = x + h * (SQUARE + GAP)
                    libs = host_times[name].get(row, {})
                    if lib not in libs:
                        continue
                    ratio = libs[lib] / libs[fastest(libs)]
                    fill = svg.theme["speed"][bin_of(ratio, SPEED_BINS)]
                    proof = proof_for(verified, VARIANTS.get(lib, lib), row, hosts[name])
                    title = f"{label(row)}, {COLUMNS[lib]} on {name}: {human(libs[lib])}, {ratio:.2f}× the fastest"
                    if proof:
                        title += f"; verified: {proof['proof']}"
                    svg.rect(sx, y + 3, SQUARE, SQUARE, fill, title)
                    if proof:
                        svg.verified(sx + 1.5, y + 4.5, SQUARE - 3, fill)
            y += ROW
    return svg.render(width, y + 12, "Time over the fastest library's, by operation, library, and host")


def host_svg(name, host, verified, theme):
    """One host's times by operation and library, colored by each over the
    fastest library's."""
    svg = Svg(theme)
    cell = 92
    libs_shown = columns(host)
    label_width, top = grid_layout()
    width = label_width + cell * len(libs_shown) + 12
    x = speed_legend(svg, 12, 18)
    width = max(width, x)
    svg.text(12, 38, f"{name}: {host['cpu']['model']}", size=11, color="muted")
    column_headers(svg, label_width, top, cell, [COLUMNS[lib] for lib in libs_shown])
    host_times = times(host)

    y = top + 8
    for section, ops in SECTIONS:
        y += SECTION
        svg.text(12, y - 8, section, weight="bold")
        svg.line(12, y - 4, width - 12, y - 4)
        for op in ops:
            row = row_name(op)
            libs = host_times.get(row, {})
            svg.text(12, y + 14, label(row))
            for c, lib in enumerate(libs_shown):
                x = label_width + c * cell + 2
                if lib not in libs:
                    continue
                ratio = libs[lib] / libs[fastest(libs)]
                fill = svg.theme["speed"][bin_of(ratio, SPEED_BINS)]
                proof = proof_for(verified, VARIANTS.get(lib, lib), row, host)
                title = f"{label(row)}, {COLUMNS[lib]}: {human(libs[lib])}, {ratio:.2f}× the fastest"
                if proof:
                    title += f"; verified: {proof['proof']}"
                svg.rect(x, y + 1, cell - 4, ROW - 2, fill, title)
                text = human(libs[lib])
                mid = x + (cell - 4) / 2 - (7 if proof else 0)
                svg.text(mid, y + 14, text, size=11, anchor="middle", color=ink_on(fill))
                if proof:
                    svg.verified(mid + text_width(text, 11) / 2 + 3, y + 4, 11, fill)
            y += ROW
    return svg.render(width, y + 12, f"Times on {name}, by operation and library")


def tiers_svg(tiers, theme):
    """rind's time over the fastest rival's per CPU tier, in the benchmark
    of each row where rind trails most."""
    svg = Svg(theme)
    cells = tier_cells(tiers)
    columns = tier_columns(tiers)
    cell = 74
    label_width = max(text_width(name, 12) for name, _ in TIER_ROWS) + 16
    top = 52
    width = label_width + cell * len(columns) + 12
    x = 12
    for i, name in enumerate(TIER_LABELS):
        svg.rect(x, 8, 12, 12, svg.theme["tier"][i])
        svg.text(x + 16, 18, name, size=11, color="muted")
        x += 16 + text_width(name, 11) + 12
    width = max(width, x)
    column_headers(svg, label_width, top, cell, columns)
    y = top + 10
    for row, _ in TIER_ROWS:
        svg.text(12, y + 14, row)
        for c, column in enumerate(columns):
            found = cells.get((row, column))
            if found is None:
                continue
            key, (ratio, rind, best, best_ns) = found
            fill = svg.theme["tier"][bin_of(ratio, TIER_BINS)]
            title = f"{row} on {column}: {key} takes {human(rind)} with rind, {human(best_ns)} with {best}"
            x = label_width + c * cell + 2
            svg.rect(x, y + 1, cell - 4, ROW - 2, fill, title)
            svg.text(x + (cell - 4) / 2, y + 14, f"{ratio:.2f}", size=11, anchor="middle", color=ink_on(fill))
        y += ROW
    return svg.render(width, y + 12, TIERS_TITLE)


def and_list(words):
    return words[0] if len(words) == 1 else ", ".join(words[:-1]) + ("," if len(words) > 2 else "") + " and " + words[-1]



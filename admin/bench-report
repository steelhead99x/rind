def usable_machine_id(text):
    """A machine id, or "" when `text` is empty or the first-boot sentinel.

    machine-id(5) says the file contains `uninitialized` until the first boot
    finishes, and that string must not be turned into an id.
    """
    text = text.strip()
    if not text or text == "uninitialized":
        return ""
    return text


def machine_id_text(ident):
    """A machine id worth a tag, or "" when `ident` is not one.

    `usable_machine_id` refuses only empty text and the sentinel. This also
    refuses a different case of that sentinel, an all-zero id, and any string
    that is not 32 hex digits or a UUID. Those values are shared by images
    that were never given an id.
    """
    if not isinstance(ident, str):
        return ""
    if ident.strip().lower() == "uninitialized":
        return ""
    text = usable_machine_id(ident)
    if not text:
        return ""
    plain = re.fullmatch(r"[0-9a-fA-F]{32}", text)
    uuid = re.fullmatch(
        r"[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}",
        text,
    )
    if not plain and not uuid:
        return ""
    if set(text.replace("-", "").lower()) == {"0"}:
        return ""
    return text


def read_machine_id(paths):
    """The first usable machine id in `paths`, or "" when none is."""
    for path in paths:
        try:
            with open(path) as f:
                ident = machine_id_text(f.read())
        except OSError:
            ident = ""
        if ident:
            return ident
    return ""


def machine_identity():
    """The OS machine id, or "" when this system has none.

    A hostname is not an id: container names change every run, and a short
    one can be guessed. Clones that share one machine id share one tag.
    An empty, all-zero, or uninitialized id is no id, and so is any other
    string that is not a machine id.
    """
    ident = read_machine_id(("/etc/machine-id", "/var/lib/dbus/machine-id"))
    if ident:
        return ident
    if sys.platform == "darwin":
        found = re.search(
            r'"IOPlatformUUID" = "([^"]+)"', try_output(["ioreg", "-rd1", "-c", "IOPlatformExpertDevice"])
        )
        if found:
            return machine_id_text(found.group(1))
    return ""


# machine-id(5): a value that leaves the machine is an HMAC under an
# application key, so another program's hash of the same id does not match.
# Not a secret: anyone who already has the raw id can recompute the tag.
# The key is fixed, so one machine keeps one tag across imports.
_MACHINE_TAG_KEY = b"rind-bench-report-host"


def _absent_machine_id(ident):
    """True for empty, `uninitialized`, and an all-zero id.

    Those are not keyed. Any other string still is, so the HMAC itself can
    be checked with a short input; `machine_id_text` is what refuses a file
    that is not an id at all.
    """
    if not isinstance(ident, str):
        return True
    text = ident.strip()
    if not text or text.lower() == "uninitialized":
        return True
    folded = text.replace("-", "")
    return bool(folded) and set(folded.lower()) == {"0"} and re.fullmatch(r"[0-9a-fA-F-]+", text)


def machine_tag_for(ident):
    """The first eight hex characters of HMAC-SHA256 over `ident`, or "" when there is nothing to key."""
    if not isinstance(ident, str) or _absent_machine_id(ident):
        return ""
    return hmac.new(_MACHINE_TAG_KEY, ident.strip().encode(), hashlib.sha256).hexdigest()[:8]


def machine_tag():
    """This machine's tag. Empty when the OS has no machine id."""
    return machine_tag_for(machine_identity())


def machine_tag_of(host):
    tag = host.get("machine") if isinstance(host, dict) else None
    if isinstance(tag, str) and re.fullmatch(r"[0-9a-f]{8}", tag):
        return tag
    return ""


def _suffixed(slug, suffix):
    """`slug` plus `suffix`, shortened to the host-name limit, or "" if it cannot fit."""
    room = 81 - len(suffix)
    if room < 1:
        return ""
    base = slug if len(slug) <= room else (slug[:room].rsplit("-", 1)[0] or slug[:room])
    return base + suffix


def suffixed_host_name(slug, suffix):
    """`slug` plus `suffix`, shortened so the result still passes `check_host_name`."""
    name = _suffixed(slug, suffix)
    if not name:
        fail(f"host name {slug!r} has no free suffix")
    check_host_name(name)
    return name


def tagged_host_name(slug, tag):
    """`slug` plus its machine tag."""
    return suffixed_host_name(slug, f"-{tag}")


def different_machine(previous, host):
    """True unless both results carry the same machine tag.

    A result without a tag says nothing about which machine it came from, so
    it is never taken to be the same machine as any file, tagged or not.
    """
    left, right = machine_tag_of(previous), machine_tag_of(host)
    return not (left and left == right)


def generated_alias(host, name):
    """True when this import created the file because `name` was taken."""
    return isinstance(host, dict) and host.get("alias_of") == name


def alias_target(host):
    """The slug a generated alias records, or "" when this file is not one."""
    if not isinstance(host, dict):
        return ""
    prior = host.get("alias_of")
    if isinstance(prior, str) and prior:
        return prior
    return ""


def same_machine_alias(body, name, tag):
    """True when `body` is a generated alias of `name` for this result.

    A tagged alias matches only that tag. An alias without a tag matches
    nothing, and neither does an untagged result: either could be another
    machine, so an import neither reuses, takes over, nor deletes it.
    """
    if not generated_alias(body, name):
        return False
    body_tag = machine_tag_of(body)
    return bool(tag) and body_tag == tag


def this_machine_file(existing, filename, host):
    """True when `filename` in the data directory is already this result's machine."""
    return filename in existing and not different_machine(existing[filename], host)


def disambiguation_rank(stem, name, tag):
    """Prefer the tag alias, then the lowest numeric suffix."""
    if tag and stem == _suffixed(name, f"-{tag}"):
        return (0, 0)
    match = re.fullmatch(r"(.+)-([0-9]+)", stem)
    return (1, int(match.group(2)) if match else 10**9)


def collided_host_name(slug, tag, taken):
    """A free name for a machine whose slug is already another machine's.

    With a tag the suffix is that tag, so the same newcomer always lands on
    the same name. Without one, the suffix is the lowest free `-2`, `-3`, ...
    """
    if tag:
        candidate = tagged_host_name(slug, tag)
        if candidate not in taken:
            return candidate
    n = 2
    while True:
        candidate = suffixed_host_name(slug, f"-{n}")
        if candidate not in taken:
            return candidate
        n += 1


def assign_import_name(name, host, existing, incoming=None, blocked=frozenset()):
    """Where to put `host`, or None when it cannot be stored without risking
    another machine's file: a result with no tag whose name is taken has no
    tag to make a second name from, so it is not imported.
    `blocked` names files in the data directory that could not be read. Each
    holds its name like another machine's result, and nothing replaces it or
    takes it as a destination.

    When the slug file is already this machine, that file is the one
    destination. A marked alias is the destination otherwise, including one
    still in this collection and one whose slug is now free. That filename
    is reusable when it is missing from the data directory or the file
    already there is this machine's alias. Any other occupant is left in
    place. A free name stays that name when no such alias exists, even if
    another file carries the same tag. A result replaces only a file with
    its own tag. A different machine that wants a taken name gets
    `collided_host_name`. Only a result that will be imported counts as a
    taken incoming name.
    """
    incoming = incoming or {}
    tag = machine_tag_of(host)
    # Without a tag nothing says whose alias this is, so its marker is ignored
    # and the file is a chosen name like any other.
    slug = (alias_target(host) if tag else "") or name
    # The name already in the report wins when it is this machine. Updating
    # a marked alias beside it would leave that name at the old time.
    if isinstance(slug, str) and slug != name and this_machine_file(existing, slug, host):
        return slug
    if this_machine_file(existing, name, host):
        return name
    # A marked alias is this machine's one destination when the slug is not
    # already its file, including when the slug is free. A same-tag file that
    # is not an alias of this slug is left alone, which is how two chosen
    # names on one machine both stay.
    # An unreadable file and a result that will not be copied are never a
    # destination: the first would be overwritten, the second would move this
    # result to a name nothing else picked and drop the real alias.
    copied = {stem: body for stem, body in incoming.items() if not unmeasured(body)}
    found = {
        stem
        for records in (existing, copied)
        for stem, body in records.items()
        if stem != slug
        and stem not in blocked
        and same_machine_alias(body, slug, tag)
        and (stem not in existing or same_machine_alias(existing[stem], slug, tag))
    }
    if found:
        return min(found, key=lambda stem: disambiguation_rank(stem, slug, tag))
    # A file that will not be copied does not hold its name. A marked alias of this
    # result is a destination rather than a chosen host.
    reserved = {stem for stem, body in copied.items() if not same_machine_alias(body, name, tag)}
    taken = set(existing) | set(blocked) | reserved
    if name in blocked:
        return collided_host_name(name, tag, taken) if tag else None
    if name not in existing or not different_machine(existing[name], host):
        return name
    return collided_host_name(name, tag, taken) if tag else None


def _replace_data_file(stem, write):
    """Writes `stem`.json in the data directory through `write(file)` in one rename,
    so a crash leaves the old file or the new one, never half of either. The file
    gets the mode `open` would give it under the umask, not mkstemp's 0600, and a
    symlink at that name is replaced by a regular file."""
    fd, tmp = tempfile.mkstemp(dir=DATA_DIR, prefix=f".{stem}.", suffix=".tmp")
    try:
        umask = os.umask(0)
        os.umask(umask)
        os.fchmod(fd, 0o666 & ~umask)
        with os.fdopen(fd, "w") as f:
            write(f)
        os.replace(tmp, os.path.join(DATA_DIR, f"{stem}.json"))
    except BaseException:
        os.unlink(tmp)
        raise


def _dump_data_file(stem, body):
    """Stores `body` as `stem`.json in the data directory, atomically."""

    def write(f):
        json.dump(body, f, indent=1)
        f.write("\n")

    _replace_data_file(stem, write)


def _write_imported(directory, name, host, dest):
    """Stores `host` at `dest`, keeping a generated alias's real slug."""
    slug = alias_target(host) or name
    if dest == name and "alias_of" not in host:
        with open(os.path.join(directory, f"{name}.json")) as src:
            _replace_data_file(dest, lambda f: shutil.copyfileobj(src, f))
        return host
    body = dict(host)
    body["host"] = dest
    prior = alias_target(host)
    if dest == slug:
        body.pop("alias_of", None)
    elif dest != name:
        # Moving a marked alias keeps the slug it was generated for.
        # Renaming a slug records that slug.
        body["alias_of"] = prior if prior and prior != name else name
    elif body.get("alias_of") == name:
        body.pop("alias_of", None)
    _dump_data_file(dest, body)
    return body


def _drop_extra_aliases(slug, host, existing, keep):
    """Removes other marked aliases of `slug` so one machine stays one file.

    A same-tag alias is this machine, so a second copy is removed wherever
    the result lands. An alias without a tag may be another machine, so it is
    never removed.
    """
    tag = machine_tag_of(host)
    removed = []
    for stem, body in list(existing.items()):
        if stem == keep or not same_machine_alias(body, slug, tag):
            continue
        path = os.path.join(DATA_DIR, f"{stem}.json")
        if os.path.isfile(path):
            os.remove(path)
        del existing[stem]
        removed.append(stem)
    return removed


def newer_same_machine(slug, host, existing, dest):
    """A same-machine file this import would replace or delete that started
    later than `host`, or "" when there is none. Such a file is never lost to
    an older run."""
    tag = machine_tag_of(host)
    stems = [dest] if dest in existing and not different_machine(existing[dest], host) else []
    stems += sorted(
        stem for stem, body in existing.items() if stem != dest and same_machine_alias(body, slug, tag)
    )
    ours = started_at(host)
    return next((stem for stem in stems if started_at(existing[stem]) > ours), "")


def adopt_hosts(names, existing, copied):
    """Writes each tag of `copied[name]` into the untagged data file `name`.

    Every name is checked before any file is written, so a bad one changes nothing.
    """
    for name in names:
        if name not in existing:
            fail(f"--adopt {name}: the data directory has no readable {name}.json to adopt")
        if machine_tag_of(existing[name]):
            fail(f"--adopt {name}: {name}.json already carries a machine tag, so it is not untagged")
        if not machine_tag_of(copied.get(name)):
            fail(f"--adopt {name}: the collection has no measured, tagged {name}.json to adopt it")
        if alias_target(copied[name]):
            fail(f"--adopt {name}: the collection's {name}.json is a generated alias of {alias_target(copied[name])}")
        target = dict(existing[name], machine=machine_tag_of(copied[name]))
        newer = newer_same_machine(name, copied[name], {**existing, name: target}, name)
        if newer:
            fail(f"--adopt {name}: {newer}.json started later than the collection's {name}.json, not adopted")
    for name in names:
        tag = machine_tag_of(copied[name])
        why = unmeasured(existing[name])
        if why:
            print(f"bench-report: --adopt {name}: {name}.json holds no times ({why}), replacing it", file=sys.stderr)
        existing[name] = dict(existing[name], machine=tag)
        _dump_data_file(name, existing[name])
        print(f"bench-report: {name}: adopted by machine {tag}", file=sys.stderr)


def started_at(host):
    """When `host` started, as an aware time; the oldest possible when it does not say."""
    try:
        when = datetime.datetime.fromisoformat(host.get("started"))
    except (TypeError, ValueError):
        return datetime.datetime.min.replace(tzinfo=datetime.timezone.utc)
    return when if when.tzinfo else when.replace(tzinfo=datetime.timezone.utc)


def superseded(hosts):
    """Each result in one collection that a newer one from its machine replaces, mapped to that one.

    A tagged slug file and its tagged aliases are one machine's results under
    one slug, so only the newest `started` is imported. A tie keeps the slug
    file, then the first name. An untagged result is never grouped.
    """
    groups = {}
    for name, host in hosts.items():
        tag = machine_tag_of(host)
        if tag:
            groups.setdefault((alias_target(host) or name, tag), []).append(name)
    out = {}
    for (slug, _), names in groups.items():
        newest = max(sorted(names), key=lambda n: (started_at(hosts[n]), n == slug))
        out.update((n, newest) for n in names if n != newest)
    return out


def import_hosts(directory, adopt=()):
    """Copies a collection's measured hosts into the report's data.

    When this machine already has the slug file, that file is refreshed and
    a marked alias of it that carries its tag is removed. Otherwise a marked
    alias that carries its tag is the one destination, even when the slug
    itself is free. An alias without a tag is never reused, taken over, or
    deleted, since it may be another machine. A free name stays that name. A
    different machine with the same slug is stored beside it, as
    `<slug>-<tag>`, or `<slug>-2` when that alias is taken. A result with no
    tag has nothing to make a second name from, and no file is known to be
    its machine, so when its name is taken it is not imported. A tagged
    result never replaces an untagged file either. Only a file this import
    will copy counts as a taken incoming name. Of one machine's slug file
    and aliases in the collection, only the newest is imported, and moving
    an alias keeps `alias_of`. A same-machine file in the data directory
    that started later than the result is never replaced or deleted: the
    result is skipped instead. A file in the data directory that is not
    readable holds its name and is left as it is.

    Each name in `adopt` is an untagged file in the data directory that the
    tagged result of that name in the collection takes over: its tag is
    written into the file first, so the same-tag rule then refreshes it in
    place. Any other `adopt` name, an alias result, or a result older than
    the file or its same-tag aliases fails before anything is written.
    """
    os.makedirs(DATA_DIR, exist_ok=True)
    existing = {}
    blocked = set()
    for path in glob.glob(os.path.join(DATA_DIR, "*.json")):
        stem = os.path.splitext(os.path.basename(path))[0]
        if stem == "tiers":
            continue
        try:
            existing[stem] = read_host(path, stem)
        except BadHostFile as e:
            print(f"bench-report: {e}, left as it is", file=sys.stderr)
            blocked.add(stem)
    incoming = load_hosts(directory)
    copied = {}
    for name, host in incoming.items():
        why = unmeasured(host)
        if why:
            print(f"bench-report: {name}: not imported, {why}", file=sys.stderr)
        else:
            copied[name] = host
    adopt_hosts(adopt, existing, copied)
    for name, newer in sorted(superseded(copied).items()):
        print(f"bench-report: {name}: same machine as {newer}, not a second host", file=sys.stderr)
        del copied[name]
    for name, host in copied.items():
        slug = alias_target(host) or name
        dest = assign_import_name(name, host, existing, copied, blocked)
        if dest is None:
            print(
                f"bench-report: {name}: not imported, a result that may be another machine's holds {name} "
                "and this one has no machine id to name a second file; rerun it with a different --host",
                file=sys.stderr,
            )
            continue
        newer = newer_same_machine(slug, host, existing, dest)
        if newer:
            print(f"bench-report: {name}: not imported, {newer} from the same machine started later", file=sys.stderr)
            continue
        creating = dest not in existing
        prior = alias_target(host)
        moved = prior and dest == prior and name != dest
        if not creating and not moved:
            print(f"bench-report: {name}: same machine as {dest}, not older, refreshed {dest}", file=sys.stderr)
        existing[dest] = _write_imported(directory, name, host, dest)
        removed = _drop_extra_aliases(slug, host, existing, dest)
        for stem in sorted(removed):
            print(f"bench-report: {stem}: same machine as {slug}, dropped", file=sys.stderr)
        if moved:
            print(f"bench-report: {name}: same machine as {dest}, refreshed {dest}", file=sys.stderr)
        elif creating and dest != name:
            print(f"bench-report: {name}: same slug as another machine, imported as {dest}", file=sys.stderr)


def render(args):
    if args.adopt and not args.collection:
        fail("--adopt needs --from DIR")
    if args.check and args.collection:
        fail("--check never writes, and --from DIR writes benchmarks/data: import with `render --from DIR`, then check")
    if args.collection:
        import_hosts(args.collection, args.adopt or ())
    hosts = load_measured(DATA_DIR)
    tiers_path = os.path.join(DATA_DIR, "tiers.json")
    tiers = None
    if os.path.exists(tiers_path):
        with open(tiers_path) as f:
            tiers = json.load(f)
    verified = load_verified()
    generated = sorted(glob.glob(os.path.join(REPORT_DIR, "*.svg")))
    if os.path.exists(REPORT):
        generated.append(REPORT)
    if not hosts and tiers is None:
        if args.check and generated:
            fail("BENCHMARKS.md and its SVGs exist without results in benchmarks/data")
        if not args.check:
            fail("no results in benchmarks/data: run `collect`, then `render --from DIR`")
        return
    files = report(hosts, tiers, verified, load_gaps(hosts, tiers))
    if args.check:
        stale = [p for p in files if not os.path.exists(p) or open(p).read() != files[p]]
        stale += [p for p in generated if p not in files]
        if stale:
            fail("out of date, rerun `admin/bench-report render`: " + ", ".join(os.path.relpath(p, ROOT) for p in stale))
        return
    for path in generated:
        if path not in files:
            os.remove(path)
    for path, content in files.items():
        os.makedirs(os.path.dirname(path), exist_ok=True)
        with open(path, "w") as f:
            f.write(content)
    print(os.path.relpath(REPORT, ROOT))


def significant(ns):
    return float(f"{ns:.4g}")


def load_run(paths):
    """A weekly run's tiers from its `bench-*/bench-results.json` artifacts,
    each benchmark's times by library under its ID with `*` in the library's
    place."""
    tiers = []
    for path in paths:
        with open(path) as f:
            saved = json.load(f)
        benchmarks = {}
        for r in saved["results"]:
            parts = r["id"].split("/")
            lib = next((p for p in parts if p == "rind" or p in BASELINES or p in TIMED), None)
            if lib is None:
                continue
            key = "/".join("*" if p == lib else p for p in parts)
            benchmarks.setdefault(key, {})[lib] = significant(r["ns"])
        tiers.append({k: saved[k] for k in ("target", "portable", "tier", "cpu", "avx512") if k in saved} | {"benchmarks": benchmarks})
    return tiers


def run_tiers(directory):
    paths = sorted(glob.glob(os.path.join(directory, "*", "bench-results.json")))
    if not paths:
        fail(f"no bench-*/bench-results.json in {directory}")
    return {"tiers": load_run(paths)}


def gate(args):
    """Fails on a gap over SLOWER that benchmarks/gaps.toml holds no decision
    for and that the previous run, if given, showed too, since GitHub draws a
    different CPU each night. Prints a Markdown summary."""
    tiers = run_tiers(args.dir)
    previous = gaps_of({}, run_tiers(args.previous)) if args.previous else None
    entries = gap_entries(GAPS)
    # A benchmark only TIMED libraries rival, such as ChaCha20 without
    # Poly1305, is ranked for the heatmap alone, so it goes unmentioned.
    unbaselined = sorted(
        {
            f"{key} on {tier_column(t)}"
            for t in tiers["tiers"]
            for key, libs in t["benchmarks"].items()
            if tier_row(key) and not set(libs) & set(BASELINES + TIMED)
        }
    )
    undecided, once = [], []
    for (key, column), (ratio, best) in sorted(gaps_of({}, tiers).items()):
        if any(covers(e, key, column) for e in entries):
            continue
        cell = f"{key} on {column} ({ratio:.2f}× {best})"
        if previous is None or (key, column) in previous:
            undecided.append(cell)
        else:
            once.append(cell)
    if unbaselined:
        print(f"No baseline, so no ratio: {', '.join(unbaselined)}.\n")
    if once:
        print(f"Over {SLOWER}× without a decision, but not in the previous run: {', '.join(once)}.\n")
    if undecided:
        print(f"Over {SLOWER}× without a decision in benchmarks/gaps.toml: {', '.join(undecided)}.")
        fail(f"{len(undecided)} gaps over {SLOWER}× without a decision in benchmarks/gaps.toml")
    print(f"Every gap over {SLOWER}× has a decision in benchmarks/gaps.toml.")


def weekly(args):
    """Saves the latest weekly bench's results on main as the CPU tiers,
    from a run that timed every tier, since the report reads an empty cell as
    code that tier shares with the one to its left."""
    runs = json.loads(
        output(
            ["gh", "run", "list", "--repo", REPO, "--workflow", "bench.yml", "--branch", "main", "--event"]
            + ["schedule", "--limit", "20", "--json", "databaseId,headSha,createdAt,url,status"]
        )
    )
    scratch = os.path.join(ROOT, ".tmp", "bench-report", "weekly")
    incomplete = []
    for run in runs:
        if run["status"] != "completed":
            continue
        shutil.rmtree(scratch, ignore_errors=True)
        got = subprocess.run(
            ["gh", "run", "download", str(run["databaseId"]), "--repo", REPO, "--pattern", "bench-*"]
            + ["--dir", scratch],
            capture_output=True,
        )
        paths = sorted(glob.glob(os.path.join(scratch, "*", "bench-results.json")))
        if got.returncode != 0 or not paths:
            continue
        tiers = load_run(paths)
        order = {key: i for i, (key, _) in enumerate(TIERS)}
        missing = set(order) - {(t["target"], t["portable"], t["tier"]) for t in tiers}
        if missing:
            incomplete.append(f"{run['databaseId']} lacks {', '.join(dict(TIERS)[k] for k in sorted(missing))}")
            continue
        tiers.sort(key=lambda t: order.get((t["target"], t["portable"], t["tier"]), len(order)))
        os.makedirs(DATA_DIR, exist_ok=True)
        with open(os.path.join(DATA_DIR, "tiers.json"), "w") as f:
            json.dump(
                {
                    "schema": 1,
                    "run": run["databaseId"],
                    "url": run["url"],
                    "commit": run["headSha"],
                    "date": run["createdAt"],
                    "tiers": tiers,
                },
                f,
                indent=1,
            )
            f.write("\n")
        shutil.rmtree(scratch)
        print(f"bench-report: tiers from run {run['databaseId']}", file=sys.stderr)
        return
    fail("no completed weekly bench run on main timed every tier" + "".join(f"; run {r}" for r in incomplete))


def main():
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    sub = parser.add_subparsers(dest="command", required=True)

    p = sub.add_parser("collect", help="run the benchmarks on the maintainer's machines")
    p.add_argument("--commit", default="HEAD", help="the commit to measure (default HEAD)")
    p.add_argument("--host", action="append", help="a COLLECT_HOSTS machine to measure (default: all, in order)")
    p.add_argument("--out", help="the results directory (default .tmp/bench-report/<commit>)")
    p.set_defaults(func=collect)

    p = sub.add_parser("summary", help="print rind-versus-fastest for every host JSON in a directory")
    p.add_argument("dir")
    p.set_defaults(func=summary)

    p = sub.add_parser("render", help="write BENCHMARKS.md and its SVGs from benchmarks/data")
    p.add_argument("--from", dest="collection", metavar="DIR", help="first import every measured host JSON from DIR")
    p.add_argument(
        "--adopt",
        action="append",
        metavar="NAME",
        help="let DIR's tagged NAME.json take over the untagged NAME.json in benchmarks/data (repeatable)",
    )
    p.add_argument(
        "--check",
        action="store_true",
        help="fail if BENCHMARKS.md or its SVGs are out of date, writing nothing (so not with --from)",
    )
    p.set_defaults(func=render)

    p = sub.add_parser("weekly", help="save the latest weekly bench's results as the CPU tiers")
    p.set_defaults(func=weekly)

    p = sub.add_parser("gate", help="fail on a weekly run's gap without a decision")
    p.add_argument("dir", help="the run's downloaded bench-* artifacts")
    p.add_argument("--previous", metavar="DIR", help="the previous run's, to fail only on a gap both show")
    p.set_defaults(func=gate)

    p = sub.add_parser("run", help="measure this machine")
    p.add_argument("--host", help="name for this machine (default: a slug of its CPU model)")
    p.add_argument("--commit", required=True)
    p.add_argument("--jobs", type=int, required=True)
    p.add_argument("--target-dir", required=True)
    p.add_argument("--out", required=True)
    p.set_defaults(func=run)

    args = parser.parse_args()
    args.func(args)


if __name__ == "__main__":
    main()

# What a ✓ means, which the report and the site's verified page both state.
VERIFIED_RULE = (
    "A ✓ means a published, machine-checked proof shows that all the code computing the operation, as "
    "that library runs it on that host, gives the specified result for every input: the cipher and its "
    "mode, the hash over every block with its padding, the whole scalar multiplication or exponentiation, "
    "and the glue around them, such as clamping, byte conversion, and point encoding. Parsing DER key and "
    "signature containers, randomness, and the message hash a signature takes are left out. Proofs of "
    "memory safety alone, or of only some of the code, earn no ✓."
)


def platform_of(entry):
    words = [entry.get("arch", "any architecture")]
    has = [f for f in entry.get("cpu", []) if not f.startswith("!")]
    lacks = [f.removeprefix("!") for f in entry.get("cpu", []) if f.startswith("!")]
    if has:
        words.append("with " + ", ".join(has))
    if lacks:
        words.append("without " + ", ".join(lacks))
    if "os" in entry:
        words.append({"linux": "on Linux", "macos": "on macOS"}[entry["os"]])
    return " ".join(words)


def scaling(host):
    """How rind-rustls's handshake throughput scales from one thread to every
    core on a host, as report lines. No threshold checks it: a refresh that
    sees it fall opens a quest."""
    t = times(host)
    parts = []
    for kind, one in (("full", "rustls-full-handshake-group/x25519"), ("resumed", "rustls-resumed-handshake/x25519")):
        rind_one = t.get(one, {}).get("rind")
        rind_all = t.get(f"rustls-{kind}-handshake-threads/x25519", {}).get("rind")
        if rind_one and rind_all:
            parts.append(f"{kind} handshakes at {rind_one / rind_all:.1f} times")
    if not parts:
        return []
    return [f"rind-rustls on all {host['cpu']['logical_cpus']} logical CPUs runs {and_list(parts)} its one-thread rate.", ""]


def host_table(host, verified):
    host_times = times(host)
    libs_shown = columns(host)
    lines = [
        "| Operation | " + " | ".join(COLUMNS[lib] for lib in libs_shown) + " |",
        "|---|" + "---|" * len(libs_shown),
    ]
    for op in OPERATIONS:
        row = row_name(op)
        libs = host_times.get(row, {})
        cells = []
        for lib in libs_shown:
            if lib not in libs:
                cells.append("-")
                continue
            check = " ✓" if proof_for(verified, VARIANTS.get(lib, lib), row, host) else ""
            cells.append(f"{human(libs[lib])}{check}")
        lines.append(f"| {label(row)} | " + " | ".join(cells) + " |")
    return lines


def build_table(cost):
    lines = [
        "| Build | Wall s (range) | CPU s | Stripped MB | Tools needed | Crates |",
        "|---|---|---|---|---|---|",
    ]
    for b in cost["builds"]:
        spread = f"{min(b['seconds']):.1f} to {max(b['seconds']):.1f}"
        lines.append(
            f"| {BUILDS.get(b['name'], b['name'])} | {b['median_seconds']:.1f} ({spread}) "
            f"| {b['median_cpu_seconds']:.0f} | {b['stripped_bytes'] / 1e6:.2f} "
            f"| {', '.join(b['tools']) or 'none'} | {len(b['packages'])} |"
        )
    return lines


def comparison_table(hosts, verified):
    """The README's table of rind against the libraries an adopter weighs it
    against, every cell drawn from the results, build costs, and verified
    code."""
    rows = [row_name(op) for op in OPERATIONS]
    algorithm = {}
    for row in rows:
        names = [name for name, pattern in ALGORITHMS if re.match(pattern, row)]
        if len(names) != 1 and not any(re.match(p, row) for p in INTEGRATIONS):
            fail(f"{row} matches {len(names)} of the comparison's algorithms, not one")
        if len(names) == 1:
            algorithm[row] = names[0]
    for (lib, name), why in OUTSIDE_API.items():
        if lib not in COMPARED or name not in dict(ALGORITHMS):
            fail(f"OUTSIDE_API names {lib} and {name}, which the comparison lacks")
    offered = {lib: set() for lib in COMPARED}
    for h in hosts.values():
        for row, libs in times(h).items():
            for lib in libs:
                if lib in offered and row in algorithm:
                    offered[lib].add(algorithm[row])
    timed = [name for name, _ in ALGORITHMS if any(name in names for names in offered.values())]
    lines = [
        f"| Library | Build tools beyond rustc | Lacks, of the {len(timed)} algorithms benchmarked "
        "| Formally verified | Fastest, or within 10% |",
        "|---|---|---|---|---|",
    ]
    for lib, link in COMPARED.items():
        tools, built = set(), False
        for h in hosts.values():
            cost = h.get("build_cost") or {}
            for b in cost.get("builds", []) if cost.get("status") == "ok" else []:
                if b["name"] == lib:
                    tools.update(b["tools"])
                    built = True
        lacks = [
            f"{name} ({OUTSIDE_API[lib, name]})" if (lib, name) in OUTSIDE_API else name
            for name in timed
            if name not in offered[lib] or (lib, name) in OUTSIDE_API
        ]
        # Each verified algorithm by architecture, marked when only some of
        # that architecture's CPUs run the proven code of one of its
        # operations, or the proofs cover only some of its benchmarked ones.
        proven = {}
        for e in verified:
            if e["library"] != lib:
                continue
            covered = {r for p in e["operations"] for r in fnmatch.filter(rows, p) if r in algorithm}
            # An entry with no arch runs the same code on every one.
            arch = e.get("arch", "all")
            everywhere = not (e.get("cpu") or e.get("os"))
            for row in covered:
                # Each row, and whether some proof of it runs on every CPU.
                ops = proven.setdefault(arch, {}).setdefault(algorithm[row], {})
                ops[row] = ops.get(row, False) or everywhere
        order = [name for name, _ in ALGORITHMS]

        def limits(name, ops):
            some = ["some CPUs"] if not all(ops.values()) else []
            if any(algorithm[r] == name and r not in ops for r in algorithm):
                some.append("some operations")
            return f" ({', '.join(some)})" if some else ""

        arches = [
            f"{arch}: "
            + ", ".join(
                name + limits(name, ops)
                for name, ops in sorted(proven[arch].items(), key=lambda item: order.index(item[0]))
            )
            for arch in sorted(proven, key=lambda arch: (arch != "all", arch))
        ]
        lead = timings = 0
        for h in hosts.values():
            for libs in times(h).values():
                if lib in libs and any(other != lib and other not in VARIANTS for other in libs):
                    timings += 1
                    lead += libs[lib] / libs[fastest(libs)] <= SLOWER
        name = COLUMNS[lib] if lib == "rind" else f"[{COLUMNS[lib]}]({link})"
        # Absolute, since crates.io and docs.rs show the README too.
        benchmarks = f"https://github.com/{REPO}/blob/main/BENCHMARKS.md"
        lines.append(
            f"| {name} | [{(', '.join(sorted(tools)) or 'none') if built else UNMEASURED}]({benchmarks}#build-cost) "
            f"| {(', '.join(lacks) or 'none') if offered[lib] else UNMEASURED} "
            f"| [{'; '.join(arches) or 'none'}]({benchmarks}#verified-code) "
            f"| [{f'{lead} of its {timings} times' if timings else UNMEASURED}]({benchmarks}#speed) |"
        )
    return lines


def readme_with_comparison(lines, path=README):
    """The README with the comparison between its markers replaced."""
    with open(path) as f:
        text = f.read()
    start, end = COMPARISON_MARKERS
    if text.count(start) != 1 or text.count(end) != 1 or text.index(start) > text.index(end):
        fail(f"{os.path.relpath(path, ROOT)} needs one {start} before one {end}")
    head, rest = text.split(start)
    _, tail = rest.split(end)
    return head + start + "\n" + "\n".join(lines) + "\n" + end + tail



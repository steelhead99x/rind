#!/usr/bin/env bash
# Tests admin/mutants-cargo's argument rewriting, with `echo` as the real
# cargo so each case prints the command the wrapper would run.
set -euo pipefail
here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
export RIND_REAL_CARGO=echo

failed=0
expect() {
    local want=$1
    shift
    local got
    got=$("$here/mutants-cargo" "$@")
    if [[ $got != "$want" ]]; then
        printf 'admin/mutants-cargo %s\n  want: %s\n  got:  %s\n' "$*" "$want" "$got" >&2
        failed=1
    fi
}

expect 'test --package=rind-rcgen@0.13.2 --features=wipe --features=zeroize' \
    test --package=rind-rcgen@0.13.2
expect 'test -p rind-rcgen --features=wipe --features=zeroize -- --nocapture' \
    test -p rind-rcgen -- --nocapture
expect 'test -prind-rcgen --features=wipe --features=zeroize' \
    test -prind-rcgen
expect 'nextest run --package rind-rcgen --features=wipe --features=zeroize' \
    nextest run --package rind-rcgen
expect 'check --package=rind-rcgen@0.13.2 --features=wipe --features=zeroize' \
    check --package=rind-rcgen@0.13.2
expect 'test -p rind-rcgen --features=wipe --features=zeroize -- --package=foo' \
    test -p rind-rcgen -- --package=foo
expect 'test --package=rind@0.3.2' test --package=rind@0.3.2
expect 'test -p rind -- --package=rind-rcgen' \
    test -p rind -- --package=rind-rcgen
expect $'test --package=rind-rcgen@0.13.2 --package=rind@0.3.2\ntest --package=rind-rcgen@0.13.2 --features=wipe --features=zeroize' \
    test --package=rind-rcgen@0.13.2 --package=rind@0.3.2
expect $'test --workspace\ntest --package=rind-rcgen --features=wipe --features=zeroize' \
    test --workspace
expect $'nextest run --workspace --no-run\nnextest run --no-run --package=rind-rcgen --features=wipe --features=zeroize' \
    nextest run --workspace --no-run
expect $'check --tests --package=rind-rcgen@0.14.4 --package=rind@0.3.2\ncheck --tests --package=rind-rcgen@0.14.4 --features=wipe --features=zeroize' \
    check --tests --package=rind-rcgen@0.14.4 --package=rind@0.3.2
expect 'build -p rind-rcgen' build -p rind-rcgen
expect ''

exit "$failed"

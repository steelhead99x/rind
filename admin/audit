# Test code and tooling, which the table leaves out: integration tests, and
# the crates nothing ships.
TOOLING = ("admin/", "fuzz/", "rind-acvp/", "rind-bench/", "rind-cpuid/", "rind-devbench/", "rind-timing/")


def unsafe_counts():
    """Each area's count of the `unsafe` keyword outside comments and literals."""
    counts = {area: 0 for area, _, _ in UNSAFE}
    # Tracked and new files alike, as the checks see the working tree; a file
    # deleted from it but not from the index is gone.
    files = subprocess.run(
        ["git", "-C", str(ROOT), "ls-files", "-z", "--cached", "--others", "--exclude-standard", "--", "*.rs"],
        capture_output=True,
        text=True,
        check=True,
    ).stdout.split("\0")
    for f in sorted(set(files)):
        if not f or not (ROOT / f).is_file() or f.startswith(TOOLING) or "tests" in f.split("/")[:-1]:
            continue
        n = sum(1 for t in idents((ROOT / f).read_text()) if t == "unsafe")
        if not n:
            continue
        area = next((a for a, _, _ in UNSAFE if f.startswith(a)), None)
        if area is None:
            sys.exit(f"error: {f} holds `unsafe`, in no area admin/audit's UNSAFE describes; add one")
        counts[area] += n
    for area, n in counts.items():
        if not n:
            sys.exit(f"error: admin/audit's UNSAFE describes {area}, which holds no `unsafe`; remove it")
    return counts


def area_name(area):
    return "other `rind/src/low` files" if area == "rind/src/low/" else f"`{area.rstrip('/')}`"


def render_unsafe():
    """The `unsafe` table: each area that holds it, what it is, and what justifies it."""
    unsafe_counts()
    lines = [
        "| Area | What it is | What justifies it |",
        "|---|---|---|",
    ]
    lines += [f"| {area_name(area)} | {what} | {why} |" for area, what, why in UNSAFE]
    return "\n".join(lines)


def main():
    match sys.argv[1:]:
        case ["check"]:
            text = PAGE.read_text()
            if render(text) != text:
                sys.exit("error: AUDIT.md's generated tables are stale; run `admin/audit fix`")
            # A finished quest is deleted, and its gap with it.
            for link in re.findall(r"\]\((/quest/[^)#]+)", text):
                if not (ROOT / link[1:]).is_file():
                    sys.exit(f"error: AUDIT.md links {link}, which is finished; say what changed")
        case ["fix"]:
            PAGE.write_text(render(PAGE.read_text()))
        case ["unsafe"]:
            for area, n in unsafe_counts().items():
                print(f"{n:6}  {area}")
        case _:
            sys.exit("usage: admin/audit check | fix | unsafe")


main()

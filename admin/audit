#!/usr/bin/env python3

# Usage: admin/audit check | fix | unsafe
#
# `check` fails unless AUDIT.md's two generated tables, each between its
# markers, are the ones this renders, and `fix` rewrites them. The pins table
# holds each importer's and vector sync's revision, the base of rind's
# s2n-bignum fork, and the version Cargo.lock resolves for each crate the
# `rind` crate's own code links. The `unsafe` table names each area of shipped
# code that may hold the `unsafe` keyword (outside comments and literals), and
# fails on one in an area it does not describe or an area that holds none. It
# leaves the counts out, since nearly every PR touching `unsafe` would change
# them and parallel PRs would race to regenerate it; `unsafe` prints them.
# `check` also fails on a link to a quest that no longer exists, since
# finishing it changes the gap AUDIT.md describes there.

import pathlib, re, subprocess, sys, tomllib

ROOT = pathlib.Path(__file__).resolve().parent.parent
PAGE = ROOT / "AUDIT.md"
PINS_MARKERS = ("<!-- admin/audit pins: begin -->", "<!-- admin/audit pins: end -->")
UNSAFE_MARKERS = ("<!-- admin/audit unsafe: begin -->", "<!-- admin/audit unsafe: end -->")

SHA = r"([0-9a-f]{40})"
REV = rf'^REV = "{SHA}"$'

# Each pin: the upstream, what rind takes from it at that pin, the file that
# pins it, and the pattern whose group is the pin there.
PINS = [
    ("aws-lc", "copied and ported code", "admin/import-aws-lc", REV),
    ("BoringSSL", "copied code", "admin/import-boringssl", REV),
    ("OpenSSL", "copied code", "admin/import-openssl", REV),
    ("HACL\\*", "Vale's x86_64 AES-GCM", "admin/import-hacl", REV),
    ("pyca/verified-garbage", "copied code and the Lean ISA models its proofs rest on", "admin/import-vg", REV),
    ("mlkem-native", "aarch64 ML-KEM ciphertext compression, and the HOL Light proofs of it and of x86_64's", "admin/import-mlkem-native", REV),
    (
        "s2n-bignum",
        "assembly and the HOL Light proofs of it",
        "thirdparty/s2n-bignum/RIND.md",
        rf"^Base: `{SHA}`$",
    ),
    (
        "aws-lc",
        "the routines aws-lc-verification's SHA-384/512 proofs are about",
        "admin/prove-bytes",
        rf'^AWS_LC_REVISION = "{SHA}"$',
    ),
    ("ACVP-Server", "test vectors", "admin/sync-acvp", rf"^ACVP_SERVER={SHA}$"),
    ("aws-lc", "test vectors", "admin/sync-vectors", rf"^AWS_LC={SHA}$"),
    ("BoringSSL", "test vectors", "admin/sync-vectors", rf"^BORINGSSL={SHA}$"),
    ("Wycheproof", "test vectors", "admin/sync-vectors", rf"^WYCHEPROOF={SHA}$"),
    ("CAVP", "test vectors", "admin/sync-vectors", rf"^CAVP={SHA}$"),
    ("CCTV", "test vectors", "admin/sync-vectors", rf"^CCTV={SHA}$"),
    ("RFC 9180", "HPKE test vectors", "admin/sync-vectors", rf"^HPKE={SHA}$"),
    ("RFC 9380", "hash-to-curve test vectors", "admin/sync-vectors", rf"^HASH_TO_CURVE={SHA}$"),
    ("blind-rsa-signatures", "RFC 9474 test vectors", "admin/sync-vectors", rf"^BLIND_RSA={SHA}$"),
    ("RFC 9497", "OPRF test vectors", "admin/sync-vectors", rf"^VOPRF={SHA}$"),
    ("RFC 9591", "FROST test vectors", "admin/sync-vectors", rf"^FROST={SHA}$"),
]


# What rind's code takes from each crate it links. A crate missing here fails
# the check, so a new dependency says what it brings.
CRATES = {
    "cfg-if": "a macro for `cfg` blocks",
    "curve25519-dalek": "X25519, Ed25519, and ristretto255 on armv7 and the portable backend",
    "fiat-crypto": "the NIST curves' field arithmetic on armv7 and the portable backend",
    "getrandom": "the operating system's random source",
    "libc": "`getauxval`, for armv7's crypto extension bits",
    "libcrux-hacl-rs": "the runtime of the HACL\\* ChaCha20 rounds rind copied",
    "libcrux-macros": "the same",
    "libcrux-poly1305": "HACL\\*'s Poly1305, on 32-bit portable targets",
}


def pin(path, pattern):
    found = re.findall(pattern, (ROOT / path).read_text(), re.M)
    if len(found) != 1:
        sys.exit(f"error: {path} has {len(found)} lines matching {pattern}, not one")
    return found[0]


def crates():
    """The crates rind's own code links, at the versions Cargo.lock resolves."""
    manifest = tomllib.loads((ROOT / "rind/Cargo.toml").read_text())
    tables = [manifest.get("dependencies", {})]
    tables += [t.get("dependencies", {}) for t in manifest.get("target", {}).values()]
    # An optional dependency is behind a feature: crabgrind, ctgrind's only.
    names = sorted({n for t in tables for n, s in t.items() if not (isinstance(s, dict) and s.get("optional"))})
    lock = tomllib.loads((ROOT / "Cargo.lock").read_text())["package"]
    (rind,) = [p for p in lock if p["name"] == "rind"]
    rows = []
    for name in names:
        deps = [d.split(" ") for d in rind.get("dependencies", []) if d.split(" ")[0] == name]
        if len(deps) != 1:
            sys.exit(f"error: Cargo.lock lists rind's dependency {name} {len(deps)} times")
        if len(deps[0]) > 1:
            version = deps[0][1]
        else:
            versions = [p["version"] for p in lock if p["name"] == name]
            if len(versions) != 1:
                sys.exit(f"error: Cargo.lock resolves {name} to {versions or 'nothing'}, not one version")
            version = versions[0]
        rows.append((name, version))
    return rows


def render_pins():
    lines = [
        "| Upstream | Pin | Pinned in | What rind takes at it |",
        "|---|---|---|---|",
    ]
    for name, what, path, pattern in PINS:
        lines.append(f"| {name} | `{pin(path, pattern)[:12]}` | `{path}` | {what} |")
    for name, version in crates():
        if name not in CRATES:
            sys.exit(f"error: admin/audit's CRATES does not say what rind takes from {name}")
        lines.append(f"| {name} | {version} | `Cargo.lock` | {CRATES[name]} |")
    return "\n".join(lines)


def replace(text, markers, table):
    begin, end = markers
    before, sep, rest = text.partition(begin + "\n")
    middle, sep2, after = rest.partition(end)
    if not sep or not sep2:
        sys.exit(f"error: AUDIT.md lacks the {begin} and {end} markers")
    return f"{before}{begin}\n{table}\n{end}{after}"


def render(text):
    return replace(replace(text, PINS_MARKERS, render_pins()), UNSAFE_MARKERS, render_unsafe())


# One Rust token the lexer skips or keeps: a comment opener, a string or char
# literal, an identifier, or any other character. A `'` not closed as a char
# literal is a lifetime or label, so its name lexes as an identifier.
TOKEN = re.compile(
    r"""(?P<line>//[^\n]*)"""
    r"""|(?P<block>/\*)"""
    r"""|(?P<raw>b?r(?P<hashes>#*)")"""
    r"""|(?P<str>b?"(?:\\.|[^"\\])*")"""
    r"""|(?P<char>b?'(?:\\(?:u\{[0-9a-fA-F_]*\}|x..|.)|[^'\\])')"""
    r"""|(?P<ident>[A-Za-z_][A-Za-z0-9_]*)"""
    r"""|.""",
    re.S,
)


def idents(src):
    """Yields the identifiers and keywords of Rust source, skipping comments and literals."""
    i = 0
    while i < len(src):
        m = TOKEN.match(src, i)
        i = m.end()
        if m["block"]:
            # Block comments nest.
            depth = 1
            while depth:
                c = re.compile(r"/\*|\*/").search(src, i)
                if not c:
                    return
                depth += 1 if c[0] == "/*" else -1
                i = c.end()
        elif m["raw"] is not None:
            end = src.find('"' + m["hashes"], i)
            i = len(src) if end < 0 else end + 1 + len(m["hashes"])
        elif m["ident"]:
            yield m["ident"]


# Each area of shipped code that may hold `unsafe`, a directory or a file,
# longest prefix first where one nests in another: its path, what the
# `unsafe` there is, and what justifies it.
UNSAFE = [
    (
        "rind/src/low/x86_64/",
        "`asm!`, naked functions, and intrinsics",
        "[`rind::doc::inline_assembly_safety`](rind/src/low/inline_assembly_safety.rs), "
        "with the calling-convention, bounds, and `admin/prove bytes` checks above",
    ),
    ("rind/src/low/aarch64/", "the same", "the same"),
    ("rind/src/low/arm/", "`global_asm!` and the calls into it", "the same"),
    (
        "rind/src/low/generic/",
        "SSE2 intrinsics in `aes_nohw`, Argon2's memory of blocks set one at a time, `ReuseCache`'s one-time "
        "initialization, the volatile wipe, a cast between same-layout arrays, the link section that puts "
        "SHA-256's constants in ESP-IDF's internal RAM, and MD5's empty `asm!` barrier",

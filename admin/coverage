#!/usr/bin/env bash
# Measures how much of the published code its tests run: the rind crate and
# its adapters under `cargo test`, rind-dart under `dart test`, and pyrind
# (rind-python) under `sh/python.sh test`. The tools, rind-bench, rind-cpuid,
# rind-timing, and the fuzzer, are left out. Runs in the `coverage` dev shell.
#
# Usage: admin/coverage [REPORT-ARGS...], which go to `cargo llvm-cov report`.

set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

# for branch coverage support, which is unstable
export RUSTC_BOOTSTRAP=1
OPTIONS=--branch

# show-env shares the workspace's target directory, where sh/python.sh also
# builds.
target=$(cargo metadata --format-version 1 --no-deps | jq -r .target_directory)
out=$target/coverage
# The report reads objects only from the profile's directory, and only
# executables, so the Dart and Python libraries are installed here.
objects=$target/debug/coverage
rm -rf "$out" "$objects"
mkdir -p "$out/bin" "$objects"
cargo llvm-cov show-env --sh $OPTIONS > "$out/env.sh"
# shellcheck source=/dev/null
source "$out/env.sh"
cargo llvm-cov clean --workspace

tests=(--workspace --exclude rind-bench --exclude rind-cpuid --exclude rind-fuzz --exclude rind-timing)
env SLOW_TESTS=1 cargo test --locked "${tests[@]}"

case $(uname -m) in
    x86_64)
        env RIND_CPU_DISABLE_sha=1 RIND_CPU_DISABLE_intel=1 RIND_CPU_DISABLE_avx512bw=1 RIND_CPU_DISABLE_avx512f=1 RIND_CPU_DISABLE_vaes=1 cargo test --locked "${tests[@]}"
        env CARGO_TARGET_X86_64_UNKNOWN_LINUX_GNU_RUNNER="sde -dmr --" cargo test --locked "${tests[@]}"
        ;;
    arm|arm64|aarch64)
        env RIND_CPU_DISABLE_sha3=1 cargo test --locked "${tests[@]}"
        ;;
esac

# rind-dart's build hook runs cargo with only the environment Dart lets
# through, which keeps PATH but drops show-env's wrapper variables, so a cargo
# ahead of the real one on PATH restores them.
cat > "$out/bin/cargo" <<EOF
#!/bin/sh
export RUSTC_BOOTSTRAP=1
. "$out/env.sh"
exec "$(command -v cargo)" "\$@"
EOF
chmod +x "$out/bin/cargo"
# The hook caches its build, which must be this instrumented one, and no
# later `dart test` may reuse it.
dart_build() {
    rm -rf rind-dart/.dart_tool/hooks_runner rind-dart/.dart_tool/lib
}
dart_build
trap dart_build EXIT
(cd rind-dart && dart pub get && PATH="$out/bin:$PATH" dart test)
install -m 755 rind-dart/.dart_tool/lib/librind_dart.* "$objects/"

sh/python.sh test
install -m 755 "$target"/pyrind/site/pyrind/_rind.*.so "$objects/"

cargo llvm-cov report $OPTIONS "$@"

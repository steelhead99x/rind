extract_kdf aarch64 Aarch64

# The portable backend's Keccak-f, in a third translation: the backend builds
# only under the cfg CI's portable jobs build with, here on x86_64.
(cd rind && RUSTFLAGS='--cfg rind_portable --cfg curve25519_dalek_backend="serial"' \
    charon cargo --preset=aeneas \
    --start-from crate::low::portable::keccak::sha3_keccak4_f1600 \
    --start-from crate::low::portable::keccak::sha3_keccak_nof4_f1600 \
    --dest-file "$PWD/../$out/portable.llbc" \
    -- -p rind --lib --target x86_64-unknown-linux-gnu)
rm -rf "$out/lean"
aeneas -backend lean -split-files -abort-on-error \
    -no-progress-bar -dest "$out/lean" -subdir Rind/Portable \
    -namespace rind.portable "$out/portable.llbc"
mkdir -p proofs/Rind/Portable
cp "$out/lean/Rind/Portable/Types.lean" "$out/lean/Rind/Portable/Funs.lean" proofs/Rind/Portable/

mkdir -p proofs/Rind/Aarch64/Kdf
for file in Dispatch P256Dispatch P256Agree X25519 P384 DigestAlgorithm DigestDispatch Sha512 ChaCha20 SignatureDispatch Ed25519 \
    Blockwise Sha Hmac HmacDispatch HkdfExpand Kdf/TypesExternal Kdf/FunsExternal \
    CtEqual HmacApi DigestApi Hkdf Pbkdf2 Sha3 AesCipher HkdfAes; do
    sed 's/X86_64/Aarch64/g; s/x86_64/aarch64/g' "proofs/Rind/X86_64/$file.lean" >"proofs/Rind/Aarch64/$file.lean"
done
# The AEAD model imports nothing aarch64 has, and no aarch64 translation reaches it.
sed -i '/Rind.Aarch64.AeadDispatch/d' proofs/Rind/Aarch64/Kdf/TypesExternal.lean
sed -i '/-- BEGIN aead/,/-- END aead/d' proofs/Rind/Aarch64/Kdf/FunsExternal.lean

[ "${PROVE_TRANSLATE_ONLY:-}" ] && exit 0
# Each hand model of a CPU intrinsic, a `core.core_arch` definition but its
# vector types' own, is tested against the instruction: `admin/simd-vectors.rs`
# runs each x86_64 one on this CPU and writes `#guard`s that the models compute
# the same, which Lean checks once the proofs build, and
# `proofs/Rind/Aarch64/NeonVectors.lean` holds what `admin/neon-vectors.rs`
# printed on an aarch64 CPU, which the `prove` workflow's `neon` job checks is
# still what it prints. Fail on a model neither tests, so a new one cannot go
# untested.
rustc --edition 2024 -O -o "$out/simd-vectors" admin/simd-vectors.rs
"$out/simd-vectors" >"$out/SimdVectors.lean"
untested=$(grep -rhoE '^def core\.core_arch\.[^ ]+' proofs/Rind | sed 's/^def //' | grep -vE '\.__m|_t\.Insts\.' | sort -u |
    while read -r model; do
        grep -qF " $model " "$out/SimdVectors.lean" proofs/Rind/Aarch64/NeonVectors.lean || echo "$model"
    done)
if [[ -n $untested ]]; then
    echo "admin/prove: no vectors test these intrinsic models:" $untested >&2
    exit 1
fi

cd proofs
lake exe cache get
lake build
lake env lean "../$out/SimdVectors.lean"

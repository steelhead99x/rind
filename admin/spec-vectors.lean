import Rind.HashSpec
import Rind.Sha2
import Rind.Sha3
open rind.spec

/-!
Generated by `admin/spec-vectors.rs` from `admin/spec-vectors.lean`: each line
of `cases` is a spec to run, its inputs, and the answer it must give, either a
published vector's or rind's output on a random input. A spec that disagrees
fails the build, naming the case.
-/

/-- The bytes `s` spells in hex. -/
def unhex (s : String) : List Byte :=
  let d (c : Char) : Nat := if c.isDigit then c.toNat - '0'.toNat else c.toNat - 'a'.toNat + 10
  let rec go : List Char → List Byte
    | a :: b :: rest => BitVec.ofNat 8 (16 * d a + d b) :: go rest
    | _ => []
  go s.toList

/-- A hash over `U8`, as `Rind.Sha2` has them, over bytes. -/
def viaU8 (f : List Aeneas.Std.U8 → List Aeneas.Std.U8) (m : List Byte) : List Byte :=
  (f (m.map fun b => ⟨b⟩)).map (·.bv)

/-- Runs the spec `alg` names on inputs `a`, `b`, `c`, and numbers `n`, `m`. -/
def run (alg : String) (a b c : List Byte) (n m : Nat) : Option (List Byte) :=
  let sha384 := viaU8 sha384
  let sha512 := viaU8 sha512
  let mac (H : List Byte → List Byte) (B : Nat) := hmac H B
  let hkdf (H : List Byte → List Byte) (B hashLen : Nat) :=
    hkdfExpand (mac H B) hashLen (hkdfExtract (mac H B) b a) c n
  let pbkdf (H : List Byte → List Byte) (B hashLen : Nat) :=
    pbkdf2 (mac H B) hashLen a b n m
  match alg with
  | "sha1" => some (sha1.hash a)
  | "sha256" => some (sha256.hash a)
  | "sha384" => some (sha384 a)
  | "sha512" => some (sha512 a)
  | "sha512_256" => some (viaU8 sha512_256 a)
  | "sha3_256" => some (sha3_256 a)
  | "sha3_384" => some (sha3_384 a)
  | "sha3_512" => some (sha3_512 a)
  | "hmac_sha1" => some (mac sha1.hash 64 a b)
  | "hmac_sha256" => some (mac sha256.hash 64 a b)
  | "hmac_sha384" => some (mac sha384 128 a b)
  | "hmac_sha512" => some (mac sha512 128 a b)
  | "hkdf_sha1" => some (hkdf sha1.hash 64 20)
  | "hkdf_sha256" => some (hkdf sha256.hash 64 32)
  | "hkdf_sha384" => some (hkdf sha384 128 48)
  | "hkdf_sha512" => some (hkdf sha512 128 64)
  | "pbkdf2_sha1" => some (pbkdf sha1.hash 64 20)
  | "pbkdf2_sha256" => some (pbkdf sha256.hash 64 32)
  | "pbkdf2_sha384" => some (pbkdf sha384 128 48)
  | "pbkdf2_sha512" => some (pbkdf sha512 128 64)
  | _ => none

/-- Why a line of `cases` fails, if it does. -/
def check (line : String) : Option String :=
  match line.splitOn "|" with
  | [alg, label, a, b, c, n, m, answer] =>
    let expected := unhex answer
    match run alg (unhex a) (unhex b) (unhex c) n.toNat! m.toNat! with
    | none => some s!"{label}: no spec for {alg}"
    -- CAVP's HMAC answers are truncated to the tag length they name.
    | some got =>
      if expected.length > 0 && got.take expected.length == expected && (alg.startsWith "hmac" || got.length == expected.length)
      then none else some s!"{label}: spec disagrees"
  | _ => some s!"malformed case {line}"

def cases : String := "@DATA@"

#eval show IO Unit from do
  let lines := (cases.splitOn "\n").filter (· ≠ "")
  if lines.length ≠ @COUNT@ then throw <| IO.userError "spec-vectors: lost cases"
  let bad := lines.filterMap check
  unless bad.isEmpty do
    throw <| IO.userError s!"spec-vectors: {bad.length} of {lines.length} cases disagree:\n{"\n".intercalate (bad.take 20)}"

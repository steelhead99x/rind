    def test_reports_md5_and_sha1(self):
        # rind-bench times these on every device; a report that drops them
        # hides rows that ran (the Fire TV run lost them this way).
        regex = re.compile(br.operation_regex())
        for hash_name, label in [("sha1", "SHA-1"), ("md5", "MD5")]:
            for size, size_label in [("64B", "64 B"), ("1350B", "1350 B"), ("16KB", "16 KB")]:
                row = f"{hash_name}/rind/{size}"
                self.assertTrue(regex.match(row), row)
                self.assertTrue(regex.match(f"{hash_name}/rustcrypto/{size}"), row)
                self.assertEqual(br.operation_of(row), (f"{hash_name}/{{lib}}/{size}", "rind"))
                self.assertEqual(br.label(f"{hash_name}/{size}"), f"{label}, {size_label}")
        # Only the sizes the report names.
        self.assertFalse(regex.match("sha1/rind/32B"))
        self.assertFalse(regex.match("md5/rind"))
        algorithms = {}
        for op in br.OPERATIONS:
            name = br.row_name(op)
            if name.startswith(("sha1/", "md5/")):
                matches = [a for a, pattern in br.ALGORITHMS if re.match(pattern, name + "/")]
                self.assertEqual(len(matches), 1, name)
                algorithms[name] = matches[0]
        self.assertEqual(algorithms["sha1/64B"], "SHA-1")
        self.assertEqual(algorithms["md5/16KB"], "MD5")

    def test_site_data_grid_marks_each_cell(self):
        h = hosts()
        h["nixos2"]["refused"] = {"openssl": ["adx"]}
        data = br.site_data(h, None, VERIFIED, [])
        self.assertEqual([x["name"] for x in data["hosts"]], ["nixos", "nixos2", "kixtop"])
        self.assertEqual([x["os_kind"] for x in data["hosts"]], ["linux", "linux", "macos"])
        grid = {x["name"]: x["grid"] for x in data["hosts"]}
        self.assertEqual(set(grid["nixos"]), {br.row_name(op) for op in br.OPERATIONS})
        self.assertEqual(set(grid["nixos"]["x25519-ecdh"]), {"rind", "aws-lc-rs", "ring", "openssl"})
        cells = lambda row, lib: [grid[n][row][lib] for n in ["nixos", "nixos2", "kixtop"]]
        # Both x86_64 hosts have ADX, nixos2 without timing it; kixtop's
        # proof holds only on Linux.
        self.assertEqual(cells("x25519-ecdh", "rind"), [0, 0, {"other_os": 3}])
        # A proof shows where the host timed nothing, since it covers the code.
        self.assertEqual(cells("x25519-ecdh", "ring"), [2, 2, 2])
        self.assertEqual(cells("x25519-ecdh", "openssl"), ["unproven", "refused", "untimed"])
        self.assertEqual(data["verified"][3]["os"], "linux")
        self.assertEqual(data["verified"][3]["platform"], "aarch64 on Linux")
        self.assertEqual(data["rule"], br.VERIFIED_RULE)


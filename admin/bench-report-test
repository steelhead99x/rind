class CpuSlug(unittest.TestCase):
    def test_slug_normalizes_brand_strings(self):
        cases = {
            "Intel(R) Core(TM) Ultra 9 275HX": "intel-core-ultra-9-275hx",
            "AMD Ryzen 9 7950X 16-Core Processor": "amd-ryzen-9-7950x",
            "Apple M3 Max": "apple-m3-max",
            "Intel(R) Core(TM) i7-8700 CPU @ 3.20GHz": "intel-core-i7-8700",
            "AMD Ryzen 9 5900XT 16-Core Processor": "amd-ryzen-9-5900xt",
            "Apple M4": "apple-m4",
            "Intel Core Processor (Haswell, no TSX)": "intel-core-haswell-no-tsx",
            "Intel(R) Core(TM) Ultra 7 270K Plus": "intel-core-ultra-7-270k-plus",
            "Intel® Core™ i9-13900K": "intel-core-i9-13900k",
            "CPU": "unknown",
        }
        for raw, slug in cases.items():
            with self.subTest(raw=raw):
                self.assertEqual(br.cpu_slug(raw), slug)
                br.check_host_name(slug)

    def test_slug_stays_a_short_filename(self):
        slug = br.cpu_slug("word " * 40)
        self.assertLessEqual(len(slug), 80)
        self.assertFalse(slug.endswith("-"))
        br.check_host_name(slug)

    def test_reads_linux_cpuinfo_and_lscpu(self):
        cpuinfo = "processor\t: 0\nmodel\t\t: 143\nmodel name\t: AMD Ryzen 9 7950X 16-Core Processor\n"
        self.assertEqual(br.cpu_model_from_cpuinfo(cpuinfo), "AMD Ryzen 9 7950X 16-Core Processor")
        self.assertEqual(br.cpu_model_from_cpuinfo("Model\t\t: Raspberry Pi 4 Model B\n"), "Raspberry Pi 4 Model B")
        self.assertEqual(br.cpu_model_from_cpuinfo("processor : 0\n"), "")
        lscpu = "CPU(s): 16\nModel name:                         Intel(R) Core(TM) Ultra 9 275HX\n"
        self.assertEqual(br.cpu_model_from_lscpu(lscpu), "Intel(R) Core(TM) Ultra 9 275HX")
        self.assertEqual(br.cpu_model_from_lscpu("BIOS Model name: ignored\n"), "")

    def test_counts_physical_cores(self):
        blocks = []
        for phys in (0, 1):
            for core in (0, 1):
                blocks.append(f"physical id\t: {phys}\ncore id\t\t: {core}\nprocessor\t: x\n")
        self.assertEqual(br.physical_from_cpuinfo("\n".join(blocks)), 4)
        self.assertIsNone(br.physical_from_cpuinfo("processor : 0\n"))
        lscpu = "Thread(s) per core: 2\nCore(s) per socket: 8\nSocket(s): 2\n"
        self.assertEqual(br.physical_from_lscpu(lscpu), 16)
        self.assertIsNone(br.physical_from_lscpu("CPU(s): 4\n"))

    def test_this_machine_describes_itself(self):
        meta = br.cpu_metadata()
        self.assertTrue(meta["model"])
        self.assertEqual(meta["slug"], br.cpu_slug(meta["model"]))
        br.check_host_name(meta["slug"])
        self.assertGreaterEqual(meta["logical_cpus"], 1)
        self.assertIn("arch", meta)
        if "physical_cpus" in meta:
            self.assertGreaterEqual(meta["physical_cpus"], 1)


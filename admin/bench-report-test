                mine["machine"] = tag
                mine["alias_of"] = "box"
                mine["started"] = "2026-11-04T02:00:00+00:00"
                extra = laptop("box-3")
                extra["machine"] = tag
                extra["alias_of"] = "box"
                extra["started"] = "2026-11-02T02:00:00+00:00"
                for name, body in (("box", occupant), ("box-2", historical), (alias, mine), ("box-3", extra)):
                    with open(os.path.join(data, f"{name}.json"), "w") as f:
                        json.dump(body, f)
                newer = laptop("box")
                newer["machine"] = tag
                newer["started"] = "2026-11-06T02:00:00+00:00"
                with open(os.path.join(src, "box.json"), "w") as f:

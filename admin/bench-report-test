    def test_tagged_reimport_keeps_another_machines_untagged_alias(self):
        """Refreshing a tagged alias leaves an untagged alias of that slug in place.

        An untagged alias can be another machine, so it matches no result. A
        second alias that already carries this result's tag is still one
        host, so that copy is removed.

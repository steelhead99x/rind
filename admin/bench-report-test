class AnyHost(unittest.TestCase):
    def test_summary_render_and_import_take_a_host_outside_collect_hosts(self):
        self.assertNotIn(ALIEN, br.COLLECT_HOSTS)
        self.assertNotIn(RYZEN, br.COLLECT_HOSTS)
        everyone = hosts()
        # Caller order of hosts outside COLLECT_HOSTS is kept, which is not
        # alphabetical: intel-... before amd-...
        everyone[ALIEN] = laptop(ALIEN)
        everyone[RYZEN] = laptop(RYZEN)
        svg = br.overview_svg(everyone, VERIFIED, "light")
        self.assertIn(f"left to right: nixos, nixos2, kixtop, {ALIEN}, {RYZEN}.", svg)
        md = br.report(everyone, None, VERIFIED, [])[br.REPORT]
        self.assertIn("on five machines", md)
        self.assertIn(f"### `{ALIEN}`: {ALIEN} CPU", md)
        self.assertIn(f"### `{RYZEN}`:", md)
        self.assertNotIn("Not measured yet", md)

        with tempfile.TemporaryDirectory() as src, tempfile.TemporaryDirectory() as dst:
            for name, body in ((ALIEN, laptop(ALIEN)), (RYZEN, laptop(RYZEN))):
                with open(os.path.join(src, f"{name}.json"), "w") as f:
                    json.dump(body, f)
            with open(os.path.join(src, "nixos.json"), "w") as f:
                json.dump({"schema": 1, "host": "nixos", "status": "busy", "reason": "busy"}, f)
            with open(os.path.join(src, "tiers.json"), "w") as f:
                json.dump({"tiers": []}, f)
            loaded = br.load_hosts(src)
            self.assertEqual(list(loaded), ["nixos", RYZEN, ALIEN])
            with io.StringIO() as out, contextlib.redirect_stdout(out):
                br.summary(type("Args", (), {"dir": src})())
                text = out.getvalue()
            self.assertIn(f"`{ALIEN}`: {ALIEN} CPU", text)
            self.assertIn(f"`{RYZEN}`", text)
            self.assertIn("nixos`: not measured, busy: busy", text)
            self.assertNotIn("tiers", text)
            self.assertIn(f"{ALIEN} |", text)
            saved = br.DATA_DIR
            br.DATA_DIR = dst
            try:
                with contextlib.redirect_stderr(io.StringIO()):
                    br.import_hosts(src)
            finally:
                br.DATA_DIR = saved
            self.assertEqual(sorted(os.listdir(dst)), [f"{RYZEN}.json", f"{ALIEN}.json"])

    def test_published_data_still_loads_in_report_order(self):
        self.assertEqual(
            list(br.load_hosts(br.DATA_DIR)),
            ["nixos", "desktop", "nixos2", "kixtop", "ovh-iad", "ovh-sea"],
        )

    def test_run_accepts_any_host_and_collect_keeps_its_list(self):
        script = os.path.join(HERE, "bench-report")
        for args in (["run"], ["run", "--host", ALIEN]):
            proc = subprocess.run([sys.executable, script, *args], capture_output=True, text=True)
            with self.subTest(args=args):
                self.assertNotEqual(proc.returncode, 0)
                self.assertNotIn("unknown host", proc.stderr)
                self.assertNotIn("unknown collect host", proc.stderr)
                self.assertIn("--commit", proc.stderr)
        collect = subprocess.run(

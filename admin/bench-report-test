        )
        self.assertNotEqual(collect.returncode, 0)
        self.assertIn(f"unknown collect host {ALIEN}", collect.stderr)
        self.assertIn("nixos", collect.stderr)
        self.assertIn("`admin/bench-report run`", collect.stderr)


class AnyHostGaps(unittest.TestCase):
    def setUp(self):
        self.hosts = hosts()
        self.hosts["nixos"]["results"][1]["ns"] = 20000.0
        self.hosts[ALIEN] = laptop(ALIEN)
        self.tiers = {**TIERS, "tiers": [dict(t) for t in TIERS["tiers"]]}
        self.tiers["tiers"][0]["benchmarks"] = {"sha256/*/64B": {"rind": 100.0, "ring": 80.0}}

    def load(self, *entries):
        with tempfile.NamedTemporaryFile("w", suffix=".toml", delete=False) as f:
            f.write("".join("[[gap]]\n" + "".join(f"{k} = {v}\n" for k, v in e.items()) for e in entries))
        try:
            return br.load_gaps(self.hosts, self.tiers, f.name)
        finally:
            os.unlink(f.name)

    def test_a_measured_host_outside_collect_hosts_can_decide_a_gap(self):
        gaps = self.load(
            {"operations": '["x25519-ecdh"]', "on": '["nixos"]', "quest": '"/quest/m3/README.md"'},
            {"operations": '["sha256/*/64B"]', "on": '["x86_64"]', "reason": '"r"'},
            {"operations": '["x25519-ecdh"]', "on": f'["{ALIEN}"]', "reason": '"laptop"'},
        )
        table = "\n".join(br.gap_table(gaps))
        self.assertIn(f"| X25519 | `{ALIEN}` | 1.50× (ring) | laptop |", table)
        self.assertIn("| `sha256/*/64B` | x86_64 tier | 1.25× (ring) | r |", table)

    def test_refuses_a_host_that_has_no_result(self):
        with self.assertRaises(SystemExit):
            self.load(
                {"operations": '["x25519-ecdh"]', "on": '["nixos"]', "quest": '"/quest/m3/README.md"'},
                {"operations": '["sha256/*/64B"]', "on": '["x86_64"]', "reason": '"r"'},
                {"operations": '["x25519-ecdh"]', "on": f'["{RYZEN}"]', "reason": '"r"'},
            )



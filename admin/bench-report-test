    def test_slug_file_and_marked_alias_stay_one_host(self):
        tag = "bbbbbbbb"
        alias = f"box-{tag}"
        saved = br.DATA_DIR
        try:
            with tempfile.TemporaryDirectory() as src, tempfile.TemporaryDirectory() as data:
                br.DATA_DIR = data

                def put(files):
                    for old in os.listdir(src):
                        os.remove(os.path.join(src, old))
                    for name, body in files:
                        with open(os.path.join(src, f"{name}.json"), "w") as f:
                            json.dump(body, f)
                    with contextlib.redirect_stderr(io.StringIO()) as err:
                        br.import_hosts(src)
                    return err.getvalue()

                slug = laptop("box")
                slug["machine"] = tag
                slug["started"] = "2026-11-03T02:00:00+00:00"
                put([("box", slug)])
                marked = laptop(alias)
                marked["machine"] = tag
                marked["alias_of"] = "box"
                marked["started"] = "2026-11-04T02:00:00+00:00"
                log = put([(alias, marked)])
                self.assertIn(f"{alias}: same machine as box, refreshed box", log)
                self.assertEqual(os.listdir(data), ["box.json"])
                with open(os.path.join(data, "box.json")) as f:
                    body = json.load(f)
                self.assertEqual(body["started"], "2026-11-04T02:00:00+00:00")
                self.assertNotIn("alias_of", body)
                # A later slug import must not leave the old file beside a refreshed alias.
                marked["started"] = "2026-11-04T02:00:00+00:00"
                with open(os.path.join(data, f"{alias}.json"), "w") as f:
                    json.dump(marked, f)
                later = laptop("box")
                later["machine"] = tag
                later["started"] = "2026-11-06T02:00:00+00:00"
                log = put([("box", later)])
                self.assertNotIn("another machine", log)
                self.assertIn(f"{alias}: same machine as box, dropped", log)
                self.assertEqual(os.listdir(data), ["box.json"])
                with open(os.path.join(data, "box.json")) as f:
                    self.assertEqual(json.load(f)["started"], "2026-11-06T02:00:00+00:00")
                both = laptop(alias)
                both["machine"] = tag
                both["alias_of"] = "box"
                both["started"] = "2026-11-05T02:00:00+00:00"
                newest = laptop("box")
                newest["machine"] = tag
                newest["started"] = "2026-11-07T02:00:00+00:00"
                log = put([("box", newest), (alias, both)])
                self.assertNotIn("another machine", log)
                self.assertIn(f"{alias}: same machine as box, not a second host", log)
                self.assertEqual(os.listdir(data), ["box.json"])
                with open(os.path.join(data, "box.json")) as f:
                    self.assertEqual(json.load(f)["started"], "2026-11-07T02:00:00+00:00")
        finally:
            br.DATA_DIR = saved


    def test_machine_tag_comes_from_the_os_id(self):
        # machine-id(5): a published id is HMAC-SHA256 under this report's key,
        # not an unkeyed hash of the OS id. Empty input is not a tag.
        self.assertEqual(br._MACHINE_TAG_KEY, b"rind-bench-report-host")
        self.assertEqual(br.usable_machine_id("uninitialized\n"), "")
        self.assertEqual(br.usable_machine_id(""), "")
        self.assertEqual(br.usable_machine_id("abc"), "abc")
        self.assertEqual(br.machine_tag_for(""), "")
        keyed = hmac.new(br._MACHINE_TAG_KEY, b"abc", hashlib.sha256).hexdigest()[:8]
        self.assertEqual(br.machine_tag_for("abc"), keyed)
        self.assertNotEqual(keyed, hashlib.sha256(b"abc").hexdigest()[:8])
        self.assertEqual(br.machine_tag_for("abc"), br.machine_tag_for("abc"))
        self.assertRegex(br.machine_tag_for("abc"), r"^[0-9a-f]{8}$")
        self.assertNotEqual(br.machine_tag_for("abc"), br.machine_tag_for("abd"))
        self.assertEqual(br.machine_tag(), br.machine_tag_for(br.machine_identity()))
        self.assertEqual(br.machine_tag_of({"machine": "abcdef12"}), "abcdef12")
        self.assertEqual(br.machine_tag_of({"machine": "ABCDEF12"}), "")
        self.assertEqual(br.machine_tag_of({"machine": "not-a-tag"}), "")
        self.assertEqual(br.machine_tag_of({}), "")
        text = br.report(hosts(), None, VERIFIED, [])[br.REPORT]
        self.assertIn("of HMAC-SHA256 over the OS machine id, under a fixed application key", text)

    def test_uninitialized_machine_id_is_not_a_tag(self):
        # machine-id(5): empty, all zeros, and `uninitialized` are not ids.
        # Hashing the sentinel gives every such image the same tag.
        sentinel = hmac.new(br._MACHINE_TAG_KEY, b"uninitialized", hashlib.sha256).hexdigest()[:8]
        self.assertEqual(sentinel, "31957766")
        absent = (
            "uninitialized",
            "UNINITIALIZED",
            " uninitialized\n",
            "",
            "   ",
            "0" * 32,
            "00000000-0000-0000-0000-000000000000",
        )
        for ident in absent:
            with self.subTest(ident=ident):
                self.assertEqual(br.machine_tag_for(ident), "")
                self.assertEqual(br.machine_id_text(ident), "")
        self.assertNotEqual(br.machine_tag_for("uninitialized"), sentinel)
        keyed = hmac.new(br._MACHINE_TAG_KEY, b"abc", hashlib.sha256).hexdigest()[:8]
        self.assertEqual(br.machine_tag_for("abc"), keyed)
        self.assertEqual(br.machine_id_text("abc"), "")
        self.assertEqual(br.machine_id_text("not-a-machine-id"), "")
        valid = "a" * 32
        uuid = "01234567-89ab-cdef-0123-456789abcdef"
        self.assertEqual(br.machine_id_text(valid), valid)
        self.assertEqual(br.machine_id_text(uuid), uuid)
        zeros = "0" * 32
        with tempfile.TemporaryDirectory() as directory:
            first = os.path.join(directory, "machine-id")
            second = os.path.join(directory, "dbus")
            with open(first, "w") as f:
                f.write("uninitialized\n")
            with open(second, "w") as f:
                f.write(valid + "\n")
            self.assertEqual(br.read_machine_id((first, second)), valid)
            with open(second, "w") as f:
                f.write("uninitialized\n")
            self.assertEqual(br.read_machine_id((first, second)), "")
            with open(first, "w") as f:
                f.write(zeros + "\n")
            with open(second, "w") as f:
                f.write("not-a-machine-id\n")
            self.assertEqual(br.read_machine_id((first, second)), "")
            with open(first, "w") as f:
                f.write(valid + "\n")
            self.assertEqual(br.read_machine_id((first, second)), valid)
        text = br.report(hosts(), None, VERIFIED, [])[br.REPORT]
        self.assertIn("or uninitialized id is not a tag.", text)



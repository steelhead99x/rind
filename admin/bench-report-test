    def test_a_host_file_missing_what_the_report_reads_is_skipped(self):
        """The published results pass; each field the report reads, removed or broken, skips the file."""
        real = {}
        for path in sorted(glob.glob(os.path.join(br.DATA_DIR, "*.json"))):
            name = os.path.splitext(os.path.basename(path))[0]
            if name != "tiers":
                with open(path) as f:
                    real[name] = json.load(f)
        self.assertTrue(real)
        for name, body in real.items():
            self.assertEqual(br.unmeasured(body), "", name)
        base = dict(next(iter(real.values())))
        for key in ("machine", "alias_of"):
            base.pop(key, None)
        bad = {}
        for field in ("commit", "started", "os", "cpu", "cpu.model", "cpu.arch", "cpu.logical_cpus", "toolchain", "toolchain.rustc"):
            for how, value in (("missing", None), ("wrong", 7 if field != "cpu.logical_cpus" else "8")):
                body = json.loads(json.dumps(base))
                parent, _, key = field.rpartition(".")
                holder = body[parent] if parent else body
                if value is None:
                    del holder[key]
                else:
                    holder[key] = value
                bad[f"{how}-{field.replace('.', '-')}"] = body
        for label, ns in (("0", 0), ("neg", -1), ("true", True), ("nan", float("nan")), ("inf", float("inf")), ("str", "1"), ("huge", 10**400)):
            body = json.loads(json.dumps(base))
            body["results"][0]["ns"] = ns
            bad[f"ns-{label}"] = body
        for key in br.OPTIONAL_HOST_OBJECTS:
            body = json.loads(json.dumps(base))
            body[key] = "x"
            bad[f"wrong-{key.replace('_', '-')}"] = body
        body = json.loads(json.dumps(base))
        body["refused"] = {"no-such-library": ["adx"]}
        bad["refused-unknown-library"] = body
        body = json.loads(json.dumps(base))
        body["refused"] = {"rind": "adx"}
        bad["refused-not-a-list"] = body
        if isinstance(base.get("build_cost"), dict) and base["build_cost"].get("status") == "ok":
            for label, edit in (
                ("no-builds", lambda c: c.pop("builds")),
                ("no-host", lambda c: c.pop("host")),
                ("build-no-seconds", lambda c: c["builds"][0].pop("seconds")),
                ("build-bad-tools", lambda c: c["builds"][0].__setitem__("tools", "none")),
                ("build-bool-bytes", lambda c: c["builds"][0].__setitem__("stripped_bytes", True)),
            ):
                body = json.loads(json.dumps(base))
                edit(body["build_cost"])
                bad[f"build-cost-{label}"] = body
        body = json.loads(json.dumps(base))
        body["build_cost"] = {"status": "skipped"}
        bad["build-cost-no-reason"] = body
        saved = br.DATA_DIR
        try:
            with tempfile.TemporaryDirectory() as src, tempfile.TemporaryDirectory() as data:
                br.DATA_DIR = data
                for d in (src, data):
                    for name, body in {"good": base, **bad}.items():
                        with open(os.path.join(d, f"{name}.json"), "w") as f:
                            json.dump(dict(body, host=name), f)
                with contextlib.redirect_stderr(io.StringIO()) as err:
                    self.assertEqual(list(br.load_measured(data)), ["good"])
                for name in bad:
                    self.assertRegex(err.getvalue(), rf"bench-report: {name}: .*, skipped\n")
                with contextlib.redirect_stdout(io.StringIO()) as out, contextlib.redirect_stderr(io.StringIO()) as err:
                    br.summary(type("Args", (), {"dir": src})())
                for name in bad:
                    self.assertRegex(err.getvalue(), rf"bench-report: {name}: .*, skipped\n")
                    self.assertNotIn(f"`{name}`", out.getvalue())
                self.assertIn("`good`", out.getvalue())
                with tempfile.TemporaryDirectory() as empty:
                    br.DATA_DIR = empty
                    with contextlib.redirect_stderr(io.StringIO()) as err:
                        br.import_hosts(src)
                    self.assertEqual(os.listdir(empty), ["good.json"])
                    for name in bad:
                        self.assertIn(f"bench-report: {name}: not imported, ", err.getvalue())
        finally:
            br.DATA_DIR = saved


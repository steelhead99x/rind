#!/usr/bin/env python3
"""Regenerates mlkem-native's code under rind/src/low/aarch64/mlkem_native.

Usage: admin/import-mlkem-native <mlkem-native checkout at REV>

mlkem-native's aarch64 polynomial compression, which its HOL Light proofs
cover, are not yet in the aws-lc or s2n-bignum revisions
rind imports, so this takes them from mlkem-native itself.

Each routine is a hand-simplified assembly file that takes its constants as
an argument, so one text serves ELF and Mach-O: this keeps its body, which
uses no macro, from `.cfi_startproc` through `.cfi_endproc` for `naked_asm!`
in a naked function, and doubles its braces. Each table, a C
array of bytes, becomes a Rust array literal for `include!`. Undoing those
edits gives mlkem-native's text line for line.
"""

import os
import re
import subprocess
import sys

REV = "58721ebde4b682bb3384ef7d11333e4f0ddb0164"

SOURCE = "mlkem/src/native/aarch64/src"
OUT = os.path.join(os.path.dirname(__file__), "..", "rind", "src", "low", "aarch64", "mlkem_native")

# Its decompression too measured within 10 ns a polynomial of rind's proven
# Rust on Apple's M5, so rind keeps the Rust.
ROUTINES = [f"poly_compress_{d}_aarch64_asm" for d in ["d4", "d5", "d10", "d11"]]
TABLES = ["compress_d5"]

NOTICE = [
    "Copyright (c) The mlkem-native project authors",
    "SPDX-License-Identifier: Apache-2.0 OR ISC OR MIT",
]


def header(comment, source):
    return [f"{comment} {line}" for line in NOTICE] + [
        comment,
        f"{comment} Generated by admin/import-mlkem-native from mlkem-native {REV}:",
        f"{comment} {source}.",
        f"{comment} Do not edit by hand.",
    ]


def write(path, lines):
    # Renamed into place, so a failure partway leaves the committed file whole.
    tmp = path + ".tmp"
    with open(tmp, "w") as f:
        f.write("\n".join(lines) + "\n")
    os.replace(tmp, path)


def routine(checkout, name):
    source = f"{SOURCE}/mlkem_{name}.S"
    with open(os.path.join(checkout, source)) as f:
        lines = f.read().splitlines()
    starts = [i for i, line in enumerate(lines) if line.split() == [".cfi_startproc"]]
    ends = [i for i, line in enumerate(lines) if line.split() == [".cfi_endproc"]]
    if len(starts) != 1 or len(ends) != 1 or lines[starts[0] - 2].strip() != f"MLK_ASM_FN_SYMBOL({name})":
        sys.exit(f"{source}: expected one routine, {name}")
    body = [line.replace("{", "{{").replace("}", "}}") for line in lines[starts[0] : ends[0] + 1]]
    write(os.path.join(OUT, f"mlkem_{name}.s"), header("//", source) + [""] + body)


def table(checkout, name):
    source = f"{SOURCE}/{name}_table.c"
    with open(os.path.join(checkout, source)) as f:
        text = f.read()
    m = re.search(rf"mlk_aarch64_{name}_table\[(\d+)\] = \{{(.*?)\}};", text, re.S)
    if not m:
        sys.exit(f"{source}: expected mlk_aarch64_{name}_table")
    values = re.findall(r"0x[0-9a-f]{2}", re.sub(r"/\*.*?\*/", "", m[2], flags=re.S))
    if len(values) != int(m[1]):
        sys.exit(f"{source}: expected {m[1]} bytes, found {len(values)}")
    rows = [f"    {', '.join(values[i : i + 16])}," for i in range(0, len(values), 16)]
    write(os.path.join(OUT, f"{name}_table.rs"), header("//", source) + ["["] + rows + ["]"])


def main():
    if len(sys.argv) != 2:
        sys.exit(__doc__)
    checkout = sys.argv[1]
    rev = subprocess.run(
        ["git", "-C", checkout, "rev-parse", "HEAD"], capture_output=True, text=True, check=True
    ).stdout.strip()
    if rev != REV:
        sys.exit(f"mlkem-native is at {rev}, expected {REV}")
    os.makedirs(OUT, exist_ok=True)
    for name in ROUTINES:
        routine(checkout, name)
    for name in TABLES:
        table(checkout, name)


if __name__ == "__main__":
    main()

def matrix(which):
    """The x86-cpu.yml matrix for `pr` or `all`, one entry per SDE model."""
    flags = {flag for flag, _ in KNOWN_CPUS}
    keys = {tuple(m["paths"]) for m in MODELS}
    assert len(keys) == 1, "every model sets the same paths"
    assert len({m["sde"] for m in MODELS}) == len(MODELS), "a model is listed twice"
    for m in MODELS:
        assert "-" + m["sde"] in flags, m["sde"] + " is not an SDE CPU"
    return [
        dict(model=m["model"], sde=m["sde"], paths=m["paths"])
        for m in MODELS
        if which == "all" or m["pr"]
    ]


mode = sys.argv[1]

if mode == "sde-scan":
    output = []
    env = os.environ.copy()

    for i, (flag, name) in enumerate(KNOWN_CPUS):
        env["CARGO_TARGET_X86_64_UNKNOWN_LINUX_GNU_RUNNER"] = "sde {} --".format(flag)
        out = subprocess.check_output(
            ["cargo", "run", "--bin", "rind-cpuid"], env=env, encoding="utf-8"
        )
        js = json.loads(out)
        json.dump(
            dict(name="Intel " + name, source="Intel SDE " + flag, result=js),
            open("admin/x86-cpus/intel-{:02d}{}.json".format(i + 1, flag), "w"),
        )
elif mode == "matrix":
    # A job's matrix, `pr` or `all`: `admin/x86-cpu matrix pr`.
    json.dump(matrix(sys.argv[2]), sys.stdout, separators=(",", ":"))
    print()
elif mode == "markdown-table":
    data = []
    for f in sorted(glob.glob("admin/x86-cpus/*.json")):
        js = json.load(open(f))
        data.append(js)

    print("# x86-64 CPU compatibility")
    print()
    print(
        "This tracks the features of Intel CPU families since 2004, and which run AVX-512 AES-GCM.  These are automatically characterised by the Intel SDE tool."
    )
    print("There are also a selection AMD CPUs that are characterised manually.")
    print()
    print("<!-- Generated by `admin/x86-cpu markdown-table > COMPATIBILITY.md`. -->")
    print()
    print("| Name | AVX512-AES-GCM? | Details |")
    print("| --- | --- | --- |")

    def tick(b):
        return ":large_blue_circle:" if b else ":white_circle:"

    def detail(x):
        r = []
        for n, v in sorted(x.items()):
            if v:
                r.append(n)
            else:
                r.append(f"~~{n}~~")
        return ", ".join(r)

    for d in data:
        print(
            "| {} | {} | {} |".format(
                d["name"],
                tick(d["result"]["supports_avx512_aes_gcm"]),
                detail(d["result"]["cpuid"]),
            )
        )

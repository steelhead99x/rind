#!/usr/bin/env python3

import subprocess, json, os, sys, glob, tarfile

# Run it at the workspace root in `nix develop .#sde`, which has the Intel SDE
# build x86-cpu.yml runs.
#
# Usage:
#   admin/x86-cpu sde-scan
#   admin/x86-cpu markdown-table
#   admin/x86-cpu archive
#   admin/x86-cpu test SDE_MODEL [TEST_ARGS...]
#   admin/x86-cpu matrix pr|all|queue|slow
#   admin/x86-cpu queue-slow
#
# `archive` builds the release tests x86-cpu.yml runs into ARCHIVE, and `test`
# runs them under `sde SDE_MODEL --`, passing each binary TEST_ARGS, so every
# model's job runs one build. Not nextest: its process per test starts SDE,
# and re-instruments the code, for each of the workspace's tests, which made
# rind's library tests over three times slower under SDE than one process
# for the binary, as `cargo test` runs it.
ARCHIVE = "target/x86-cpu-tests.tar"
# Each test binary in ARCHIVE, a tab, and its package's directory, which
# `cargo test` runs it in and where it finds its vector files.

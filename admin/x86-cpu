def matrix(which):
    """The matrix for `pr`, `all`, `queue` (all but the slow models), or `slow`."""
    assert which in ("pr", "all", "queue", "slow"), which
    flags = {flag for flag, _ in KNOWN_CPUS}
    keys = {tuple(m["paths"]) for m in MODELS}
    assert len(keys) == 1, "every model sets the same paths"
    assert len({m["sde"] for m in MODELS}) == len(MODELS), "a model is listed twice"
    for m in MODELS:
        assert "-" + m["sde"] in flags, m["sde"] + " is not an SDE CPU"
    assert {m["sde"] for m in MODELS if m["pr"]} >= {"p4p", "skx", "dmr"}, "stage 2 needs p4p, skx, dmr"
    assert {m["sde"] for m in MODELS if m.get("slow")} == {"cnl", "gnr"}, "the slow set is listed"
    return [
        dict(model=m["model"], sde=m["sde"], paths=m["paths"])
        for m in MODELS
        if which == "all"
        or (which == "pr" and m["pr"])
        or (which == "queue" and not m.get("slow"))
        or (which == "slow" and m.get("slow"))
    ]


mode = sys.argv[1]

if mode == "sde-scan":
    output = []
    env = os.environ.copy()

    for i, (flag, name) in enumerate(KNOWN_CPUS):
        env["CARGO_TARGET_X86_64_UNKNOWN_LINUX_GNU_RUNNER"] = "sde {} --".format(flag)
        out = subprocess.check_output(
            ["cargo", "run", "--bin", "rind-cpuid"], env=env, encoding="utf-8"
        )
        js = json.loads(out)
        json.dump(
            dict(name="Intel " + name, source="Intel SDE " + flag, result=js),
            open("admin/x86-cpus/intel-{:02d}{}.json".format(i + 1, flag), "w"),
        )
elif mode == "matrix":
    # A job's matrix: `admin/x86-cpu matrix pr`.
    json.dump(matrix(sys.argv[2]), sys.stdout, separators=(",", ":"))
    print()
elif mode == "markdown-table":
    data = []
    for f in sorted(glob.glob("admin/x86-cpus/*.json")):
        js = json.load(open(f))
        data.append(js)

    print("# x86-64 CPU compatibility")
    print()
    print(
        "This tracks the features of Intel CPU families since 2004, and which run AVX-512 AES-GCM.  These are automatically characterised by the Intel SDE tool."
    )
    print("There are also a selection AMD CPUs that are characterised manually.")
    print()
    print("<!-- Generated by `admin/x86-cpu markdown-table > COMPATIBILITY.md`. -->")
    print()
    print("| Name | AVX512-AES-GCM? | Details |")
    print("| --- | --- | --- |")

    def tick(b):
        return ":large_blue_circle:" if b else ":white_circle:"

    def detail(x):
        r = []
        for n, v in sorted(x.items()):
            if v:
                r.append(n)
            else:
                r.append(f"~~{n}~~")
        return ", ".join(r)

    for d in data:
        print(
            "| {} | {} | {} |".format(
                d["name"],
                tick(d["result"]["supports_avx512_aes_gcm"]),
                detail(d["result"]["cpuid"]),
            )
        )
elif mode == "archive":
    # rind-fips is left out: its module refuses CPUs below its baseline, as
    # most of SDE's models are. `cargo test` also runs the doc tests, which
    # this leaves to the native runs: none asserts a CPU path, and each path
    # they reach, the unit tests check on every model.
    out = subprocess.run(
        ["cargo", "test", "--release", "--workspace", "--exclude", "rind-fips"]
        + ["--locked", "--no-run", "--message-format=json-render-diagnostics"],
        stdout=subprocess.PIPE,
        check=True,
        encoding="utf-8",
    ).stdout
    tests, libraries = [], []
    for line in out.splitlines():
        message = json.loads(line)
        if message["reason"] != "compiler-artifact":
            continue
        if message["profile"]["test"]:
            tests.append(
                (
                    os.path.relpath(message["executable"]),
                    os.path.relpath(os.path.dirname(message["manifest_path"])),
                )
            )
        # A workspace crate's shared library, which its tests load from
        # beside them, as rind-openssl's do.
        elif (
            message["package_id"].startswith("path+file:")
            and "cdylib" in message["target"]["kind"]
        ):
            libraries += [f for f in message["filenames"] if f.endswith(".so")]
    with open(TESTS, "w") as f:
        f.writelines(f"{exe}\t{package}\n" for exe, package in tests)
    with tarfile.open(ARCHIVE, "w") as tar:
        tar.add(TESTS)
        for path in [exe for exe, _ in tests] + libraries:
            tar.add(os.path.relpath(path))
    print(
        f"Archived {len(tests)} test binaries and {len(libraries)} libraries in {ARCHIVE}"
    )
elif mode == "test":
    model, *args = sys.argv[2:]
    with tarfile.open(ARCHIVE) as tar:
        tar.extractall(filter="tar")
    # Each test's CARGO_TARGET_TMPDIR, which cargo creates before a test run.
    # The binaries hold it and their CARGO_MANIFEST_DIR as absolute paths,
    # which hold because x86-cpu.yml's jobs check out to the same path.
    os.makedirs("target/tmp", exist_ok=True)
    failed = []
    for line in open(TESTS):
        exe, package = line.rstrip("\n").split("\t")
        print(f"Running {exe} in {package}", flush=True)
        run = subprocess.run(
            ["sde", model, "--", os.path.abspath(exe)] + args, cwd=package
        )
        if run.returncode != 0:
            failed.append(exe)
    if failed:
        sys.exit("Failed: " + " ".join(failed))
elif mode == "queue-slow":
    # The slow models, one after the other, as queue-build.yml runs them: build
    # once, then each model with its paths asserted as x86-cpu.yml's jobs do.
    # Every model runs before it fails, so one report names all that failed.
    subprocess.run([sys.argv[0], "archive"], check=True)
    failed = []
    for m in matrix("slow"):
        env = dict(os.environ)
        env.update({f"RIND_TEST_X86_{k}": str(v) for k, v in m["paths"].items()})
        print(f"== {m['model']}", flush=True)
        run = subprocess.run(
            [sys.argv[0], "test", "-" + m["sde"], "--skip", "large_digest"], env=env
        )
        if run.returncode != 0:
            failed.append(m["model"])
    if failed:
        sys.exit("Failed models: " + ", ".join(failed))
else:
    sys.exit(f"unknown mode {mode}")

#!/usr/bin/env python3

# Usage: admin/testing
#
# Checks TESTING.md's primitives table against the code, and fails on each
# difference:
# - every item rind exports is named in the table's Exports column, or in the
#   list of exports that are not primitives, and every name there is exported;
# - every fuzz target, every differential test in `rind/tests/crosschecks_*.rs`,
#   every `ct_sde_...`, `ct_qemu_...`, and `ct_binsec_...` test, every CCTV and
#   imported-vector test, every test in `rind/tests/zeroing.rs`, and every
#   Wycheproof and CAVP file the tests load is named in the table;
# - every row with a constant-time check names a zeroing test, or says why not;
# - every row names its independent oracle, or says why it has none, and
#   every name there in backticks is one of rind's dev-dependencies, or, with
#   a slash, a file in the repository;
# - every function, fuzz target, and vector file the table names exists;
# - every other fuzz target is an adapter's or a binding's, named on the
#   adapters or bindings line.
#
# A backticked name in the table's other columns, but the oracle's, is one of:
# - `fuzz::NAME`, a fuzz target;
# - `crosschecks_FAMILY::[MOD::]FN`, a test in `rind/tests/crosschecks_FAMILY.rs` by its
#   full module path, where `*` matches any run of characters, as a macro's
#   per-curve or per-suite modules need;
# - `zeroing::FN`, a test in `rind/tests/zeroing.rs`;
# - `aws_lc::FN` or `cctv::FN`, a test in `rind/tests/NAME.rs`;
# - `a::b::FN`, a function in `rind/src/a/b.rs` (or `a/b/mod.rs`);
# - `STEM_test`, a Wycheproof file, where `*` matches any run of characters;
# - `cavp/DIR` or `cavp-sha1`, a CAVP directory.

import fnmatch, pathlib, re, sys, tomllib

ROOT = pathlib.Path(__file__).resolve().parent.parent
SRC = ROOT / "rind/src"
PAGE = ROOT / "TESTING.md"
COLUMNS = ["Primitive", "Exports", "Vectors", "Fuzz target", "Differential test", "Independent oracle", "Constant time", "Zeroing"]
ORACLE = "Independent oracle"
NOT_PRIMITIVES = "Exports that are not primitives:"
ADAPTERS = "Adapter fuzz targets:"
BINDINGS = "Binding fuzz targets:"

errors = []


# One alternation, so each token starts at its own leftmost delimiter and a
# `//` inside a string, or a quote inside a comment or char literal, is inert.
LEXEME = re.compile(
    r"(?P<comment>//[^\n]*|/\*.*?\*/)"
    r'|(?P<literal>r(?P<hashes>#*)".*?"(?P=hashes)|"(?:\\.|[^"\\])*"|\'(?:\\.[^\']*|[^\'\\])\')',
    re.S,
)


def strip_literals(text):
    """`text` with each comment a space and each string or char literal empty,
    so only code's own braces, items, and attributes remain."""
    return LEXEME.sub(lambda m: " " if m.lastgroup == "comment" else '""', text)


def exports(path, prefix):
    """The public paths of the items `path` exports, following `pub mod`."""
    text = strip_literals(path.read_text())
    token = re.compile(
        r"pub mod (\w+)\s*\{|pub mod (\w+)\s*;|pub use ([^;]+);"
        r"|pub (?:static|struct|fn|enum|const|trait|type) (\w+)|(\{)|(\})"
    )
    found, mods, depth = [], [], 0
    for m in token.finditer(text):
        here = prefix + [name for name, _ in mods]
        inline, child, use, item, opened, closed = m.groups()
        if inline:
            depth += 1
            mods.append((inline, depth))
        elif child:
            directory = SRC if path.name == "lib.rs" else path.parent / path.stem
            found += exports(directory / f"{child}.rs", here + [child])
        elif use:
            use = " ".join(use.split())
            names = use.split("{", 1)[1].rstrip("} ").split(",") if "{" in use else [use]
            for name in names:
                name = name.strip().split(" as ")[-1].split("::")[-1]
                if name and name != "self":
                    found.append("::".join(here + [name]))
        elif item:
            # Only items at a module's own level: not an impl's methods.
            if depth == len(mods):
                found.append("::".join(here + [item]))
        elif opened:
            depth += 1
        elif closed:
            if mods and mods[-1][1] == depth:
                mods.pop()
            depth -= 1
    return found


def expand(token):
    """`a::{B, C}` as `a::B` and `a::C`."""
    if "{" not in token:
        return [token]
    head, rest = token.split("{", 1)
    return [head + name.strip() for name in rest.rstrip("}").split(",") if name.strip()]


def table():
    """The primitives table's rows, as dicts by column, and the exports the
    page lists as not primitives."""
    lines = PAGE.read_text().splitlines()
    header = "| " + " | ".join(COLUMNS) + " |"
    if header not in lines:
        sys.exit(f"admin/testing: TESTING.md has no table headed: {header}")
    rows = []
    for line in lines[lines.index(header) + 2 :]:
        if not line.startswith("|"):
            break
        cells = [cell.strip() for cell in line.strip().strip("|").split("|")]
        if len(cells) != len(COLUMNS):
            errors.append(f"row has {len(cells)} cells, not {len(COLUMNS)}: {line[:60]}")
            continue
        rows.append(dict(zip(COLUMNS, cells)))
    others = [line for line in lines if line.startswith(NOT_PRIMITIVES)]
    if len(others) != 1:
        sys.exit(f"admin/testing: TESTING.md needs one line starting {NOT_PRIMITIVES!r}")
    return rows, re.findall(r"`([^`]+)`", others[0])


def functions(path):
    return set(re.findall(r"\bfn ([a-z0-9_]+)", path.read_text()))


def tests(path):
    """The names of the `#[test]` functions in `path`."""
    return set(re.findall(r"#\[test\]\s*(?:#\[[^\]]*\]\s*)*fn ([a-z0-9_]+)", path.read_text()))


def test_paths(text):
    """The module path of each `#[test]` in the Rust source `text`, as
    `mod::fn`, with a test a macro defines counted under each module it is
    invoked in, and a `$name` module it declares named by the invocation's
    argument."""
    text = strip_literals(text)
    tokens = re.findall(r"\$?[A-Za-z_][A-Za-z0-9_]*|[{}()\[\]!#;,]", text)
    macros = {}  # name -> [(modules relative to its body, test)]
    found = set()
    stack = []  # ("mod", name), ("macro", name), or ("other", None)
    marked = False
    i = 0

    def group(i):
        """The index after the bracket group opening at `i`."""
        depth = 0
        while True:
            depth += tokens[i] in "{(["
            depth -= tokens[i] in "})]"
            i += 1
            if depth == 0:
                return i

    while i < len(tokens):
        tok = tokens[i]
        if tok == "#" and tokens[i + 1 : i + 2] == ["["]:
            end = group(i + 1)
            marked |= tokens[i + 2 : end - 1] == ["test"]
            i = end
        elif tok == "mod" and tokens[i + 2 : i + 3] == ["{"]:
            stack.append(("mod", tokens[i + 1]))
            i += 3
        elif tok == "macro_rules" and tokens[i + 1 : i + 2] == ["!"]:
            macros[tokens[i + 2]] = []
            stack.append(("macro", tokens[i + 2]))
            i += 4
        elif tok == "{":
            stack.append(("other", None))
            marked = False
            i += 1
        elif tok == "}":
            stack.pop()
            marked = False
            i += 1
        elif tok == "fn" and marked:
            mods = [n for kind, n in stack if kind == "mod"]
            macro = next((n for kind, n in stack if kind == "macro"), None)
            if macro is None:
                found.add("::".join([*mods, tokens[i + 1]]))
            else:
                depth = [k for k, (kind, _) in enumerate(stack) if kind == "macro"][0]
                macros[macro].append(([n for kind, n in stack[depth:] if kind == "mod"], tokens[i + 1]))
            marked = False
            i += 2
        elif tok in macros and tokens[i + 1 : i + 2] == ["!"] and tokens[i + 2 : i + 3] in (["("], ["{"], ["["]) and not any(k == "macro" for k, _ in stack):
            end = group(i + 2)
            args = tokens[i + 3 : end - 1]
            first = args[0] if args else ""
            mods = [n for kind, n in stack if kind == "mod"]
            for relative, test in macros[tok]:
                found.add("::".join([*mods, *(first if m.startswith("$") else m for m in relative), test]))
            i = end
        else:
            if tok == ";":
                marked = False
            i += 1
    return found


# Parser checks: delimiters inside a literal or comment must not hide or invent
# a test, or the completeness check below would accept an undocumented one.
PARSER_CHECKS = [
    ('#[test]\nfn first() { let _ = "https://example.test"; }\n#[test]\nfn second() { let _ = "ok"; }', {"first", "second"}),
    ('#[test]\nfn a() { let _ = r#"// "x"#; }\n#[test]\nfn b() { let _ = \'"\'; }\n#[test]\nfn c() {}', {"a", "b", "c"}),
    ('// "\n#[test]\nfn a() {}\n/* " */\n#[test]\nfn b() { let _ = "}"; }', {"a", "b"}),
    ('#[test]\nfn a() { let _ = "/* "; }\n#[test]\nfn b() { let _ = " */"; }', {"a", "b"}),
]
for source, want in PARSER_CHECKS:
    got = test_paths(source)
    if got != want:
        sys.exit(f"admin/testing: parser check failed: found {sorted(got)}, not {sorted(want)}, in {source!r}")


def source_file(segments):
    for candidate in [SRC.joinpath(*segments).with_suffix(".rs"), SRC.joinpath(*segments, "mod.rs")]:
        if candidate.is_file():
            return candidate
    return None


rows, not_primitives = table()

exported = set(exports(SRC / "lib.rs", []))
named = {name for row in rows for token in re.findall(r"`([^`]+)`", row["Exports"]) for name in expand(token)}
named |= {name for token in not_primitives for name in expand(token)}
for name in sorted(exported - named):
    errors.append(f"export `{name}` has no row")
for name in sorted(named - exported):
    errors.append(f"`{name}` is not exported")

fuzz_targets = set(re.findall(r'^name = "([a-z0-9_]+)"', (ROOT / "fuzz/Cargo.toml").read_text(), re.M))
fuzz_targets.discard("rind-fuzz")
crosschecks = {p.stem: test_paths(p.read_text()) for p in (ROOT / "rind/tests").glob("crosschecks_*.rs")}
zeroing_path = ROOT / "rind/tests/zeroing.rs"

# What the code loads, read from string literals across the tests.
code = "\n".join(p.read_text() for d in ["rind/src", "rind/tests"] for p in (ROOT / d).rglob("*.rs"))
wycheproof = set(re.findall(r'"([a-z0-9_]+_test)\.json"', code))
cavp = set(re.findall(r"\b(cavp-sha1|cavp/[a-z0-9]+)/", code))
ct_tests = {
    name
    for p in SRC.rglob("*.rs")
    for name in tests(p)
    if re.match(r"ct_(sde|qemu|binsec)_", name) and "_planted_" not in name
}
# Imported-vector and CCTV unit tests use these suite prefixes, as the
# constant-time tests use ct_sde_, ct_qemu_, and ct_binsec_. Integration
# suites include every test.
vector_suites = {name: tests(ROOT / f"rind/tests/{name}.rs") for name in ["aws_lc", "cctv"]}
vector_tests = {
    "::".join([*(p.parent if p.name == "mod.rs" else p.with_suffix("")).relative_to(SRC).parts, name])
    for p in SRC.rglob("*.rs")
    for name in tests(p)
    if re.match(r"(aws_lc|boringssl|cctv)(_|$)", name)
}

manifest = tomllib.loads((ROOT / "rind/Cargo.toml").read_text())
dev_dependencies = set(manifest.get("dev-dependencies", {}))
for target in manifest.get("target", {}).values():
    dev_dependencies |= set(target.get("dev-dependencies", {}))

seen = {kind: set() for kind in ["fuzz", "crosschecks", "wycheproof", "cavp", "ct", "vectors", "zeroing", *vector_suites]}
for row in rows:
    if row["Constant time"] and not (row["Zeroing"].startswith("`zeroing::") or row["Zeroing"].startswith("none: ")):
        errors.append(f"{row['Primitive']}: marks a secret but names no zeroing test, nor says why")
    if not row[ORACLE]:
        errors.append(f"{row['Primitive']}: names no independent oracle, nor says why")
    for token in re.findall(r"`([^`]+)`", row[ORACLE]):
        if "/" in token:
            if not (ROOT / token).is_file():
                errors.append(f"{row['Primitive']}, {ORACLE}: no file `{token}`")
        elif token not in dev_dependencies:
            errors.append(f"{row['Primitive']}, {ORACLE}: `{token}` is not a dev-dependency of rind")
    for column in COLUMNS[2:]:
        if column == ORACLE:
            continue
        for token in re.findall(r"`([^`]+)`", row[column]):
            where = f"{row['Primitive']}, {column}: `{token}`"
            segments = token.split("::")
            if segments[0] == "fuzz" and len(segments) == 2:
                if segments[1] not in fuzz_targets:
                    errors.append(f"{where} is no fuzz target")
                seen["fuzz"].add(segments[1])
            elif segments[0] in crosschecks and len(segments) >= 2:
                matches = fnmatch.filter(crosschecks[segments[0]], "::".join(segments[1:]))
                if not matches:
                    errors.append(f"{where}: no such test in {segments[0]}.rs")
                seen["crosschecks"].update(f"{segments[0]}::{match}" for match in matches)
            elif segments[0] == "zeroing" and len(segments) == 2:
                if segments[1] not in tests(zeroing_path):
                    errors.append(f"{where}: no such test in {zeroing_path.name}")
                if column != "Zeroing":
                    errors.append(f"{where}: zeroing test belongs in Zeroing")
                seen["zeroing"].add(segments[1])
            elif segments[0] in vector_suites and len(segments) == 2:
                if segments[1] not in vector_suites[segments[0]]:
                    errors.append(f"{where}: no such test in rind/tests/{segments[0]}.rs")
                if column != "Vectors":
                    errors.append(f"{where}: vector suite test belongs in Vectors")
                seen[segments[0]].add(segments[1])
            elif len(segments) >= 2 and all(re.fullmatch(r"[a-z0-9_]+", s) for s in segments):
                path = source_file(segments[:-1])
                if path is None or segments[-1] not in functions(path):
                    errors.append(f"{where}: no such function under rind/src")
                seen["ct"].add(segments[-1])
                if column == "Vectors":
                    seen["vectors"].add(token)
            elif token.endswith("_test"):
                matches = fnmatch.filter(wycheproof, token)
                if not matches:
                    errors.append(f"{where} matches no Wycheproof file the tests load")
                seen["wycheproof"].update(matches)
            elif token in cavp:
                seen["cavp"].add(token)
            else:
                errors.append(f"{where} is not a name admin/testing knows")

for label in [ADAPTERS, BINDINGS]:
    lines = [line for line in PAGE.read_text().splitlines() if line.startswith(label)]
    if len(lines) != 1:
        sys.exit(f"admin/testing: TESTING.md needs one line starting {label!r}")
    for token in re.findall(r"`([^`]+)`", lines[0]):
        segments = token.split("::")
        if len(segments) != 2 or segments[0] != "fuzz" or segments[1] not in fuzz_targets:
            errors.append(f"{label} `{token}` is no fuzz target")
        elif segments[1] in seen["fuzz"]:
            errors.append(f"{label} `{token}` is also a primitive's or adapter's")
        else:
            seen["fuzz"].add(segments[1])

for kind, names in [
    ("fuzz target", fuzz_targets - seen["fuzz"]),
    ("differential test", {f"{stem}::{name}" for stem, names in crosschecks.items() for name in names} - seen["crosschecks"]),
    ("constant-time test", ct_tests - seen["ct"]),
    ("zeroing test", tests(zeroing_path) - seen["zeroing"]),
    ("Wycheproof file", wycheproof - seen["wycheproof"]),
    ("CAVP directory", cavp - seen["cavp"]),
    ("vector test", vector_tests - seen["vectors"]),
    *[(f"{suite} vector test", names - seen[suite]) for suite, names in vector_suites.items()],
]:
    for name in sorted(names):
        errors.append(f"{kind} `{name}` is in no row")

for error in errors:
    print(f"admin/testing: TESTING.md: {error}", file=sys.stderr)
sys.exit(1 if errors else 0)

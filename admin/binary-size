#!/usr/bin/env python3
"""Reports what rind adds to a binary, and a change's effect on it.

Usage: admin/binary-size [--base REV | --json | --lock]

Builds admin/build-cost-fixtures' `rind` and `rustls` programs, the latter
over rind-rustls, in release with one codegen unit, and sums the sizes of the
functions and tables that rind and rind-rustls define in each: what the
linker kept of them. One codegen unit keeps code no fixture calls from moving
the sums, which the default sixteen let it do by shifting what rustc inlines;
it measures a build about 0.5% smaller than a default release.

It prints each sum as a Markdown table, also into the GitHub Actions job
summary when there is one. With `--base`, it builds REV's tree too and adds
its sums and the change, so a pull request's check shows what it does to
rind's size; any change passes, for a reviewer to weigh. `--json` prints this
tree's sums as JSON instead, which the weekly bench saves for BENCHMARKS.md.
The sums are one toolchain's, and both trees build with this tree's, so it
shows no change when REV's dev shell has another rustc, nor when REV's
fixtures fail to build. `nm` reads the sums only from ELF: elsewhere the programs are only
built, which still checks that they compile.

The fixtures float on the newest rustls for admin/build-cost, and which of
rind's code a program keeps depends on its other crates, so each builds here
from its own lockfile, admin/binary-size-<fixture>.lock, copied over the
fixture's ignored one; REV's tree builds from REV's. cargo still adds to the
copy what the lockfile lacks, such as a new version of rind. `--lock`
re-resolves the lockfiles from scratch, taking the newest releases, and
writes them back.

The code rustc emits for a crate depends on its `-C metadata`, and cargo
hashes into that the absolute path of a path dependency outside the
workspace, as rind and rind-rustls are to a fixture's: the same tree built
from two checkouts differed by thousands of bytes. So this script is also
the builds' rustc wrapper, giving rind's own crates a `-C metadata` that
leaves out where the tree is, which also lets REV's tree, extracted under the
target directory, build its unchanged crates to the same code. Remapping
paths cannot help, and cargo's trim-paths only leaves the path out from a
later release than the pinned toolchain's.
"""

import argparse
import hashlib
import io
import json
import os
import re
import shutil
import subprocess
import sys
import tarfile
import time
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
# Its own, since cargo does not rebuild for a changed wrapper: a build
# without it, or with an earlier version of it, would look up to date. Both
# trees build here, so the crates they share build once.
TARGET_DIR = ROOT / "target" / "binary-size"
# Where `--base` extracts REV's tree. It stays between runs, so a rerun
# against the same REV rebuilds nothing.
BASE_TREE = TARGET_DIR / "base"

# Each fixture, the features it builds with, and its name in the tables.
BUILDS = {"rind": ([], "rind"), "rustls": (["rind"], "rustls + rind-rustls")}

# A symbol rind or rind-rustls defines, by its demangled name: a path in the
# crate, or an impl on one of its types.
OURS = re.compile(r"^[<&\[(]*(?:rind|rind_rustls)::")


def lockfile(tree, fixture):
    """The lockfile `fixture` builds from in `tree`."""
    return tree / "admin" / f"binary-size-{fixture}.lock"


def build_env():
    """The environment for each build, free of settings that change its code."""
    env = {
        k: v
        for k, v in os.environ.items()
        if not k.startswith(("CARGO_PROFILE_", "CARGO_TARGET_", "CARGO_BUILD_"))
        # rind reads VALGRIND_BUG_494162 at compile time, building in ADX
        # whatever the CPU says.
        and k not in ("RUSTFLAGS", "CARGO_INCREMENTAL", "VALGRIND_BUG_494162")
    }
    # Empty, it also overrides the flags of a cargo configuration file.
    env["CARGO_ENCODED_RUSTFLAGS"] = ""
    # A cargo configuration file's `[profile.release]` applies whatever the
    # environment holds, unless a variable sets the key. So each key that
    # changes the code or its symbols takes cargo's release default, but one
    # codegen unit, for the reason the docstring gives.
    for key, value in {
        "OPT_LEVEL": "3",
        "LTO": "false",
        "CODEGEN_UNITS": "1",
        "DEBUG": "false",
        "DEBUG_ASSERTIONS": "false",
        "OVERFLOW_CHECKS": "false",
        "PANIC": "unwind",
        "STRIP": "debuginfo",
    }.items():
        env[f"CARGO_PROFILE_RELEASE_{key}"] = value
    env["RUSTC_WRAPPER"] = str(Path(__file__).resolve())
    env.pop("RUSTC_WORKSPACE_WRAPPER", None)
    return env


def rustc(tree, args):
    """Runs rustc as cargo asks, with a `-C metadata` for a crate in `tree`
    from its path within it, not the tree's own."""
    sources = [Path(a).resolve() for a in args if a.endswith(".rs")]
    if len(sources) == 1 and sources[0].is_relative_to(tree):
        # What else sets one build of a crate apart: its features and type.
        key = [str(sources[0].relative_to(tree))]
        key += [f"{a} {b}" for a, b in zip(args, args[1:]) if a in ("--cfg", "--crate-type")]
        metadata = "metadata=" + hashlib.sha256("\n".join(sorted(key)).encode()).hexdigest()[:16]
        args = [metadata if a.startswith("metadata=") else a for a in args]
    os.execvp(args[0], args)


def build(tree, fixture, host, env, lock):
    """Builds `fixture` of `tree` in release for `host` and returns its
    binary. With `lock`, it resolves the fixture's lockfile afresh and writes
    it back."""
    features = BUILDS[fixture][0]
    fixtures = tree / "admin" / "build-cost-fixtures"
    used = fixtures / fixture / "Cargo.lock"
    if lock:
        used.unlink(missing_ok=True)
    elif lockfile(tree, fixture).exists():
        shutil.copyfile(lockfile(tree, fixture), used)
    else:
        sys.exit(f"error: no {lockfile(tree, fixture)}; `admin/binary-size --lock` resolves one")
    # The target named, since a cargo configuration's `build.target` would
    # otherwise move the binary.
    cmd = ["cargo", "build", "--release", "--target", host, "--target-dir", str(TARGET_DIR)]
    cmd += ["--manifest-path", str(fixtures / fixture / "Cargo.toml")]
    if features:
        cmd += ["--features", ",".join(features)]
    # Each tree's crates get their metadata from their path within it.
    subprocess.run(cmd, env=env | {"RIND_BINARY_SIZE_TREE": str(tree)}, check=True)
    if lock:
        shutil.copyfile(used, lockfile(tree, fixture))
    return TARGET_DIR / host / "release" / f"build-cost-{fixture}"


def clear_stale_builds():
    """Empties the target directory if this script changed since it built
    there, so no build from an earlier wrapper is reused."""
    stamp = TARGET_DIR / "wrapper.sha256"
    digest = hashlib.sha256(Path(__file__).read_bytes()).hexdigest()
    if stamp.exists() and stamp.read_text() == digest:
        return
    shutil.rmtree(TARGET_DIR, ignore_errors=True)
    TARGET_DIR.mkdir(parents=True)
    stamp.write_text(digest)


def extract(rev):
    """Extracts `rev`'s tree to BASE_TREE, unless it is there already, and
    returns it."""
    commit = subprocess.run(
        ["git", "rev-parse", "--verify", f"{rev}^{{commit}}"], cwd=ROOT, check=True, capture_output=True, text=True
    ).stdout.strip()
    stamp = TARGET_DIR / "base.commit"
    if stamp.exists() and stamp.read_text() == commit and BASE_TREE.exists():
        return BASE_TREE
    shutil.rmtree(BASE_TREE, ignore_errors=True)
    stamp.unlink(missing_ok=True)
    # Each file gets the time of extraction, not the commit's: cargo rebuilds
    # a path dependency only when a source is newer than its build, which an
    # older REV's would not be.
    now = time.time()
    archive = subprocess.run(["git", "archive", commit], cwd=ROOT, check=True, capture_output=True).stdout
    with tarfile.open(fileobj=io.BytesIO(archive)) as tar:
        tar.extractall(BASE_TREE, filter=lambda m, path: tarfile.tar_filter(m, path).replace(mtime=now))
    stamp.write_text(commit)
    return BASE_TREE


def measure(binary):
    """The bytes rind and rind-rustls define in `binary`."""
    nm = subprocess.run(
        ["nm", "--defined-only", "-S", "-C", str(binary)], check=True, capture_output=True, text=True
    ).stdout
    # Two names for one address, such as a function and its alias, count once.
    sizes = {}
    for line in nm.splitlines():
        m = re.match(r"([0-9a-f]+) ([0-9a-f]+) \S (.+)$", line)
        if m and OURS.match(m.group(3)):
            address = int(m.group(1), 16)
            sizes[address] = max(sizes.get(address, 0), int(m.group(2), 16))
    if not sizes:
        sys.exit(f"error: {binary} names no rind symbol; was it stripped?")
    return sum(sizes.values())


def sizes(tree, host, env):
    """Each fixture's bytes of rind in `tree`."""
    binaries = {fixture: build(tree, fixture, host, env, False) for fixture in BUILDS}
    return {fixture: measure(binary) for fixture, binary in binaries.items()}


def base_sizes(rev, host, env):
    """REV's sums, or None and why they would not compare with this tree's."""
    tree = extract(rev)
    # Both trees build with this tree's toolchain, so a change to it would
    # show as none. Only a flake edit can make one, and most edit something
    # else, so REV's own dev shell names its rustc.
    flake = subprocess.run(["git", "diff", "--quiet", rev, "--", "flake.nix", "flake.lock"], cwd=ROOT)
    if flake.returncode == 1:
        if shutil.which("nix") is None:
            return None, f"the flake changed since {rev[:12]} and this host has no nix to read its toolchain"
        ours = subprocess.run(["rustc", "-vV"], env=env, check=True, capture_output=True, text=True).stdout
        theirs = subprocess.run(
            ["nix", "develop", f"path:{tree}", "--command", "rustc", "-vV"], capture_output=True, text=True
        )
        if theirs.returncode != 0:
            return None, f"{rev[:12]}'s dev shell did not start, so its toolchain is unknown"
        if theirs.stdout != ours:
            return None, f"the toolchain changed since {rev[:12]}, so only this tree's sums show"
    else:
        flake.check_returncode()
    try:
        return sizes(tree, host, env), None
    except subprocess.CalledProcessError:
        # Not this tree's failure: the fixtures run in no merge gate, so its
        # base may hold a break no check caught.
        return None, f"{rev[:12]}'s fixtures did not build, so only this tree's sums show"


def table(target, head, base=None, rev=None):
    """The sums as Markdown, with the change from `base` when given."""
    lines = [f"Bytes of rind and rind-rustls in admin/build-cost-fixtures' programs on {target}:", ""]
    if base is None:
        lines += ["| Program | Bytes |", "|---|---:|"]
        lines += [f"| {BUILDS[f][1]} | {head[f]:,} |" for f in BUILDS]
    else:
        lines += [f"| Program | Base ({rev}) | Head | Change |", "|---|---:|---:|---:|"]
        for f in BUILDS:
            change = head[f] - base[f]
            lines.append(
                f"| {BUILDS[f][1]} | {base[f]:,} | {head[f]:,} | {change:+,} ({change / base[f]:+.2%}) |"
            )
    return "\n".join(lines) + "\n"


def main():
    # cargo runs the wrapper as `<wrapper> <rustc> <args>`.
    if tree := os.environ.get("RIND_BINARY_SIZE_TREE"):
        rustc(Path(tree), sys.argv[1:])
    parser = argparse.ArgumentParser(usage=__doc__.split("\n\n")[1].removeprefix("Usage: ").strip())
    mode = parser.add_mutually_exclusive_group()
    mode.add_argument("--base", metavar="REV", help="also measure REV's tree and show the change")
    mode.add_argument("--json", action="store_true", help="print this tree's sums as JSON")
    mode.add_argument("--lock", action="store_true", help="re-resolve the fixtures' lockfiles")
    args = parser.parse_args()

    env = build_env()
    version = subprocess.run(["rustc", "-vV"], env=env, check=True, capture_output=True, text=True).stdout
    target = re.search(r"^host: (.+)$", version, re.M).group(1)
    clear_stale_builds()

    if args.lock:
        for fixture in BUILDS:
            build(ROOT, fixture, target, env, True)
        return
    # nm reads sizes only from ELF.
    if re.search(r"-(apple|windows)", target):
        if args.json:
            sys.exit(f"error: {target} binaries are not ELF, which nm reads sizes from")
        for fixture in BUILDS:
            build(ROOT, fixture, target, env, False)
        print(f"built; {target} binaries are not ELF, which nm reads sizes from")
        return
    # The base first, so the head's binaries are the ones left to inspect.
    base, why = base_sizes(args.base, target, env) if args.base else (None, None)
    head = sizes(ROOT, target, env)
    if args.json:
        rustc_version = version.splitlines()[0]
        print(json.dumps({"schema": 1, "target": target, "rustc": rustc_version, "bytes": head}, indent=1))
        return
    report = table(target, head, base, args.base and args.base[:12])
    if why:
        report += f"\nNo change shown: {why}.\n"
    print(report, end="")
    if summary := os.environ.get("GITHUB_STEP_SUMMARY"):
        with open(summary, "a") as f:
            f.write("\n" + report + "\n")


if __name__ == "__main__":
    main()

#!/usr/bin/env python3
"""Regenerates pyca/verified-garbage's code under rind/src/low/<arch>/vg.

Usage: admin/import-vg <verified-garbage checkout at REV>

verified-garbage (VG) proves its assembly in Lean and prints each routine as
a Rust naked function in `crates/verified-garbage-asm-<arch>/src`, and each
table its routines load as a `static`. This copies the items rind runs, the
`ROOTS` below and every item they reach through a `sym` operand, one file per
item, with three mechanical edits:

- each `sym` path, which names the item's module in VG's crate, becomes
  `super::<item's file>::<item>`;
- on x86_64, each `.base64 "..."` line, which the assembler of rind's MSRV
  rejects, becomes `.byte` lines of the same bytes; see UPSTREAM.md,
  "Rust 1.90's assembler cannot read verified-garbage's `.base64`";
- `vg/mod.rs` declares the items, with VG's `Table` type and the
  `vg_sym_page!` and `vg_sym_pageoff!` macros its aarch64 items use.

Everything else of an item, its documentation and safety contract included,
is VG's text, so undoing those edits gives VG's item byte for byte, and the
machine code is VG's. VG's `*_FEATURES` constants and dispatchers are not
copied: rind picks the routine for the CPU itself.

A switch to a VG routine adds it to `ROOTS` and reruns this.
"""

import base64
import os
import re
import subprocess
import sys

REV = "0aa40d6c21fd02943fe5b38a5b69b6213d07764d"

ROOT = os.path.join(os.path.dirname(__file__), "..", "rind", "src", "low")

# The functions rind calls, per architecture, by VG's name.
ROOTS = {
    "x86_64": [
        # cipher::ChaCha20 with AVX2, and with AVX-512 VL.
        "vg_chacha20_init",
        "vg_chacha20_apply_avx2",
        "vg_chacha20_apply_avx512vl",
        # ChaCha20-Poly1305 with AVX512_IFMA.
        "vg_chacha20_poly1305_seal_ifma",
        "vg_chacha20_poly1305_open_ifma",
        # ML-KEM-768's encapsulation key check and encapsulation, by key or
        # with its hash, on every CPU; key generation and decapsulation
        # with AVX-512.
        "vg_mlkem768_check_ek",
        "vg_mlkem768_check_ek_avx2",
        "vg_mlkem768_encaps",
        "vg_mlkem768_encaps_avx",
        "vg_mlkem768_encaps_avx2",
        "vg_mlkem768_encaps_avx512",
        "vg_mlkem768_encaps_h",
        "vg_mlkem768_encaps_h_avx",
        "vg_mlkem768_encaps_h_avx2",
        "vg_mlkem768_encaps_h_avx512",
        "vg_mlkem768_keygen_avx512",
        "vg_mlkem768_decaps_avx512",
        # P-256's public key, ECDH, and ECDSA verification: with BMI2 and
        # ADX, and with AVX-512 IFMA for ECDH and verification.
        "vg_ec_p256_public_key_adx",
        "vg_ecdh_p256_adx",
        "vg_ecdh_p256_ifma",
        "vg_ecdsa_p256_verify_adx",
        "vg_ecdsa_p256_verify_ifma",
        # X25519 and Ed25519 with AVX512_IFMA: VG's routines for CPUs
        # without the SHA-512 instructions, as its dispatcher picks on them.
        "vg_x25519_exchange_ifma",
        "vg_x25519_base_ifma",
        "vg_ed25519_key_pair_avx2_ifma",
        "vg_ed25519_sign_expanded_avx2_ifma",
        "vg_ed25519_verify_avx2_ifma",
        # RSA's public operation, with AVX512_IFMA for 2048-, 3072-, and
        # 4096-bit moduli and e = 65537 and with ADX for the rest.
        "vg_rsa_public_precomputed_checked_ifma",
        # RSA's CRT with AVX512_IFMA for balanced 2048-, 3072-, and 4096-bit
        # keys, and its twin for CPUs with two 512-bit multipliers.
        "vg_rsa_private_crt_precomputed_ifma",
        "vg_rsa_private_crt_precomputed_ifma512",
        # P-384's k·G, for ECDSA's keys and nonces, with BMI2 and ADX and
        # without, and its ECDSA verification with them.
        "vg_ec_p384_public_key",
        "vg_ec_p384_public_key_adx",
        "vg_ecdsa_p384_verify_adx",
        # RSA's R² mod n for a public modulus, with BMI2 and ADX.
        "vg_rsa_public_precompute_adx",
    ],
    "aarch64": [
        # cipher::ChaCha20 with NEON, and with SVE2.
        "vg_chacha20_init",
        "vg_chacha20_apply_neon",
        "vg_chacha20_apply_sve2",
        # ChaCha20-Poly1305 with SVE2.
        "vg_chacha20_poly1305_seal_sve2",
        "vg_chacha20_poly1305_open_sve2",
        # ML-KEM-768's encapsulation key check, and encapsulation with the
        # SHA-3 instructions: Apple's cores take VG's variant that also runs
        # Keccak on them, as VG's dispatcher picks.
        "vg_mlkem768_check_ek",
        "vg_mlkem768_encaps_x2_sha3",
        "vg_mlkem768_encaps_x2_sha3_keccak_sha3",
        "vg_mlkem768_encaps_h_x2_sha3",
        "vg_mlkem768_encaps_h_x2_sha3_keccak_sha3",
        # P-256's public key, ECDH, and ECDSA verification.
        "vg_ec_p256_public_key",
        "vg_ecdh_p256",
        "vg_ecdsa_p256_verify",
        # PBKDF2 over HMAC-SHA1 and HMAC-SHA256 with the crypto extension,
        # and over HMAC-SHA384 and HMAC-SHA512 with the SHA-512 instructions.
        "vg_pbkdf2_hmac_sha1_sha2",
        "vg_pbkdf2_hmac_sha256_sha2",
        "vg_pbkdf2_hmac_sha384_sha512",
        "vg_pbkdf2_hmac_sha512_sha512",
        # P-384's k·G, for ECDSA's keys and nonces, and its ECDSA
        # verification.
        "vg_ec_p384_public_key",
        "vg_ecdsa_p384_verify",
        # RSA's R² mod n for a public modulus.
        "vg_rsa_public_precompute",
    ],
}

HEADER = """\
// @generated by admin/import-vg from pyca/verified-garbage {rev}:
// crates/verified-garbage-asm-{arch}/{source}. Do not edit by hand.
// SPDX-License-Identifier: Apache-2.0 OR BSD-3-Clause
"""

SYM = re.compile(r"\bsym ((?:crate|super)::[A-Za-z0-9_:]+)")
BASE64 = re.compile(r'^\.base64 "([A-Za-z0-9+/=]*)"$')


def items_of(crate):
    """Every naked function and table of VG's crate, by name: its source
    file, relative to `src`, and its text, from its documentation through
    its closing line."""
    src = os.path.join(crate, "src")
    items = {}
    for d in ["", "internal", "consts"]:
        for name in sorted(os.listdir(os.path.join(src, d))):
            if not name.endswith(".rs") or name in ("lib.rs", "mod.rs"):
                continue
            rel = os.path.join(d, name)
            with open(os.path.join(src, rel)) as f:
                lines = f.read().split("\n")
            for start, line in enumerate(lines):
                m = re.match(r"pub(?:\(crate\))? (?:unsafe extern \"\w+\" fn (\w+)\(|static (\w+):)", line)
                if not m:
                    continue
                name = m.group(1) or m.group(2)
                begin = start
                while begin > 0 and re.match(r"(///|#\[)", lines[begin - 1]):
                    begin -= 1
                end = start
                closing = "}" if m.group(1) else '");'
                while lines[end] != closing:
                    end += 1
                text = "\n".join(lines[begin : end + 1])
                if name in items and items[name][1] != text:
                    sys.exit(f"{name} differs between {items[name][0]} and {rel}")
                items.setdefault(name, (rel, text))
    return items


def module_of(name):
    """The file, under `vg`, that holds an item: its name in lower case, as
    VG names its tables' files."""
    return name.lower()


def closure(items, roots):
    """The roots and every item they reach through `sym` operands."""
    seen, todo = [], list(roots)
    while todo:
        name = todo.pop()
        if name in seen:
            continue
        if name not in items:
            sys.exit(f"no item {name} in verified-garbage")
        seen.append(name)
        for path in SYM.findall(items[name][1]):
            todo.append(path.rsplit("::", 1)[1])
    return sorted(seen)


def rewrite(arch, text):
    """`text` with each `sym` path local to `vg`, and on x86_64 each
    `.base64` line as `.byte` lines."""

    def sym(m):
        name = m.group(1).rsplit("::", 1)[1]
        return f"sym super::{module_of(name)}::{name}"

    text = SYM.sub(sym, text)
    out = []
    for line in text.split("\n"):
        # A line may open the item's raw string: `r#".base64 "..."`.
        prefix = ""
        if line.startswith(("r\"", "r#\"")) or re.match(r'\s+r#*"', line):
            i = line.index('"') + 1
            prefix, line = line[:i], line[i:]
        m = BASE64.match(line)
        if m:
            data = base64.b64decode(m.group(1), validate=True)
            assert base64.b64encode(data).decode() == m.group(1)
            rows = [data[i : i + 16] for i in range(0, len(data), 16)]
            line = "\n".join(".byte " + ",".join(f"0x{b:02x}" for b in row) for row in rows)
        elif line.startswith(".base64") and arch == "x86_64":
            sys.exit(f"unexpected .base64 line: {line}")
        out.append(prefix + line)
    return "\n".join(out)


def macros(crate):
    """lib.rs's `vg_sym_page!` and `vg_sym_pageoff!` definitions, with their
    documentation and attributes."""
    with open(os.path.join(crate, "src", "lib.rs")) as f:
        text = f.read()
    blocks = re.findall(r"(?:///[^\n]*\n)?(?:#\[[^\n]*\]\n)*macro_rules! vg_sym_page(?:off)? \{\n.*?\n\}\n", text, re.S)
    return "\n".join(blocks)


def table(crate):
    """consts/mod.rs's `Table` type, with its documentation and attributes."""
    with open(os.path.join(crate, "src", "consts", "mod.rs")) as f:
        text = f.read()
    m = re.search(r"(?:///[^\n]*\n)(?:#\[[^\n]*\]\n)*pub struct Table<[^\n]*\n", text)
    return m.group(0)


def write(path, text):
    # Renamed into place, so a failure partway leaves the committed file whole.
    tmp = path + ".tmp"
    with open(tmp, "w") as f:
        f.write(text)
    os.replace(tmp, path)


def import_arch(vg, arch, roots):
    crate = os.path.join(vg, "crates", f"verified-garbage-asm-{arch}")
    items = items_of(crate)
    names = closure(items, roots)
    out_dir = os.path.join(ROOT, arch, "vg")
    os.makedirs(out_dir, exist_ok=True)
    for old in os.listdir(out_dir):
        os.remove(os.path.join(out_dir, old))

    uses_table = uses_macros = False
    for name in names:
        source, text = items[name]
        text = rewrite(arch, text)
        body = HEADER.format(rev=REV, arch=arch, source="src/" + source)
        if source.startswith("consts"):
            body += "\nuse super::Table;\n"
            uses_table = True
        uses_macros |= "vg_sym_page" in text
        write(os.path.join(out_dir, module_of(name) + ".rs"), body + "\n" + text + "\n")

    mod = [
        HEADER.format(rev=REV, arch=arch, source="src").rstrip("\n"),
        "",
        "//! pyca/verified-garbage's verified routines that rind runs, and the",
        "//! routines and tables they reach: see admin/import-vg.",
        "",
        "#![allow(dead_code, unreachable_pub, unused_macros, clippy::all)]",
        "",
    ]
    if uses_macros:
        mod += [macros(crate)]
    if uses_table:
        mod += [table(crate)]
    for name in sorted(names, key=module_of):
        mod += ["#[rustfmt::skip]", f"pub(crate) mod {module_of(name)};"]
    write(os.path.join(out_dir, "mod.rs"), "\n".join(mod) + "\n")


def main():
    if len(sys.argv) != 2:
        sys.exit(__doc__)
    vg = sys.argv[1]
    rev = subprocess.run(
        ["git", "-C", vg, "rev-parse", "HEAD"], capture_output=True, text=True, check=True
    ).stdout.strip()
    if rev != REV:
        sys.exit(f"verified-garbage is at {rev}, expected {REV}")
    # The headers name REV, so the files read must be REV's: no local edits,
    # and no extra files, ignored ones included, for `items_of` to scan.
    dirty = subprocess.run(
        ["git", "-C", vg, "status", "--porcelain", "--untracked-files=all", "--ignored"],
        capture_output=True, text=True, check=True,
    ).stdout
    if dirty:
        sys.exit(f"verified-garbage's checkout differs from {REV}:\n{dirty}")
    for arch, roots in ROOTS.items():
        import_arch(vg, arch, roots)


if __name__ == "__main__":
    main()

#!/usr/bin/env python3
"""Copies pyca/verified-garbage's Lean ISA models and specs into proofs/verified-garbage.

Usage: admin/import-vg-models [--check] <verified-garbage clone holding REV>
       admin/import-vg-models --tables

verified-garbage (VG) proves its routines against Lean models of x86_64 and
aarch64 (`lean/VerifiedGarbage/TCB`), prints their assembly from the same
models, and encodes it. `admin/prove vg` checks each instruction of VG's code
that rind can run against the CPU through those models, so a proof of VG's
about a routine rind vendors rests on a model this has checked. This copies
the modules the cosimulation and those theorems need, `ROOTS` and every
module they import, byte for byte as REV holds them, whatever the clone's
working tree holds, and deletes any other file under
`proofs/verified-garbage/VerifiedGarbage`, so the copy is VG's at REV; the
cosimulation beside it, `Cosim/`, is rind's own and left alone.
`--check` changes nothing and fails unless the copy is already that.

The modules of `TABLES` are not copied: they are tables of curve points,
which `--tables` writes from a few lines of arithmetic here (and needs no
clone), so `admin/prove` writes them before Lean builds. Either other mode
fails unless what `--tables` writes is VG's module byte for byte.

REV is `admin/import-vg`'s, the commit rind's VG code comes from, so moving
that pin fails `--check` until the models move with it.
`admin/upstream verified-garbage` checks out VG at REV.
"""

import os
import re
import subprocess
import sys

ADMIN = os.path.dirname(os.path.abspath(__file__))
with open(os.path.join(ADMIN, "import-vg")) as f:
    REV = re.search(r'^REV = "([0-9a-f]{40})"$', f.read(), re.M).group(1)

DEST = os.path.join(ADMIN, "..", "proofs", "verified-garbage")

# The modules the cosimulation imports: each target's ISA, its printer, which
# turns an instruction into the text `admin/vg-bytes` reads, its encoder, and
# its ABI.
ROOTS = [
    f"VerifiedGarbage.TCB.{arch}.{m}"
    for arch in ["X86_64", "AArch64"]
    for m in ["Isa", "Print", "Encode", "Target"]
] + [
    # The specs whose functions rind's axioms about VG's routines state.
    "VerifiedGarbage.Spec.ChaCha20Poly1305",
    "VerifiedGarbage.Spec.MlKem",
    "VerifiedGarbage.Spec.Rsa.PrivatePrecompute",
    # ChaCha20's contracts, which proofs/Rind/X86_64/VgChaCha20.lean's
    # axioms restate over the spec they import: a pin that changes the
    # contracts shows the change in its diff, against which that re-pin must
    # review the axioms.
    "VerifiedGarbage.Spec.ChaCha20.Contract",
    # X25519's and Ed25519's specs, which proofs/Rind/X86_64/VgCurve25519.lean
    # states its axioms in, and the contracts those axioms restate.
    "VerifiedGarbage.Spec.X25519.Contract",
    "VerifiedGarbage.Spec.Ed25519.KeyPair",
    "VerifiedGarbage.Spec.Ed25519.ExpandedSign",
    # P-256's specs and the contracts of its public key, ECDH, and ECDSA
    # verification, which proofs/Rind/X86_64/VgP256.lean's axioms restate:
    # a re-pin that changes them shows the change in its diff.
    "VerifiedGarbage.Spec.EcKey.P256",
    "VerifiedGarbage.Spec.Ecdh.P256",
    "VerifiedGarbage.Spec.Ecdsa.Verify.P256",
    # PBKDF2-HMAC's contracts, over VG's SHA-1, SHA-2, and HMAC specs, which
    # proofs/Rind/VgPbkdf2.lean proves rind's.
    "VerifiedGarbage.Spec.Pbkdf2.Generic",
    # aarch64 ChaCha20-Poly1305's seal and open: the code (`Prog`) of each
    # as VG registers it, from VG's `Impl/` and not its proofs, and the
    # contracts, which proofs/Rind/Aarch64/VgChaCha20Poly1305Ct.lean states
    # `ConstantTime` of.
    "VerifiedGarbage.Impl.ChaCha20Poly1305.AArch64.Stitched",
    "VerifiedGarbage.Impl.StackScratch.AArch64",
    "VerifiedGarbage.Spec.ChaCha20Poly1305.Contract",
    # x86_64 P-256 ECDH with AVX512_IFMA: its code (`Prog`) as VG registers
    # it, `exchangeP256Ifma` and the clearing its registration adds, which
    # proofs/Rind/X86_64/VgP256Ct.lean states `ConstantTime` of.
    "VerifiedGarbage.Impl.Ecdh.P256.X86_64.Ifma",
    "VerifiedGarbage.Impl.Scrub.X86_64",
]

# P-256 over its prime field, `y^2 = x^3 - 3x + b`, and its generator, for
# the tables below (FIPS 186-5 / SP 800-186, section 3.2.1.3).
P256 = 2**256 - 2**224 + 2**192 + 2**96 - 1
P256_G = (
    0x6B17D1F2E12C4247F8BCE6E563A440F277037D812DEB33A0F4A13945D898C296,
    0x4FE342E2FE1A7F9B8EE7EB4A7C0F9E162BCE33576B315ECECBB6406837BF51F5,
)


def p256_add(p, q):
    """The affine sum of two points, neither the other's negative nor zero."""
    if p == q:
        slope = (3 * p[0] * p[0] - 3) * pow(2 * p[1], -1, P256)
    else:
        slope = (q[1] - p[1]) * pow(q[0] - p[0], -1, P256)
    x = (slope * slope - p[0] - q[0]) % P256
    return x, (slope * (p[0] - x) - p[1]) % P256


def p256_multiples(p, n):
    """`[m]p` for `m = 1 ... n`."""
    out = [p]
    while len(out) < n:
        out.append(p256_add(out[-1], p))
    return out


def p256_mul(k, p):
    r = None
    for bit in bin(k)[2:]:
        r = r and p256_add(r, r)
        if bit == "1":
            r = p256_add(r, p) if r else p
    return r


def nat_pairs(points):
    return "nat_pairs% [\n" + ",\n".join(f"  ({x}, {y})" for x, y in points) + "]\n"


HEADER = """module

public import VerifiedGarbage.Impl.NatPairs

/-!
# P-256: {title}

{doc}
-/

@[expose] public section

namespace VG.Impl.P256
"""


def comb_table7():
    """VG's `Impl/P256/CombTable7.lean`: `[m 2^(7j)]G`, `m = 1 ... 64`, `j < 37`."""
    out = HEADER.format(
        title="the 7-bit fixed-base comb's constant tables",
        doc="""Table `j < 37` holds `[m 2^(7j)]G` for `m = 1 … 64`, affine (entry `m - 1`), and
`p256Comb7Start` is `[64 Σ_{j < 37} 2^(7j)]G`, the comb's starting point, for
its digits `k_j - 64` of the scalar's 7-bit windows `k_j`. They were computed
with Python's integers (affine addition, with inverses by Fermat); the proof
(`Proof/P256/Comb7.lean`) checks every entry against the specification's
group law.""",
    )
    base = P256_G
    for j in range(37):
        out += f"\n/-- `[m 2^{7 * j}]G` for `m = 1 … 64`, affine (table {j}). -/\n"
        out += f"def p256Comb7T{j} : List (Nat × Nat) := " + nat_pairs(p256_multiples(base, 64))
        for _ in range(7):
            base = p256_add(base, base)
    out += "\n/-- `[m 2^(7j)]G` for `m = 1 … 64` (entry `m - 1` of table `j`), affine. -/\n"
    out += "def p256Comb7 : List (List (Nat × Nat)) := [\n"
    out += ",\n".join(f"  p256Comb7T{j}" for j in range(37)) + "]\n"
    x, y = p256_mul(64 * sum(2 ** (7 * j) for j in range(37)), P256_G)
    out += "\n/-- `[64 Σ_{j < 37} 2^(7j)]G`, affine. -/\n"
    out += f"def p256Comb7Start : Nat × Nat :=\n  ({x}, {y})\n\nend VG.Impl.P256\n"
    return out


def g_table9():
    """VG's `Impl/P256/GTable9.lean`: `[m]G`, `m = 1 ... 256`."""
    out = HEADER.format(
        title="the table of the verifier's generator digits",
        doc="""`p256G9` holds one table of `[m]G` for `m = 1 … 256`, affine (entry `m - 1`), and
`p256G9Start` is `[256]G`: the shape of a comb (`CombOkW`) of one
window of nine bits, whose odd entries the verifier's signed digits of width
nine index. They were computed with Python's integers (affine addition, with
inverses by Fermat); the proof (`Proof/P256/GTable9.lean`) checks every
entry against the specification's group law.""",
    )
    out += "\n/-- `[m]G` for `m = 1 … 256`, affine. -/\n"
    out += "def p256G9T0 : List (Nat × Nat) := " + nat_pairs(p256_multiples(P256_G, 256))
    out += "\n/-- `[m]G` for `m = 1 … 256` (entry `m - 1` of its one table), affine. -/\n"
    out += "def p256G9 : List (List (Nat × Nat)) := [p256G9T0]\n"
    x, y = p256_mul(256, P256_G)
    out += f"\n/-- `[256]G`, affine. -/\ndef p256G9Start : Nat × Nat :=\n  ({x}, {y})\n\nend VG.Impl.P256\n"
    return out


# The modules this writes rather than copies: 2,829 lines of VG's that the
# P-256 code's modules import, from the arithmetic above.
TABLES = {
    "VerifiedGarbage.Impl.P256.CombTable7": comb_table7,
    "VerifiedGarbage.Impl.P256.GTable9": g_table9,
}

IMPORT = re.compile(r"^(?:public )?(?:meta )?import (VerifiedGarbage\.[A-Za-z0-9_.]+)\b", re.M)


def path_of(module):
    return os.path.join(*module.split(".")) + ".lean"


def main():
    args = sys.argv[1:]
    if args == ["--tables"]:
        for module, table in TABLES.items():
            dest = os.path.join(DEST, path_of(module))
            os.makedirs(os.path.dirname(dest), exist_ok=True)
            with open(dest, "w") as f:
                f.write(table())
        return
    check = args[:1] == ["--check"]
    if check:
        args = args[1:]
    if len(args) != 1:
        sys.exit(__doc__.strip().split("\n\n")[1])
    clone = args[0]

    want = {}
    todo = list(ROOTS)
    while todo:
        module = todo.pop()
        if module in want:
            continue
        want[module] = subprocess.run(
            ["git", "--no-replace-objects", "-C", clone, "show", f"{REV}:lean/{path_of(module)}"],
            check=True, stdout=subprocess.PIPE,
        ).stdout
        todo += IMPORT.findall(want[module].decode())

    if missing := sorted(set(TABLES) - set(want)):
        sys.exit(f"admin/import-vg-models: no root imports {', '.join(missing)}: drop it from TABLES")

    have = set()
    for d, _, files in os.walk(os.path.join(DEST, "VerifiedGarbage")):
        for name in files:
            have.add(os.path.relpath(os.path.join(d, name), DEST))

    stale = []
    for module, text in sorted(want.items()):
        rel = path_of(module)
        dest = os.path.join(DEST, rel)
        if module in TABLES:
            if TABLES[module]().encode() != text:
                sys.exit(f"admin/import-vg-models: --tables does not write VG's {rel} at {REV}")
            # `--tables` writes it, and git ignores it.
            have.discard(rel)
            continue
        if rel in have:
            have.remove(rel)
            with open(dest, "rb") as f:
                if f.read() == text:
                    continue
        stale.append(rel)
        if not check:
            os.makedirs(os.path.dirname(dest), exist_ok=True)
            with open(dest, "wb") as f:
                f.write(text)
    for rel in sorted(have):
        stale.append(rel)
        if not check:
            os.remove(os.path.join(DEST, rel))

    if check and stale:
        for rel in stale:
            print(f"admin/import-vg-models: proofs/verified-garbage/{rel} is not VG's at {REV}", file=sys.stderr)
        sys.exit(1)
    print(f"admin/import-vg-models: {len(want)} modules of VG at {REV}" + ("" if check else f", {len(stale)} changed"))


main()

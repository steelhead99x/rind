diff --git a/rind-bench/examples/armv7_probe.rs b/rind-bench/examples/armv7_probe.rs
new file mode 100644
index 000000000..0afd981f6
--- /dev/null
+++ b/rind-bench/examples/armv7_probe.rs
@@ -0,0 +1,56 @@
+use std::time::Instant;
+
+fn t<F: FnMut() + ?Sized>(name: &str, bytes: usize, f: &mut F) {
+    for _ in 0..200 {
+        f();
+    }
+    let mut best = f64::MAX;
+    for _ in 0..9 {
+        let n = 3000usize;
+        let s = Instant::now();
+        for _ in 0..n {
+            f();
+        }
+        best = best.min(s.elapsed().as_nanos() as f64 / n as f64);
+    }
+    let cpb = if bytes > 0 { best * 1.69 / bytes as f64 } else { 0.0 };
+    println!("PROBE {name:42} {best:10.1} ns {cpb:7.2} cpb@1.69GHz");
+}
+
+fn main() {
+    let src = vec![7u8; 16384];
+    let mut buf = vec![0u8; 16384];
+    t("memcpy 16KB", 16384, &mut || {
+        buf.copy_from_slice(std::hint::black_box(&src));
+        std::hint::black_box(&buf);
+    });
+    for (name, bytes, mut f) in rind::__probe::cases() {
+        t(&name, bytes, &mut *f);
+    }
+    // OpenSSL's raw ChaCha20 and Poly1305 for the same sizes.
+    #[cfg(feature = "__bench_openssl")]
+    {
+        use openssl::pkey::PKey;
+        use openssl::sign::Signer;
+        use openssl::symm::{Cipher, Crypter, Mode};
+        let key = [9u8; 32];
+        for len in [64usize, 192, 1350, 16384] {
+            let input = vec![1u8; len];
+            let mut out = vec![0u8; len + 32];
+            t(&format!("openssl chacha20 {len}B"), len, &mut || {
+                let mut c = Crypter::new(Cipher::chacha20(), Mode::Encrypt, &key, Some(&[0u8; 16])).unwrap();
+                let n = c.update(&input, &mut out).unwrap();
+                std::hint::black_box(n);
+            });
+        }
+        for len in [32usize, 1350, 16384] {
+            let msg = vec![3u8; len];
+            t(&format!("openssl poly1305 {len}B"), len, &mut || {
+                let k = PKey::private_key_from_raw_bytes(&key, openssl::pkey::Id::POLY1305).unwrap();
+                let mut s = Signer::new_without_digest(&k).unwrap();
+                s.update(&msg).unwrap();
+                std::hint::black_box(s.sign_to_vec().unwrap());
+            });
+        }
+    }
+}
diff --git a/rind/src/lib.rs b/rind/src/lib.rs
index 6fd3d7a87..673f6753b 100644
--- a/rind/src/lib.rs
+++ b/rind/src/lib.rs
@@ -912,3 +912,46 @@ pub mod rand {
         SystemRandom.fill(out)
     }
 }
+
+/// SCRATCH PROBE (not for the PR): armv7 components, as closures for rind-bench's example to time.
+#[doc(hidden)]
+#[cfg(rind_backend = "arm")]
+pub mod __probe {
+    extern crate alloc;
+    use crate::low;
+    use alloc::boxed::Box;
+    use alloc::string::String;
+    use alloc::format;
+    use alloc::vec;
+    use alloc::vec::Vec;
+    use core::hint::black_box;
+    pub type Case = (String, usize, Box<dyn FnMut()>);
+    pub fn cases() -> Vec<Case> {
+        let mut v: Vec<Case> = Vec::new();
+        let key = [9u8; 32];
+        for len in [64usize, 128, 191, 192, 256, 1350, 16384] {
+            let mut b = vec![1u8; len];
+            v.push((format!("chacha20 (rind dispatch) {len}B"), len, Box::new(move || { let mut c = low::chacha20::ChaCha20::new(&key, &[0u8; 16]); c.cipher(&mut b); black_box(&b); })));
+        }
+        v.push(("chacha20_block generic (HACL rounds) 64B".into(), 64, Box::new(move || { black_box(low::chacha20_block(&key, black_box(&[0u8; 16]))); })));
+        let mut pk = [0u8; 32];
+        v.push(("chacha20 poly-key (new+cipher 32B nohw)".into(), 32, Box::new(move || { let mut c = low::chacha20::ChaCha20::new(&key, &[0u8; 16]); c.cipher(&mut pk); black_box(&pk); })));
+        v.push(("chacha20 init only".into(), 0, Box::new(move || { let c = low::chacha20::ChaCha20::new(&key, &[0u8; 16]); black_box(&c); })));
+        for len in [32usize, 1350, 16384] {
+            let msg = vec![3u8; len];
+            let m2 = msg.clone();
+            v.push((format!("poly1305 neon new+add+finish {len}B"), len, Box::new(move || { let mut p = low::poly1305::Poly1305::new(&key); p.add_bytes(&msg); black_box(p.finish()); })));
+            v.push((format!("poly1305 hacl new+add+finish {len}B"), len, Box::new(move || { let mut p = low::portable::poly1305::Hacl::new(&key); p.add_bytes(&m2); black_box(p.finish()); })));
+        }
+        if let Some(tok) = low::HaveCryptoExt::check() {
+            let k = low::AesHwKey::new(&[1u8; 16], tok);
+            let g = low::GhashTable::new(&[2u8; 16], tok);
+            let mut blocks = vec![[0u8; 16]; 1024];
+            let mut blocks2 = blocks.clone();
+            v.push(("aes128 ctr32 16KB".into(), 16384, Box::new(move || { k.ctr32(&[0u8; 16], &mut blocks); black_box(&blocks); })));
+            let mut xi = [0u8; 16];
+            v.push(("ghash 16KB".into(), 16384, Box::new(move || { g.ghash(&mut xi, &blocks2); black_box(&xi); blocks2[0][0] ^= 1; })));
+        }
+        v
+    }
+}

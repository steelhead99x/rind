#!/usr/bin/env python3

# Usage: admin/ct-binsec [--target TARGET] [--timeout SECONDS] [--exact] [filter...]
#
# The symbolic constant-time check (see `rind/src/low/ct_binsec.rs`). For
# each rind test named `ct_binsec...` whose name contains a `filter`, or with
# `--exact` is one past its module path, this stops the release test
# binary under gdb as it enters the test's checked region, dumps the
# process, and has BINSEC's checkct explore the region
# from that dump, with every byte rind marks secret taking every value at
# once. It fails unless BINSEC proves that no branch, memory address,
# divisor, or dividend depends on a secret, over every path the region
# takes, to the end of each of its loops.
#
# The `ct_binsec_planted_...` tests leak, and run every time. BINSEC must
# report them insecure, so a harness that checks nothing fails.
#
# The dump fixes everything else, such as the CPU features rind detected,
# so a run checks the paths the host's CPU takes, short of the features in
# `UNDECODED`, whose instructions BINSEC cannot read and which this denies
# through `--cfg rind_cpu_disable`, as `admin/ctgrind`'s jobs deny theirs.
# `RIND_CPU_DISABLE_*` in the environment denies more.
#
# Run it in `nix develop .#binsec`.

import argparse, functools, json, os, re, struct, subprocess, sys, tempfile, time

# What gdb runs in the test: stop at the region, make the thread's stack
# readable, dump the process, record each value the region declassifies,
# then let the test finish, and refuse a second region, which BINSEC would
# never see.
GDB = r"""
import gdb, os
gdb.execute("set pagination off")
gdb.execute("set confirm off")
# At each marker's first instruction, not past its prologue, where gdb
# would break by name, and where `$pc` would not be the marker's address.
gdb.execute("break *rind_ct_binsec_start")
gdb.execute("run")
if not gdb.selected_thread() or not gdb.selected_thread().is_valid():
    raise gdb.GdbError("ct-binsec: the test never entered its region")
pid = gdb.selected_inferior().pid
sp = int(gdb.parse_and_eval("(unsigned long)$sp"))
# glibc marks a thread stack's guard pages with MADV_GUARD_INSTALL, inside
# the stack's own mapping, so gdb fails to read the mapping and dumps it
# empty. MADV_GUARD_REMOVE (103) lifts them; on an older kernel the call
# fails, and the guard is a mapping of its own.
# See UPSTREAM.md, "gdb dumps a guarded thread stack empty".
for line in open("/proc/{}/maps".format(pid)):
    lo, hi = (int(x, 16) for x in line.split()[0].split("-"))
    if lo <= sp < hi:
        gdb.parse_and_eval("(int)madvise({}, {}, 103)".format(lo, hi - lo))
for sym in SYMBOLS:
    where = gdb.execute("info address " + sym, to_string=True)
    print("SYMBOL {} {}".format(sym, where.split(" is at ")[1].split()[0]))
# The core lists the signalled thread first: this one.
gdb.execute("queue-signal SIGUSR1")
gdb.execute("generate-core-file " + CORE)
gdb.execute("queue-signal 0")
# The test binary binds every symbol at load, so its GOT holds the function
# glibc picked for each, which its own calls into glibc take too.
exe = os.path.realpath(gdb.current_progspace().filename)
for line in open("/proc/{}/maps".format(pid)):
    fields = line.split()
    if len(fields) == 6 and fields[2] == "00000000" and os.path.realpath(fields[5]) == exe:
        base = int(fields[0].split("-")[0], 16)
        break
for name, got in GOT.items():
    print("LIBC {} {:#x}".format(name, int(gdb.parse_and_eval("*(unsigned long *){}".format(base + got)))))
for line in open("/proc/{}/maps".format(pid)):
    if os.path.basename(line.split()[-1]).startswith("libc.so"):
        print("FILE " + line.split()[-1])
        break
arch = gdb.selected_frame().architecture().name()
if arch == "aarch64":
    print("TPIDR {:#x}".format(int(gdb.parse_and_eval("(unsigned long)$tpidr"))))
args = {"i386:x86-64": ("$rdi", "$rsi"), "aarch64": ("$x0", "$x1"), "arm": ("$r0", "$r1")}[arch]
public = gdb.Breakpoint("*rind_ct_binsec_public", internal=True)
stop = gdb.Breakpoint("*rind_ct_binsec_stop", internal=True)
while True:
    gdb.execute("continue")
    if not gdb.selected_inferior().pid:
        raise gdb.GdbError("ct-binsec: the test left its region without stopping")
    pc = int(gdb.parse_and_eval("(unsigned long)$pc"))
    if pc == int(gdb.parse_and_eval("(unsigned long)&rind_ct_binsec_stop")):
        break
    value, size = (int(gdb.parse_and_eval("(unsigned long)" + a)) for a in args)
    print("PUBLIC " + bytes(gdb.selected_inferior().read_memory(value, size)).hex())
public.delete()
stop.delete()
gdb.execute("continue")
if gdb.selected_inferior().pid:
    raise gdb.GdbError("ct-binsec: the test entered a second region")
print("EXIT {}".format(int(gdb.parse_and_eval("$_exitcode"))))
"""

# The features each target's code uses instructions of that BINSEC 0.11
# cannot decode, so their paths stay with `admin/ctgrind`, `admin/ct-sde`,
# and `admin/ct-qemu`: on x86_64, AES-NI, VAES, the SHA512 instructions, and
# every EVEX encoding; on aarch64, the crypto extension's AES, PMULL, and
# SHA instructions, SHA3's, and the `msr` that sets DIT. Denying AES leaves
# vpaes, whose `tbl` the script stubs.
# See UPSTREAM.md, "BINSEC cannot decode much of what rind runs".
UNDECODED = {
    "x86_64": ["aes", "vaes", "sha512", "avx512f", "avx512dq", "avx512ifma", "avx512bw"]
    + ["avx512vl", "avx512vbmi", "avx512vbmi2"],
    "aarch64": ["aes", "pmull", "sha2", "sha3", "dit"],
}

# glibc picks each of these for the runner's CPU, such as an EVEX one with
# AVX-512, a TSX one that runs `xtest`, or aarch64's SVE one, which BINSEC
# cannot decode, so the script replaces whichever it picked with a byte loop,
# as valgrind replaces them.
# See UPSTREAM.md, "BINSEC cannot decode glibc's string functions".
LIBC = ["memcpy", "memmove", "memset", "memcmp", "bcmp"]

# Instructions BINSEC cannot decode, but whose effect on its state is short
# enough to give it, by mnemonic: each takes objdump's operands and returns
# the statement for that encoding, or None for a form it does not know,
# where BINSEC still stops. The script stubs each encoding of these that the
# test binary and glibc hold, since BINSEC matches an opcode byte for byte.
# s2n-bignum's P-521 code sets the carry with `stc`, LLVM tests the portable
# P-256 and P-384 for zero with `movmskps`, and loads and stores rind's AVX2
# ChaCha20 state with `vinsertf128` and `vpermpd`, and aws-lc's AVX2 ML-DSA
# moves lanes with `vmovshdup` and samples with `vmovmskps`. glibc's `malloc`
# reads the thread pointer with `mrs`, vpaes and aws-lc's NEON ChaCha20 look
# up bytes with `tbl`, ML-KEM's rejection sampling counts bits with `cnt`,
# and s2n-bignum's narrow X25519 selects a lane with `fcsel`.
# See UPSTREAM.md, "BINSEC cannot decode instructions `admin/ct-binsec` stubs".
GP = {"e" + r[1:]: r for r in ["rax", "rcx", "rdx", "rbx", "rsp", "rbp", "rsi", "rdi"]}
GP.update(("r{}d".format(n), "r{}".format(n)) for n in range(8, 16))


def movmskps(ops, _):
    """The sign bit of each 32-bit lane."""
    src, dst = (o.lstrip("%") for o in ops)
    if not re.fullmatch(r"[xy]mm\d+", src) or dst not in GP:
        return None
    lanes = 8 if src[0] == "y" else 4
    bits = " :: ".join("{}{{{}}}".format(src, 32 * i + 31) for i in reversed(range(lanes)))
    return "{} := uext64 ({})".format(GP[dst], bits)


def vinsertf128(ops, _):
    """The 128 bits of `src` over the half of `low` the immediate selects."""
    imm, src, low, dst = ops
    if not imm.startswith("$") or not all(o.startswith("%") for o in (src, low, dst)):
        return None
    src, low, dst = (o.lstrip("%") for o in (src, low, dst))
    if int(imm[1:], 16) & 1:
        return "{} := {} :: {}{{127..0}}".format(dst, src, low)
    return "{} := {}{{255..128}} :: {}".format(dst, low, src)


def vpermpd(ops, _):
    """Each 64-bit lane of `dst` takes the lane of `src` its two bits of the
    immediate select."""
    imm, src, dst = ops
    if not imm.startswith("$") or not all(o.startswith("%ymm") for o in (src, dst)):
        return None
    imm, src, dst = int(imm[1:], 16), src.lstrip("%"), dst.lstrip("%")
    lanes = ("{}{{{}..{}}}".format(src, 64 * (imm >> 2 * i & 3) + 63, 64 * (imm >> 2 * i & 3)) for i in range(4))
    return "{} := {}".format(dst, " :: ".join(reversed(list(lanes))))


def vmovshdup(ops, _):
    """Each odd 32-bit lane of `src`, into itself and the lane below. The
    128-bit form zeroes the upper half of the `ymm` register, which BINSEC's
    `xmm` names only the lower half of."""
    src, dst = ops
    m = re.fullmatch(r"%([xy])mm(\d+)", src)
    d = re.fullmatch(r"%{}mm(\d+)".format(m[1]), dst) if m else None
    if not d:
        return None
    src = src.lstrip("%")
    lanes = 8 if m[1] == "y" else 4
    odd = ["{}{{{}..{}}}".format(src, 64 * i + 63, 64 * i + 32) for i in reversed(range(lanes // 2))]
    out = " :: ".join(o + " :: " + o for o in odd)
    return "ymm{} := {}{}".format(d[1], "0<128> :: " if lanes == 4 else "", out)


def mrs(ops, tpidr):
    """The thread pointer gdb read."""
    dst, reg = ops
    if reg != "tpidr_el0" or not re.fullmatch(r"x([0-9]|[12][0-9]|30)", dst):
        return None
    return "{} := {:#x}".format(dst, tpidr)


def tbl(ops, _):
    """Each lane takes the table's byte its index selects, or 0 past the
    table's end, as a shift of the whole table, which a secret index cannot
    turn into a branch or an address."""
    m = re.fullmatch(r"v(\d+)\.(8|16)b, \{(.*)\}, v(\d+)\.(?:8|16)b", ", ".join(ops))
    if not m:
        return None
    dst, lanes, index = int(m[1]), int(m[2]), int(m[4])
    # objdump lists the table's registers one by one, or as a range, which
    # wraps from v31 to v0.
    table = [int(r) for r in re.findall(r"v(\d+)\.16b", m[3])]
    if "-" in m[3]:
        table = [(table[0] + i) % 32 for i in range((table[1] - table[0]) % 32 + 1)]
    bits = 128 * len(table)
    table = " :: ".join("q{}".format(t) for t in reversed(table))
    out = [
        "(({}) lsr uext{} (q{}{{{}..{}}} :: 0<3>)){{7..0}}".format(table, bits, index, 8 * i + 7, 8 * i)
        for i in reversed(range(lanes))
    ]
    if lanes == 8:
        out.insert(0, "0<64>")
    return "q{} := {}".format(dst, " :: ".join(out))


def fcsel(ops, _):
    """Select one scalar FP register from the flags and zero the rest of its
    Q register. BINSEC decodes `fcsel` and then stops, because its DBA has no
    execute for it. The select is a mux of the flags, so this is an `ite`,
    not a jump: a statement `if` would be a branch `checkct` instruments."""
    letters = {"d": 64, "s": 32, "h": 16}
    if len(ops) != 4:
        return None
    parsed = []
    for reg in ops[:3]:
        match = re.fullmatch(r"([dsh])([0-9]|[12][0-9]|3[01])", reg)
        if not match:
            return None
        parsed.append(match)
    if len({item[1] for item in parsed}) != 1:
        return None
    cond = {
        "eq": "z",
        "ne": "!z",
        "cs": "c",
        "hs": "c",
        "cc": "!c",
        "lo": "!c",
        "mi": "n",
        "pl": "!n",
        "vs": "v",
        "vc": "!v",
        "hi": "(c && !z)",
        "ls": "(!c || z)",
        "ge": "(n = v)",
        "lt": "(n <> v)",
        "gt": "(!z && (n = v))",
        "le": "(z || (n <> v))",
        "al": "true",
        "nv": "true",
    }.get(ops[3])
    if cond is None:
        return None
    # `::` binds tighter than `? :`, so the select stays in the low lane.
    high = 128 - letters[parsed[0][1]]
    return "q{} := 0<{}> :: ({} ? {} : {})".format(
        parsed[0][2], high, cond, parsed[1][0], parsed[2][0]
    )


def cnt(ops, _):
    """Each lane's count of set bits."""
    m = re.fullmatch(r"v(\d+)\.(8|16)b, v(\d+)\.(?:8|16)b", ", ".join(ops))
    if not m:
        return None
    dst, lanes, src = int(m[1]), int(m[2]), int(m[3])
    out = [
        "({})".format(" + ".join("uext8 q{}{{{}}}".format(src, 8 * i + b) for b in range(8)))
        for i in reversed(range(lanes))
    ]
    if lanes == 8:
        out.insert(0, "0<64>")
    return "q{} := {}".format(dst, " :: ".join(out))


STUBS = {
    "x86_64": {"stc": lambda *_: "cf := true", "clc": lambda *_: "cf := false"}
    | {"movmskps": movmskps, "vmovmskps": movmskps, "vinsertf128": vinsertf128, "vpermpd": vpermpd, "vmovshdup": vmovshdup},
    "aarch64": {"mrs": mrs, "tbl": tbl, "cnt": cnt, "fcsel": fcsel},
}


@functools.cache
def disassembly(target, path):
    """Each distinct encoding in `path` of a mnemonic in `STUBS`, with its
    mnemonic and operands."""
    handlers = STUBS.get(arch(target), {})
    out = subprocess.run(
        ["objdump", "-d", "--insn-width=16", "--no-addresses", path],
        stdout=subprocess.PIPE,
        check=True,
        encoding="utf-8",
    ).stdout
    found = {}
    for line in out.splitlines():
        fields = line.strip().split("\t")
        if len(fields) < 2:
            continue
        # aarch64's objdump puts a tab between mnemonic and operands, and
        # each target ends a line with a comment or a symbol.
        text = re.split(r"\s+(?://|# |<)", " ".join(fields[1:]))[0].split(None, 1)
        if not text or text[0] not in handlers:
            continue
        # Operands split at commas outside a register list or memory operand.
        ops = re.split(r",\s*(?![^{(]*[})])", text[1].strip()) if len(text) > 1 else []
        # aarch64's objdump prints each instruction as a little-endian word.
        opcode = bytes.fromhex(fields[0].replace(" ", ""))
        if arch(target) == "aarch64":
            opcode = opcode[::-1]
        found.setdefault(opcode, (text[0], ops))
    return found


def stubs(target, files, tpidr):
    """The `replace opcode` stub of each encoding in `files` of a mnemonic in
    `STUBS`."""
    handlers = STUBS.get(arch(target), {})
    found = {}
    for path in files:
        for opcode, (mnemonic, ops) in disassembly(target, path).items():
            found.setdefault(opcode, handlers[mnemonic](ops, tpidr))
    return "".join(
        "\nreplace opcode {} by\n  {}\nend\n".format(opcode.hex(" "), stmt.replace("\n", "\n  "))
        for opcode, stmt in found.items()
        if stmt
    )


# Each function in `LIBC` as a byte loop, which reads and writes only the
# bytes it is given and returns from a comparison at the first byte that
# differs. `libc_i` is the script's loop counter.
LIBC_STUBS = {
    "memmove": """
replace {addr:#x} (dst, src, len) by
  if dst <=u src then
    libc_i := 0
    while libc_i <u len do
      @[dst + libc_i] := @[src + libc_i]
      libc_i := libc_i + 1
    end
  else
    libc_i := len
    while libc_i <> 0 do
      libc_i := libc_i - 1
      @[dst + libc_i] := @[src + libc_i]
    end
  end
  return dst
end
""",
    "memset": """
replace {addr:#x} (dst, byte, len) by
  libc_i := 0
  while libc_i <u len do
    @[dst + libc_i] := byte{{7..0}}
    libc_i := libc_i + 1
  end
  return dst
end
""",
    "memcmp": """
replace {addr:#x} (a, b, len) by
  libc_i := 0
  while libc_i <u len do
    if @[a + libc_i] <> @[b + libc_i] then
      return uext{word} @[a + libc_i] - uext{word} @[b + libc_i]
    end
    libc_i := libc_i + 1
  end
  return 0
end
""",
}
LIBC_STUBS["memcpy"] = LIBC_STUBS["memmove"]
LIBC_STUBS["bcmp"] = LIBC_STUBS["memcmp"]

# NT_PRPSINFO, NT_AUXV, and NT_FILE, which describe the process.
PROCESS_NOTES = {3, 6, 0x46494C45}
NT_PRSTATUS = 1

# Each target's word size, for the script's loop counters.
WORD = {"x86_64": 64, "aarch64": 64, "arm": 32}

# A path that panics ends where the panic begins, as one may where a value
# declassified afresh lets it.
SYMBOLS = ["rind_ct_binsec_stop", "rind_ct_binsec_secret", "rind_ct_binsec_public", "rind_ct_binsec_length"]
SYMBOLS += ["getrandom", "free", "mprotect", "__rustc::rust_begin_unwind"]

# BINSEC replaces the secret marker with fresh secret bytes, and glibc's
# getrandom, which rind's random bytes come from, with secret ones too,
# since the kernel's call is opaque to it. The public marker writes back the
# value the real run declassified there, in order, as valgrind's run keeps
# it: a fresh public value would have BINSEC search every public value as
# well, such as each ML-KEM matrix seed, which it cannot do in time. A path
# that declassifies more than the real run did gets fresh public values.
# glibc's free does nothing, as under valgrind, which replaces it: its
# double-free check compares the freed bytes with a key, and they may be
# secret. So `malloc` takes fresh memory where the real run reused freed
# blocks, growing a thread's heap with `mprotect`, whose system call BINSEC
# cannot make: it succeeds without one. See UPSTREAM.md, "BINSEC cannot
# decode instructions `admin/ct-binsec` stubs".
SCRIPT = """\
starting from core with
  declassified<{word}> := 0
  libc_i<{word}> := 0
  length<{word}> := 0
end

{stubs}
replace {secret:#x} (value, len) by
  for i<{word}> in 0 to len - 1 do
    @[value + i] := secret
  end
  return
end

replace {public:#x} (value, len) by
{declassify}  declassified := declassified + 1
  return
end

replace {length:#x} (max) by
  length := nondet
  assume length <=u max
  return length
end

replace {getrandom:#x} (buf, len, flags) by
  for i<{word}> in 0 to len - 1 do
    @[buf + i] := secret
  end
  return len
end

replace {free:#x} (ptr) by
  return
end

replace {mprotect:#x} (addr, len, prot) by
  return 0
end
{libc}
halt at {stop:#x}
halt at {panic:#x}
explore all
"""


def arch(target):
    return target.split("-")[0]


def host():
    out = subprocess.run(["rustc", "-vV"], stdout=subprocess.PIPE, check=True, encoding="utf-8").stdout
    return re.search(r"^host: (\S+)$", out, re.M)[1]


def build(target):
    os.environ["RUSTFLAGS"] = (os.environ.get("RUSTFLAGS", "") + " --cfg rind_cpu_disable").strip()
    for feature in UNDECODED.get(arch(target), []):
        os.environ["RIND_CPU_DISABLE_" + feature] = "1"
    out = subprocess.run(
        ["cargo", "test", "-p", "rind", "--lib", "--release", "--no-run"]
        + ["--target", target, "--message-format=json-render-diagnostics"],
        stdout=subprocess.PIPE,
        check=True,
        encoding="utf-8",
    ).stdout
    for line in out.splitlines():
        js = json.loads(line)
        if js.get("reason") == "compiler-artifact" and js.get("executable"):
            if js["target"]["name"] == "rind":
                return js["executable"]
    sys.exit("ct-binsec: no rind test binary")


def tests(exe, filters, exact):
    out = subprocess.run(
        [exe, "--list", "--ignored", "--format", "terse"],
        stdout=subprocess.PIPE,
        check=True,
        encoding="utf-8",
    ).stdout
    names = [line.removesuffix(": test") for line in out.splitlines()]
    names = [n for n in names if n.split("::")[-1].startswith("ct_binsec")]
    planted = [n for n in names if is_planted(n)]
    chosen = [n for n in names if any(n.split("::")[-1] == f if exact else f in n for f in filters)]
    return planted + [n for n in chosen if not is_planted(n)]


def is_planted(name):
    return name.split("::")[-1].startswith("ct_binsec_planted")


def dump(exe, name, target, tmp):
    """Runs `name` under gdb, dumping it at its region into `tmp`, and
    returns the core's path, the addresses of the markers and of the
    functions in `LIBC` glibc picked, the values the region declassified,
    and the stubs of the instructions BINSEC cannot decode."""
    got = got_offsets(exe)
    core = os.path.join(tmp, "core")
    script = os.path.join(tmp, "dump.py")
    with open(script, "w") as f:
        f.write("CORE = {!r}\nSYMBOLS = {!r}\nGOT = {!r}\n".format(core, SYMBOLS, got) + GDB)
    cmd = ["gdb", "-batch", "-nx", "-x", script, "--args", exe]
    cmd += ["--ignored", "--exact", name, "--test-threads=1", "-q"]
    out = subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, encoding="utf-8").stdout
    symbols = dict((m[1], int(m[2], 16)) for m in re.finditer(r"^SYMBOL (\S+) (\S+)$", out, re.M))
    libc = dict((m[1], int(m[2], 16)) for m in re.finditer(r"^LIBC (\S+) (\S+)$", out, re.M))
    public = [bytes.fromhex(m) for m in re.findall(r"^PUBLIC ([0-9a-f]*)$", out, re.M)]
    libc_file = re.search(r"^FILE (.+)$", out, re.M)
    tpidr = re.search(r"^TPIDR (\S+)$", out, re.M)
    exit = re.search(r"^EXIT (\d+)$", out, re.M)
    if len(set(symbols.values())) != len(SYMBOLS) or len(libc) != len(got):
        sys.exit("ct-binsec: {} failed under gdb:\n{}".format(name, out))
    if not exit or exit[1] != "0" or not libc_file or not os.path.exists(core):
        sys.exit("ct-binsec: {} failed under gdb:\n{}".format(name, out))
    keep_first_thread(core)
    stubbed = stubs(target, [exe, libc_file[1]], int(tpidr[1], 16) if tpidr else None)
    return core, symbols, libc, public, stubbed


def got_offsets(exe):
    """The offset of the GOT entry of each function in `LIBC` the test binary
    imports."""
    out = subprocess.run(["readelf", "-dW", exe], stdout=subprocess.PIPE, check=True, encoding="utf-8").stdout
    if not re.search(r"\(FLAGS\)\s+.*\bBIND_NOW\b", out):
        sys.exit("ct-binsec: the test binary binds lazily, so its GOT may not hold glibc's picks")
    out = subprocess.run(["readelf", "-rW", exe], stdout=subprocess.PIPE, check=True, encoding="utf-8").stdout
    got = {}
    for m in re.finditer(r"^([0-9a-f]+) +[0-9a-f]+ +R_\w+_(?:GLOB_DAT|JUMP_SLOT) +[0-9a-f]+ +(\w+)@", out, re.M):
        if m[2] in LIBC:
            got.setdefault(m[2], int(m[1], 16))
    return got


def keep_first_thread(path):
    """BINSEC starts from the registers of the core's last thread, and gdb
    lists the stopped thread first, so this renames every later thread's
    notes to a type BINSEC ignores."""
    with open(path, "r+b") as f:
        data = bytearray(f.read())
        wide = data[4] == 2
        if wide:
            (phoff,) = struct.unpack_from("<Q", data, 0x20)
            phentsize, phnum = struct.unpack_from("<HH", data, 0x36)
        else:
            (phoff,) = struct.unpack_from("<I", data, 0x1C)
            phentsize, phnum = struct.unpack_from("<HH", data, 0x2A)
        threads = 0
        for i in range(phnum):
            at = phoff + i * phentsize
            if wide:
                kind, _, offset, _, _, size = struct.unpack_from("<IIQQQQ", data, at)
            else:
                kind, offset, _, _, size = struct.unpack_from("<IIIII", data, at)
            if kind != 4:  # PT_NOTE
                continue
            note = offset
            while note < offset + size:
                namesz, descsz, kind = struct.unpack_from("<III", data, note)
                threads += kind == NT_PRSTATUS
                if threads > 1 and kind not in PROCESS_NOTES:
                    struct.pack_into("<I", data, note + 8, 0x7FFFFFFF)
                note += 12 + (namesz + 3 & ~3) + (descsz + 3 & ~3)
        f.seek(0)
        f.write(data)


def check(exe, name, target, timeout, tmp):
    """Returns BINSEC's verdict on `name`'s region, and its log."""
    core, symbols, libc, public, stubbed = dump(exe, name, target, tmp)
    word = WORD[arch(target)]
    stubs = {}
    for fn, addr in libc.items():
        # glibc may pick one function for memcpy and memmove, or for memcmp
        # and bcmp, whose stubs are the same, and BINSEC takes one per address.
        stubs[addr] = LIBC_STUBS[fn].format(addr=addr, word=word)
    declassify = ""
    for i, value in enumerate(public):
        if value:
            # Little-endian, as the target stores it.
            declassify += "  if declassified = {} then\n".format(i)
            declassify += "    @[value, {}] := 0x{}\n  end\n".format(len(value), value[::-1].hex())
    declassify += "  if declassified >= {} then\n".format(len(public))
    declassify += "    for i<{}> in 0 to len - 1 do\n".format(word)
    declassify += "      @[value + i] := public\n    end\n  end\n"
    script = os.path.join(tmp, "check.ini")
    with open(script, "w") as f:
        f.write(
            SCRIPT.format(
                word=word,
                stubs=stubbed,
                libc="".join(stubs.values()),
                declassify=declassify,
                secret=symbols["rind_ct_binsec_secret"],
                public=symbols["rind_ct_binsec_public"],
                length=symbols["rind_ct_binsec_length"],
                getrandom=symbols["getrandom"],
                free=symbols["free"],
                mprotect=symbols["mprotect"],
                stop=symbols["rind_ct_binsec_stop"],
                panic=symbols["__rustc::rust_begin_unwind"],
            )
        )
    cmd = ["binsec", "-sse", "-sse-script", script, "-sse-depth", "1000000000"]
    if timeout:
        cmd += ["-sse-timeout", str(timeout)]
    cmd += ["-checkct", "-checkct-features", "control-flow,memory-access,dividend,divisor"]
    cmd += [core]
    run = subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, encoding="utf-8")
    log = run.stdout
    status = re.search(r"\[checkct:result\] Program status is : (\w+)", log)
    explored = re.search(r"\[checkct:info\] [1-9]\d* visited path", log)
    if status and status[1] == "insecure":
        # A leak found is a leak, even on a search cut short.
        verdict = "insecure"
    else:
        verdict = status[1] if status and run.returncode == 0 and explored else "failed"
    if verdict == "secure" and ("Exploration is incomplete" in log or "Cut path" in log):
        verdict = "unknown"
    return verdict, log, core


def findings(exe, core, log):
    """Each instruction BINSEC reports leaking, or where it cut a path short,
    with the function gdb places it in."""
    found = re.findall(r"Instruction (0x[0-9a-f]+) has (.*? leak)", log)
    found += [(addr, why) for why, addr in re.findall(r"Cut path \d+ (.*?) @ (0x[0-9a-f]+)", log)]
    if not found:
        return []
    cmd = ["gdb", "-batch", "-nx", exe, core]
    for addr, _ in found:
        cmd += ["-ex", "info symbol " + addr]
    out = subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, encoding="utf-8").stdout
    where = [line for line in out.splitlines() if " in section " in line or line.startswith("No symbol")]
    where += ["?"] * (len(found) - len(where))
    return ["{} {}: {}".format(addr, what, w) for (addr, what), w in zip(found, where)]


def main():
    sys.stdout.reconfigure(line_buffering=True)
    parser = argparse.ArgumentParser()
    parser.add_argument("--target", default=None)
    # A search cut short at this many seconds is incomplete, so it fails.
    parser.add_argument("--timeout", type=int, default=None)
    parser.add_argument("--exact", action="store_true")
    parser.add_argument("filter", nargs="*", default=[""])
    args = parser.parse_args()
    target = args.target or host()
    if target != host():
        sys.exit("ct-binsec: gdb runs the test natively, so the target must be the host's")

    exe = build(target)
    names = tests(exe, args.filter, args.exact)
    if all(is_planted(n) for n in names):
        sys.exit("ct-binsec: no ct_binsec test matches {}".format(" ".join(args.filter)))

    failed = False
    for name in names:
        with tempfile.TemporaryDirectory() as tmp:
            start = time.monotonic()
            verdict, log, core = check(exe, name, target, args.timeout, tmp)
            stats = re.findall(r"\[checkct:info\] (.*)", log)
            stats.append("{:.0f} s".format(time.monotonic() - start))
            if is_planted(name):
                ok = verdict == "insecure"
            else:
                ok = verdict == "secure"
            print("{} {}: {}; {}".format("ok  " if ok else "FAIL", name, verdict, "; ".join(stats)))
            if not ok:
                failed = True
                for finding in findings(exe, core, log):
                    print("    " + finding)
                if verdict != "insecure":
                    for line in log.splitlines()[-40:]:
                        print("    " + line)
    sys.exit(failed)


main()

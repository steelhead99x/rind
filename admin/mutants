#!/usr/bin/env bash
# Runs cargo-mutants (see .cargo/mutants.toml) on this host's architecture,
# passing its arguments through. It skips generated assembly, which proofs and
# differential tests own, and every module only another architecture compiles,
# whose mutants no test here can reach.
#
# `admin/mutants --target armv7-unknown-linux-gnueabihf ...`, in
# `nix develop .#armv7`, cross-builds for armv7 instead and runs each test
# binary under qemu-arm. It builds optimised, keeping a debug build's
# checks, since debug tests under qemu take about nine times as long.
#
# Each test runs on this CPU and again with each row of features below denied,
# so code only CPUs without them run, such as aws-lc's SSE2 AES, is tested
# too. The x86_64 and aarch64 rows are ctgrind.yml's; armv7's also pick
# qemu's CPU.
#
# `admin/mutants --avx512 ...`, on x86_64 in `nix develop .#sde`, runs each
# test under Intel SDE's Sapphire Rapids model instead, which takes every
# AVX-512 path, though no campaign host has one. Each mutant's tests take
# minutes there, so the other campaign leaves out the files only AVX-512
# runs, and this one retests what that one missed: give it `--iterate` over
# its `mutants.out`.
#
# cargo-mutants mutates code whatever its `cfg`, so a function only another
# architecture compiles is missed here. `admin/mutants --survivors DIR...`
# combines runs' `mutants.out` directories: it prints each mutant some run
# missed and none caught, and fails if there is one.
set -euo pipefail
here=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)

# Leading flags, in any order, so a conflicting pair is refused whichever
# comes first.
avx512=
target=
portable_run=
while [ $# -gt 0 ]; do
    case "$1" in
        --avx512)
            avx512=1
            shift
            ;;
        --portable)
            portable_run=1
            shift
            ;;
        --target)
            [ $# -ge 2 ] || {
                echo "admin/mutants: --target needs a triple" >&2
                exit 2
            }
            target=$2
            shift 2
            ;;
        *) break ;;
    esac
done
if [ -n "$portable_run" ]; then
    [ -z "$target" ] || {
        echo "admin/mutants: --portable does not combine with --target" >&2
        exit 1
    }
    [ -z "$avx512" ] || {
        echo "admin/mutants: --portable does not combine with --avx512" >&2
        exit 1
    }
fi

if [ "${1:-}" = --survivors ]; then
    shift
    # A run with no mutants to test, such as one over an empty diff, writes
    # none of these.
    list() {
        for dir in "$@"; do
            for outcome in "${outcomes[@]}"; do
                [ ! -f "$dir/$outcome.txt" ] || cat "$dir/$outcome.txt"
            done
        done
    }
    outcomes=(missed)
    missed=$(list "$@" | sort -u)
    outcomes=(caught timeout unviable)
    survivors=$(grep -vxF -f <(list "$@") <<<"$missed" || true)
    [ -z "$survivors" ] || {
        echo "$survivors"
        exit 1
    }
    exit 0
fi

# Only armv7 and the portable backend compile these.
portable=(
    'rind/src/low/portable/**' 'rind/src/mid/portable/**'
    rind/src/low/generic/order.rs
)
runner=()
profile=()
base=()
# Darwin runs only the DIT code, which compiles for Apple's platforms alone;
# the Linux runs cover the rest.
only=()
case ${target:-$(uname -sm)} in
    "Darwin arm64")
        triple=AARCH64_APPLE_DARWIN
        skip=()
        only=(
            --file rind/src/low/cpu.rs --file rind/src/low/aarch64/cpu.rs
            --re '(\bDit\b|enter_cpu_state|leave_cpu_state|\bdit::)'
        )
        rows=("dit")
        ;;
    "Linux x86_64")
        triple=X86_64_UNKNOWN_LINUX_GNU
        skip=(
            'rind/src/low/aarch64/**' 'rind/src/low/arm/**' "${portable[@]}"
            rind/src/low/generic/mlkem768.rs
        )
        [ -n "$avx512" ] || skip+=(
            rind/src/low/x86_64/mlkem768_sample_poly_ntt_8x.rs
            rind/src/low/x86_64/rsaz_avx512.rs
        )
        rows=(
            "adx vaes"
            "adx avx intel sha"
            "adx avx intel sha aes pclmulqdq sse41"
            "adx ssse3"
        )
        ;;
    "Linux aarch64")
        triple=AARCH64_UNKNOWN_LINUX_GNU
        skip=(
            'rind/src/low/x86_64/**' 'rind/src/low/arm/**' "${portable[@]}"
            rind/src/low/generic/mlkem_poly.rs
            rind/src/low/generic/sha1.rs rind/src/low/generic/sha256.rs
        )
        rows=(
            "sha3"
            "aes pmull sha2 sha3"
        )
        ;;
    armv7-unknown-linux-gnueabihf)
        [ -n "${CARGO_TARGET_ARMV7_UNKNOWN_LINUX_GNUEABIHF_LINKER:-}" ] || {
            echo "admin/mutants: run armv7 in 'nix develop .#armv7'" >&2
            exit 1
        }
        triple=ARMV7_UNKNOWN_LINUX_GNUEABIHF
        export CARGO_BUILD_TARGET=$target
        export CARGO_PROFILE_RELEASE_DEBUG_ASSERTIONS=true
        export CARGO_PROFILE_RELEASE_OVERFLOW_CHECKS=true
        profile=(--profile release)
        runner=(qemu-arm)
        # The portable backend's own modules, which armv7's assembly
        # replaces, and 64-bit Poly1305.
        skip=(
            'rind/src/low/x86_64/**' 'rind/src/low/aarch64/**'
            rind/src/low/generic/poly1305.rs rind/src/low/portable/chacha20.rs
            rind/src/low/portable/cpu.rs rind/src/low/portable/keccak.rs
            rind/src/low/portable/sha.rs
        )
        # `sh/armv7.sh`'s tiers: qemu's `max`, with NEON and the crypto
        # extension, a Cortex-A15, with NEON alone, and one with NEON denied.
        # RIND_TEST_ARM_* fails the run that detects the wrong features.
        base=(QEMU_CPU=max RIND_TEST_ARM_NEON=1 RIND_TEST_ARM_CRYPTO_EXT=1)
        rows=(
            "QEMU_CPU=cortex-a15 RIND_TEST_ARM_NEON=1 RIND_TEST_ARM_CRYPTO_EXT=0"
            "neon QEMU_CPU=cortex-a15 RIND_TEST_ARM_NEON=0 RIND_TEST_ARM_CRYPTO_EXT=0"
        )
        ;;
    *)
        echo "admin/mutants: no campaign for ${target:-$(uname -sm)}" >&2
        exit 1
        ;;
esac
[ -z "$avx512" ] || [ "$triple" = X86_64_UNKNOWN_LINUX_GNU ] || {
    echo "admin/mutants: --avx512 runs only on Linux x86_64" >&2
    exit 1
}

# `--portable` forces the portable backend on this x86_64 host. It is applied
# after the host case above, so it stays a flag rather than another arm of
# that case: the case has already picked this machine's campaign, and this
# replaces its feature rows. The backend reads no CPU features, so there is
# no denial row. It mutates only what no other campaign compiles:
#
# - the portable modules armv7's assembly replaces;
# - `mont_sqr` and `mont_mul_limbs`, whose names cargo-mutants gives as
#   `replace mont_sqr with ()` for the function and `... in mont_sqr` inside
#   it;
# - the AES fallback through the portable backend's path, whose 64-bit word
#   module only a 64-bit portable build compiles (armv7 compiles the 32-bit
#   one, and runs the rest of the file too);
# - `cpu::has_aes_hardware`, whose portable arm returns false.
#
# Its `--file` list already limits it to those files, so it needs no excludes
# beyond the generated sources below.
if [ -n "$portable_run" ]; then
    [ "$(uname -sm)" = "Linux x86_64" ] || {
        echo "admin/mutants: --portable runs on Linux x86_64" >&2
        exit 1
    }
    export CARGO_TARGET_X86_64_UNKNOWN_LINUX_GNU_RUSTFLAGS='--cfg rind_portable --cfg curve25519_dalek_backend="serial"'
    skip=()
    only=(
        --file rind/src/low/portable/chacha20.rs
        --file rind/src/low/portable/cpu.rs
        --file rind/src/low/portable/keccak.rs
        --file rind/src/low/portable/sha.rs
        --file rind/src/low/generic/bignum.rs
        --file rind/src/low/portable/../generic/aes_nohw.rs
        --file rind/src/low/cpu.rs
        --re '^rind/src/low/portable/(chacha20|cpu|keccak|sha)\.rs:|^rind/src/low/portable/\.\./generic/aes_nohw\.rs:|^rind/src/low/generic/bignum\.rs:.*(: replace | in )mont_(sqr|mul_limbs)( |$)|^rind/src/low/cpu\.rs:.*: replace has_aes_hardware '
    )
    rows=()
    base=()
    runner=()
    profile=()
fi

# The test runner: runs one test binary on each row, failing if any fails.
# Nextest lists a binary's tests through the runner too, which needs one run.
if [ "${1:-}" = --run ]; then
    shift
    if [ -n "$avx512" ]; then
        # The tests' CPU check fails unless the model takes each AVX-512 path.
        env RIND_TEST_X86_AVX512_AES_GCM=1 RIND_TEST_X86_AVX512_ML_KEM=1 \
            RIND_TEST_X86_AVX512_RSA=1 sde -spr -- "$@"
        # Each AVX-512 check must also refuse a CPU without any one feature it
        # names, which no SDE model lacks alone. Only this test can tell.
        case " $* " in
            *::checks_need_their_features" "*)
                for feature in avx512f avx512dq avx512ifma avx512bw avx512vl \
                    avx512vbmi avx512vbmi2 vaes vpclmulqdq bmi2; do
                    env "RIND_CPU_DISABLE_$feature=1" sde -spr -- "$@"
                done
                ;;
        esac
        exit 0
    fi
    env ${base[@]+"${base[@]}"} ${runner[@]+"${runner[@]}"} "$@"
    for arg in "$@"; do
        [ "$arg" != --list ] || exit 0
    done
    # A row names features to deny, and any variables to set.
    for row in "${rows[@]}"; do
        deny=()
        for word in $row; do
            case $word in
                *=*) deny+=("$word") ;;
                *) deny+=("RIND_CPU_DISABLE_$word=1") ;;
            esac
        done
        env "${deny[@]}" ${runner[@]+"${runner[@]}"} "$@"
    done
    exit 0
fi

cd "$here"
args=(${only[@]+"${only[@]}"})
for glob in ${skip[@]+"${skip[@]}"}; do
    args+=(--exclude "$glob")
done
while IFS= read -r file; do
    args+=(--exclude "$file")
done < <(git grep -l '^// generated source' -- rind/src)

# cargo-mutants' jobserver shares the CPUs between parallel jobs' builds, but
# not their tests: each job's nextest would run one test per CPU. Split the
# CPUs between the jobs' tests too.
jobs=${CARGO_MUTANTS_JOBS:-1}
prev=
for arg in "$@"; do
    [ "$arg" != -- ] || break
    case $prev in -j | --jobs) jobs=$arg ;; esac
    case $arg in -j?*) jobs=${arg#-j} ;; --jobs=*) jobs=${arg#--jobs=} ;; esac
    prev=$arg
done
export NEXTEST_TEST_THREADS=$((($(nproc) + jobs - 1) / jobs))

export "CARGO_TARGET_${triple}_RUNNER=$here/admin/mutants ${avx512:+--avx512 }${portable_run:+--portable }${target:+--target $target }--run"
# A mutant that hangs the tests until the timeout is caught by them, so only
# exit 3, timeouts alone, passes beside 0.
status=0
cargo mutants ${profile[@]+"${profile[@]}"} "${args[@]}" "$@" || status=$?
[ "$status" -ne 3 ] || status=0
exit "$status"

def vzeroupper(line):
    """`line`, after a `vzeroupper` if it returns."""
    if line.split()[:1] in (["ret"], ["retq"]):
        yield "\tvzeroupper"
    yield line


def preprocess(path, defines):
    # The headers only define what the defines already do, or macros for
    # other architectures.
    include = re.compile(r'#\s*include (<openssl/|"openssl/|"_internal_s2n_bignum_x86_att\.h")')
    with open(path) as f:
        text = "".join(line for line in f if not include.match(line))
    # As an assembler source, so qhasm's `#` comment lines pass through.
    cpp = ["cpp", "-x", "assembler-with-cpp", "-traditional-cpp", "-P", "-undef", "-nostdinc"]
    cpp += [*defines, "-"]
    out = subprocess.run(cpp, input=text, capture_output=True, text=True, check=True)
    return out.stdout.splitlines()


def find(lines, words, start=0):
    for i in range(start, len(lines)):
        if lines[i].split() == words:
            return i
    sys.exit(f"missing line: {' '.join(words)}")


def constant(lines, label, following):
    """`label`'s line and the `following` lines, after any `.align` before it."""
    for i, line in enumerate(lines):
        if line.startswith(label):
            if lines[i - 1].split()[:1] == [".align"]:
                i -= 1
                following += 1
            return lines[i : i + 1 + following]
    sys.exit(f"missing constant: {label}")


def routine(lines, name):
    """`name` from its `.globl` through its `.size`."""
    start = find(lines, [".globl", name])
    end = find(lines, [".size", f"{name},.-{name}"], start)
    return lines[start : end + 1]


def source_index(lines, piece):
    """Where `piece`, a run of `lines`, starts in them."""
    return next(i for i in range(len(lines)) if lines[i : i + len(piece)] == piece)


def spelling(lines, name, local):
    """How `lines` label `name`: as is, or with the `local` prefix."""
    for s in (name, local + name):
        if [s + ":"] in map(str.split, lines):
            return s
    sys.exit(f"missing label: {name}")


def alignment(lines, name):
    """The alignment aws-lc puts before `name`'s label, if any, which may
    precede its `.type` or, in Apple's flavor, the blank line in its place."""
    i = find(lines, [f"{name}:"]) - 1
    while lines[i].split()[:1] in ([], [".type"]):
        i -= 1
    return lines[i : i + 1] if lines[i].split()[:1] in ([".align"], [".p2align"]) else []


def body(lines, label, local, inner=()):
    """What follows `label` up to the next directive or label that ends a
    routine: Apple's flavor has no `.size`, so the next routine's label ends
    one there. Labels with the `local` prefix, or in `inner`, do not."""
    start = find(lines, [label]) + 1
    end = start
    while end < len(lines):
        words = lines[end].split()
        if words[:1] in ([".size"], [".section"], [".text"], [".globl"]):
            break
        if words and words[0].endswith(":") and not words[0].startswith(local) and words[0][:-1] not in inner:
            break
        end += 1
    # Some routines close their CFI frame after `.size`.
    after = [line.split()[:1] for line in lines[end : end + 2]]
    closing = lines[end + 1 : end + 2] if after == [[".size"], [".cfi_endproc"]] else []
    # What separates it from the next routine: blank lines, comments, and
    # the next routine's alignment.
    while lines[end - 1].split()[:1] in ([], [".align"]) or lines[end - 1].lstrip().startswith(("//", "#")):
        end -= 1
    return lines[start:end] + closing


def one_frame(frames):
    """The routines of `frames`, each a CFI frame, in one frame that
    restarts from the first's entry state where each later one opened.
    Apple's ld64 splits code at each frame and dead-strips one that only
    branches without a relocation reach, such as a joined routine's."""
    out = []
    for i, frame in enumerate(frames):
        last = i + 1 == len(frames)
        for line in frame:
            directive = line.split()[:1]
            if directive == [".cfi_startproc"]:
                out += [line if i == 0 else ".cfi_restore_state"] + ([] if last else [".cfi_remember_state"])
            elif directive != [".cfi_endproc"] or last:
                out.append(line)
    return out


def table(lines, label, local, packed=False):
    """The values from `label` up to the first line that is not one of the
    same width, their width in bytes, and the offset of each label within
    them, keyed without `local`. A label just before a change of width starts
    the next table, which a spec names separately, unless the table is
    `packed`: then it runs on to the first line that is not data, as bytes."""
    start = find(lines, [label]) + 1
    widths = {".quad": 8, ".long": 4, ".byte": 1}
    values, width, offsets = [], None, {}
    for line in lines[start:]:
        # Character constants, such as the ChaCha20 constant's.
        line = re.sub(r"'(.)'", lambda m: str(ord(m[1])), line)
        words = re.sub(r"(//|#).*", "", line).replace(",", " ").split()
        if not words:
            continue
        if len(words) == 1 and words[0].startswith(local) and words[0].endswith(":"):
            offsets[words[0][len(local) : -1]] = len(values) * width if width else 0
            continue
        if words[0] not in widths:
            break
        if packed:
            size = widths[words[0]]
            values += [f"0x{b:02x}" for v in words[1:] for b in int(v, 0).to_bytes(size, "little")]
            width = 1
            continue
        if width not in (None, widths[words[0]]):
            break
        width = widths[words[0]]
        values += words[1:]
    if not values:
        sys.exit(f"empty table: {label}")
    end = len(values) * width
    return values, width, {sub: offset for sub, offset in offsets.items() if offset < end}


def words(names):
    """Matches any of `names` as a whole symbol."""
    return re.compile(r"(?<![\w.$])(" + "|".join(map(re.escape, names)) + r")(?![\w$])")


def escape(lines, operands, local, tag, comment):
    """Doubles braces, writes each key of `operands`, an `(operand, offset)`,
    as `{operand}` plus any offset after its page modifier outside `comment`s,
    and tags each label `lines` defines with the `local` prefix."""
    lines = list(lines)
    defined = re.compile(re.escape(local) + r"[\w$]+(?=:)")
    labels = [m[0] for m in map(defined.match, lines) if m]
    operands_re = re.compile(words(operands).pattern + r"(@PAGE(?:OFF)?)?") if operands else None

    def operand(m):
        name, offset = operands[m[1]]
        return "{" + name + "}" + (m[2] or "") + (f"+{offset}" if offset else "")

    labels_re = words(labels) if labels else None
    for line in lines:
        code, leader, text = line.replace("{", "{{").replace("}", "}}").partition(comment)
        if operands_re:
            code = operands_re.sub(operand, code)
        line = code + leader + text
        if labels_re:
            line = labels_re.sub(lambda m: local + tag + "_" + m[1][len(local) :], line)
        yield line


def header(comment, spec, source):
    notice = spec.get("notice", [spec.get("copyright"), "SPDX-License-Identifier: Apache-2.0"])
    origin = f"{comment} {source}"
    if "perlasm" in spec:
        origin += f", which aws-lc generates from {spec['perlasm']}"
    return [f"{comment} {line}" for line in notice] + [
        f"{comment}",
        f"{comment} Generated by admin/import-aws-lc from aws-lc {REV}:",
        origin + ".",
        f"{comment} Do not edit by hand.",
    ]


def write(path, lines):
    # Renamed into place, so a failure partway leaves the committed file whole.
    tmp = path + ".tmp"
    with open(tmp, "w") as f:
        f.write("\n".join(lines) + "\n")
    os.replace(tmp, path)


def import_arm(aws_lc):
    out_dir = os.path.join(ROOT, "arm", "aws_lc")
    for spec in ARM_IMPORTS:
        directory = spec.get("dir", "generated-src/linux-arm/crypto/fipsmodule")
        source = os.path.join(directory, spec["source"])
        lines = preprocess(os.path.join(aws_lc, source), ARM_CPP)

        if spec.get("whole"):
            text = "\n".join(lines).strip("\n").split("\n")
        else:
            # In aws-lc's order, which keeps each routine's `adr` and literal
            # `ldr` within reach of the constants it loads.
            pieces = [constant(lines, label, following) for label, following in spec["constants"]]
            pieces += [routine(lines, name) for name in spec["routines"]]
            text = [line for piece in sorted(pieces, key=lambda p: source_index(lines, p)) for line in piece]

        out = os.path.join(out_dir, spec["source"].removesuffix(".S") + ".s")
        operands = {name: (name, 0) for name in spec["routines"]}
        local = spec.get("local", ".L")
        write(out, header("@", spec, source) + list(escape(text, operands, local, spec["tag"], "@")))


def import_64(aws_lc):
    for spec in IMPORTS_64:
        arch = ARCHES[spec["arch"]]
        out_dir = os.path.join(ROOT, spec["arch"], "aws_lc")
        stem = spec["source"].removesuffix(".S")
        for flavor, (directory, defines, prefix, local) in arch["flavors"].items():
            if "path" in spec:
                source = os.path.join(spec["path"], spec["source"])
            else:
                source = os.path.join("generated-src", directory, "crypto", spec.get("dir", "fipsmodule"), spec["source"])
            lines = preprocess(os.path.join(aws_lc, source), arch["cpp"] + defines + spec.get("cpp", []))

            # A flavor names a table with or without its local prefix, and a
            # label inside it by the table's operand plus its offset.
            operands = {}
            for name in spec["tables"]:
                label = spelling(lines, name, local)
                values, width, offsets = table(lines, label + ":", local, name in spec.get("packed", []))
                operand = name.lstrip("_")
                operands |= {s: (operand, 0) for s in (name, local + name)}
                operands |= {local + sub: (operand, offset) for sub, offset in offsets.items()}
                if flavor == "linux":
                    per_row = 16 // width
                    rows = [f"    {', '.join(values[i : i + per_row])}," for i in range(0, len(values), per_row)]
                    if "tables_of" in spec:
                        with open(os.path.join(out_dir, f"{spec['tables_of']}.{operand}.rs")) as f:
                            if f.read().splitlines()[-len(rows) - 2 :] != ["["] + rows + ["]"]:
                                sys.exit(f"{stem}: {operand} differs from {spec['tables_of']}'s")
                        continue
                    rs = os.path.join(out_dir, f"{stem}.{operand}.rs")
                    write(rs, header("//", spec, source) + ["["] + rows + ["]"])

            # And a helper with or without it.
            helpers = spec.get("helpers", [])
            operands |= {s: (name.lstrip("_"), 0) for name in helpers for s in (name, local + name)}
            # Routines of another import that these call.
            operands |= {prefix + name: (name, 0) for name in spec.get("calls", [])}
            # Entries that share a routine's own, by the routine.
            operands |= {
                spelling(lines, alias, prefix): (name, 0) for alias, name in spec.get("aliases", {}).items()
            }
            # A routine's label, which is unprefixed when it is not global.
            defined = [line.split() for line in lines]

            def label_of(name):
                return next(s for s in (prefix + name, name) if [s + ":"] in defined) + ":"

            entries = [(label_of(name), name) for name in spec["routines"]]
            entries += [(spelling(lines, name, local) + ":", name.lstrip("_")) for name in helpers]
            inner = spec.get("inner", [])
            labels = spec.get("labels", [])
            # A routine falls through these labels, which name helpers with
            # their own copy.
            dropped = [[f"{name}:"] for name in inner]
            joined = []
            joins = spec.get("joins", [])
            for other in joins:
                text = body(lines, f"{other}:", local)
                end = [line.split()[:1] for line in text].index([".cfi_endproc"])
                joined.append(alignment(lines, other) + [f"{local}{other}:"] + text[: end + 1])
            for label, name in entries:
                text = [line for line in body(lines, label, local, inner + labels) if line.split() not in dropped]
                # rustc aligns a naked function to only 4 bytes, but on ELF
                # and COFF gives each its own section, so aws-lc's alignment
                # at the body's start raises the section's and pads nothing.
                # Mach-O shares one section, where it would pad after the
                # label, in the path of every call.
                if flavor == "linux":
                    text = alignment(lines, label[:-1]) + text
                carried = spec.get("carries", {}).get(name, [])
                for other in carried:
                    text += alignment(lines, other) + [f"{local}{other}:"] + body(lines, f"{other}:", local)
                if name in spec["routines"] and joined:
                    text = one_frame([text] + joined)
                if labels or carried or joins:
                    local_re = words(labels + carried + joins)
                    text = [local_re.sub(lambda m: local + m[1], line) for line in text]
                directives = [line.split()[:1] for line in text]
                if label[:-1] in inner and [".cfi_endproc"] in directives and [".cfi_startproc"] not in directives:
                    text = [".cfi_startproc"] + text
                # Its CPU check, through the jump to its twin.
                if name in spec.get("dispatches", []):
                    at = [i for i, old in enumerate(text) if "OPENSSL_ia32cap_P" in old]
                    if len(at) != 1:
                        sys.exit(f"{name}: expected one CPU check")
                    end = next(i for i in range(at[0], len(text)) if text[i].split()[0].startswith("j"))
                    del text[at[0] : end + 1]
                # Before the first instruction that names this symbol, which
                # has no prefix if it is not global.
                for op, symbol, line in spec.get("inserts", {}).get(name, []):
                    at = [i for i, old in enumerate(text) if old.split() in ([op, prefix + symbol], [op, symbol])]
                    if not at:
                        sys.exit(f"{name}: expected {op} {symbol}")
                    text.insert(at[0], "\t" + line)
                # The one instruction with these operands, which name a symbol.
                for op, args, line in spec.get("replaces", {}).get(name, []):
                    at = [i for i, old in enumerate(text) if old.split() == [op, prefix + args]]
                    if len(at) != 1:
                        sys.exit(f"{name}: expected one {op} {args}")
                    text[at[0]] = "\t" + line
                if spec.get("vzeroupper"):
                    text = [new for line in text for new in vzeroupper(line)]
                # ld64 would split off and could drop the second (see `one_frame`).
                if flavor == "apple" and sum(line.split()[:1] == [".cfi_startproc"] for line in text) > 1:
                    sys.exit(f"{name}: more than one CFI frame for Mach-O")
                text = escape(text, operands, local, spec["tag"], arch["comment"])
                write(os.path.join(out_dir, f"{name}.{flavor}.s"), header(arch["comment"], spec, source) + list(text))


def main():
    if len(sys.argv) != 2:
        sys.exit(__doc__)
    aws_lc = sys.argv[1]
    rev = subprocess.run(
        ["git", "-C", aws_lc, "rev-parse", "HEAD"], capture_output=True, text=True, check=True
    ).stdout.strip()
    if rev != REV:
        sys.exit(f"aws-lc is at {rev}, expected {REV}")

    import_arm(aws_lc)
    import_64(aws_lc)


if __name__ == "__main__":
    main()

import RindIsa.AArch64

/-!
# ChaCha20-Poly1305 seal and open for NEON

rind's naked functions `low::aarch64::chacha20poly1305::chacha20_poly1305_seal`
and `chacha20_poly1305_open`, its structured copy of aws-lc's
`chacha20_poly1305_seal` and `chacha20_poly1305_open`
(`crypto/cipher_extra/asm/chacha20_poly1305_armv8.pl`), in rind's model of
AArch64: `(out = x0, in = x1, len = x2, aad = x3, aad_len = x4, data = x5)`,
`data` the key, the counter, and the nonce, where the routine leaves the
tag. Each interleaves NEON ChaCha20 (four blocks in vertical lanes and a
fifth in one register's) with scalar Poly1305, whose accumulator stays in
`x8`–`x10` and whose `r` stays in `x16` and `x17`. The copy keeps aws-lc's
instructions but lays its control flow out as `Code`'s `ite` and `loop`
and inlines `poly_hash_ad_internal`, so each program is one structured
term; ALGORITHMS.md lists it as a deliberate change.

`admin/prove lean` checks that `function sealProg` and `function openProg`
are the functions' bytes and relocations as rind's build emits them, and
that the static `CHACHA20_CONSTS` begins with `consts`' words.
-/

namespace Rind.AArch64.ChaCha20Poly1305

open VG VG.AArch64

/-- The name of the static of constants. -/
def constsName : String := "chacha20_consts"

/-- The words the static begins with: RFC 8439's ChaCha20 constant, the
counter increments 1 to 4, the TBL indices rotating each 32-bit lane left
by 8, and RFC 8439's Poly1305 clamp of `r`. -/
def consts : List (BitVec 32) :=
  [0x61707865, 0x3320646e, 0x79622d32, 0x6b206574, 0x00000001, 0x00000002, 0x00000003, 0x00000004,
   0x02010003, 0x06050407, 0x0a09080b, 0x0e0d0c0f, 0x0fffffff, 0x0ffffffc, 0x0ffffffc, 0x0ffffffc]

def vop (o : VOp) : Instr := .vg (.vop o)

/-- The programs in order. -/
def seqs : List (Prog isa) → Prog isa
  | [] => .block []
  | [a] => a
  | a :: r => .seq a (seqs r)


import RindIsa.X86_64.PolyHashAd

/-!
# ChaCha20-Poly1305's AVX2 seal

rind's naked function `low::x86_64::chacha20poly1305::seal_avx2`, its
structured copy of the AVX2 half of aws-lc's `chacha20_poly1305_seal`
(`crypto/cipher_extra/asm/chacha20_poly1305_x86_64.pl`), in rind's model of
x86_64: `(out = rdi, in = rsi, len = rdx, aad = rcx, aad_len = r8, data =
r9)`, `data` the key, the counter, and the nonce. It interleaves AVX2
ChaCha20, two blocks to a `ymm` register, with scalar Poly1305 on `mulx`,
whose accumulator stays in `r10`–`r12` and whose clamped `r` stays on the
stack frame at `rbp`, and returns the tag in `rax` (its first eight bytes)
and `rdx`.

The copy keeps aws-lc's instructions but lays its control flow out as
`Code`'s `ite` and `loop`, so the program is one structured term. Where
aws-lc's text jumps into the middle of a loop or shares a tail between
paths, the copy re-tests a flag (`testq`, `cmpq`) or clears a count (`xorl
%ecx,%ecx`) so that each path takes the same instructions in the same
order; it inlines `poly_hash_ad_internal` (`PolyHashAd.prog`); it drops
`extra_in`, which rind never passes; it returns the tag in registers rather
than through `data`, so it no longer saves `r9`; and its last partial block
copies `xmm15` with `movdqa` rather than `movdqu`, the same move. ALGORITHMS.md
lists it as a deliberate change.

`admin/prove lean` checks that `function sealAvx2 repRet` is the function's
bytes and relocations as rind's build emits them, and that the static
`CONSTS` begins with `consts`' words.
-/

namespace Rind.X86_64.ChaCha20Poly1305

open VG VG.X86_64

/-- The name of the static of constants. -/
def constsName : String := "chacha20_consts"

/-- The static's words, little-endian: aws-lc's `chacha20_consts` (RFC
8439's ChaCha20 constant twice, the `pshufb` masks rotating each 32-bit lane
left by 8 and 16, the counter increments, and RFC 8439's Poly1305 clamp of
`r`), then its `and_masks`, which keep the first 1 to 16 bytes of a block. -/
def consts : List (BitVec 64) :=
  [0x3320646e61707865, 0x6b20657479622d32, 0x3320646e61707865, 0x6b20657479622d32,
   0x0605040702010003, 0x0e0d0c0f0a09080b, 0x0605040702010003, 0x0e0d0c0f0a09080b,
   0x0504070601000302, 0x0d0c0f0e09080b0a, 0x0504070601000302, 0x0d0c0f0e09080b0a,
   0x0000000000000000, 0x0000000000000000, 0x0000000000000001, 0x0000000000000000,
   0x0000000000000002, 0x0000000000000000, 0x0000000000000002, 0x0000000000000000,
   0x0ffffffc0fffffff, 0x0ffffffc0ffffffc, 0xffffffffffffffff, 0xffffffffffffffff,
   0x00000000000000ff, 0x0000000000000000, 0x000000000000ffff, 0x0000000000000000,
   0x0000000000ffffff, 0x0000000000000000, 0x00000000ffffffff, 0x0000000000000000,
   0x000000ffffffffff, 0x0000000000000000, 0x0000ffffffffffff, 0x0000000000000000,
   0x00ffffffffffffff, 0x0000000000000000, 0xffffffffffffffff, 0x0000000000000000,
   0xffffffffffffffff, 0x00000000000000ff, 0xffffffffffffffff, 0x000000000000ffff,
   0xffffffffffffffff, 0x0000000000ffffff, 0xffffffffffffffff, 0x00000000ffffffff,
   0xffffffffffffffff, 0x000000ffffffffff, 0xffffffffffffffff, 0x0000ffffffffffff,
   0xffffffffffffffff, 0x00ffffffffffffff, 0xffffffffffffffff, 0xffffffffffffffff]

/-- `[b + d]` -/
def m (b : Reg) (d : Int) : MemOp := { base := b, disp := d }

/-- `[b + i + d]` -/
def mi (b i : Reg) (d : Int) : MemOp := { base := b, index := some i, disp := d }

/-- `d` bytes past the static of constants, RIP-relative. -/
def k (d : Int) : SymOp := { name := constsName, disp := d }

/-- An SSE instruction. -/
def x (o : XOp) : Instr := .vg (.xop o)

/-- An AVX instruction. -/
def v (o : VOp) : Instr := .vg (.vop o)

/-- The programs in order. -/
def seqs : List (Prog isa) → Prog isa
  | [] => .block []
  | [a] => a
  | a :: r => .seq a (seqs r)

namespace SealAvx2

/-- rind's prologue: aws-lc's entry, but for saving `r9`, adding `extra_in`'s length, and testing `ia32cap`. -/
def prologue : List Instr :=
  [.push .rbp,
   .push .rbx,
   .push .r12,
   .push .r13,
   .push .r14,
   .push .r15,
   .aluRsp .sub 320,
   .lea .rbp (m .rsp 32),
   .vg (.alu .and .rbp (.imm (-32))),
   .vg (.mov .rbx (.reg .rdx)),
   .vg (.store (m .rbp 32) .r8),
   .vg (.store (m .rbp 40) .rbx)]

/-- aws-lc's `chacha20_poly1305_seal_avx2`. -/
def begin : List Instr :=
  [v .vzeroupper,
   .vmovdqaLoad .l256 .xmm0 (.sym (k 0)),
   .vg (.vbroadcasti128 .xmm4 (m .r9 0)),
   .vg (.vbroadcasti128 .xmm8 (m .r9 16)),
   .vg (.vbroadcasti128 .xmm12 (m .r9 32)),
   .vbinSym .vpaddd .l256 .xmm12 .xmm12 (k 96)]


def cmpq320Rbx : List Instr :=
  [.vg (.alu .cmp .rbx (.imm 320))]


def cmpq192Rbx : List Instr :=
  [.vg (.alu .cmp .rbx (.imm 192))]


---
// The shell every page shares: light and dark from the reader's setting, no
// request to a third party (the Content-Security-Policy in astro.config.ts
// refuses one), a link to the page's Markdown twin, and the card a pasted link
// shows.
import { card } from "../lib/card";
import { favicon } from "../lib/favicon";
import { builtBy } from "../lib/landing";
import { type Page, origin, twinPath } from "../lib/pages";

interface Props {
	page: Page;
	// The document title, when it should say more than the page's own.
	title?: string;
}
const { page, title = page.title } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="color-scheme" content="light dark" />
		<title>{title}</title>
		<meta name="description" content={page.answers} />
		<link rel="canonical" href={`${origin}${page.path}`} />
		<link rel="alternate" type="text/markdown" href={twinPath(page)} />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="rind" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={page.answers} />
		<meta property="og:url" content={`${origin}${page.path}`} />
		<meta property="og:image" content={`${origin}${card.path}`} />
		<meta property="og:image:width" content={String(card.width)} />
		<meta property="og:image:height" content={String(card.height)} />
		<meta property="og:image:alt" content="The rind wordmark and Kixel AI mark on graphite" />
		<meta name="twitter:card" content="summary_large_image" />
		<link rel="icon" href={favicon} type="image/svg+xml" />
	</head>
	<body>
		<header class="site-brand">
			<div class="site-brand-inner">
				<a href="/" class="site-brand-home">
					<img src={favicon} width="29" height="29" alt="" />
					<span>rind</span>
				</a>
				<a href={builtBy.href}>
					<img src="/kixel-mark.png" width="22" height="22" alt="" />
					<span>{builtBy.label}</span>
				</a>
			</div>
		</header>
		<slot />
	</body>
</html>

<style is:global>
	:root {
		--bg: #f5f6f8;
		--fg: #161c24;
		--muted: #425064;
		--border: #9fafc1;
		--surface: #fcfdfe;
		--accent: #4d6500;
		--readout: #704400;
		font-family:
			system-ui,
			-apple-system,
			"Segoe UI",
			Roboto,
			sans-serif;
		line-height: 1.6;
		color: var(--fg);
		background: var(--bg);
	}
	@media (prefers-color-scheme: dark) {
		:root {
			--bg: #07090d;
			--fg: #e7ecf2;
			--muted: #b5c0ce;
			--border: #2a3340;
			--surface: #121820;
			--accent: #a1c702;
			--readout: #ffb020;
		}
	}
	body {
		margin: 0;
	}
	a {
		color: var(--accent);
	}
	.site-brand {
		background: var(--surface);
		border-bottom: 1px solid var(--border);
	}
	.site-brand-inner {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 0.75rem;
		max-width: 60rem;
		margin: 0 auto;
		padding: 0 1.25rem;
	}
	.site-brand-inner a {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		min-height: 2.75rem;
		color: var(--fg);
		font-size: 0.875rem;
		font-weight: 600;
		text-decoration: none;
	}
	.site-brand-inner a:hover {
		text-decoration: underline;
	}
	.site-brand-inner a:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 2px;
	}
	.site-brand-home span {
		font-size: 1.1rem;
	}
	code,
	pre {
		font-family: ui-monospace, "SF Mono", Menlo, Consolas, monospace;
		font-size: 0.9em;
	}
	:not(pre) > code {
		background: var(--surface);
		padding: 0.1em 0.3em;
		border-radius: 0.25rem;
	}
</style>
